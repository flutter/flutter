# The SDK's version pins; the Bazel build reads the Material fonts', the
# Gradle wrapper's and the iOS USB dependencies' to fetch what the framework's
# and the tool's tests read of the SDK cache
# (build_defs/repositories/flutter_sdk_cache.bzl).

load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@engine_version//:version.bzl", "CONTENT_HASH", "ENGINE_REALM", "ENGINE_VERSION", "PREBUILT_ENGINE_VERSION")
load("//build_defs/repositories:flutter_sdk_cache.bzl", "IOS_USB_ARTIFACTS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "gradle_wrapper.version",
    "material_fonts.version",
    # flutter_tools' script_test reads it (see //bin:BUILD.bazel).
    "shared.bat",
] + [artifact + ".version" for artifact in IOS_USB_ARTIFACTS])

# The scripts and version pins, whole: dev/tools' tests copy the
# engine-version scripts into a temporary checkout and run them with a mock
# git.
filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# The engine revision the tool's bootstrap writes to bin/cache/engine.stamp
# (update_engine_version.sh: the checkout's `git rev-parse HEAD`), with its
# details beside it (bin/cache/engine_stamp.json, which the tool otherwise
# downloads for the revision the stamp names, and the bookkeeping stamp that
# says the download is current) and the framework's version as the tool
# writes it to bin/cache/flutter.version.json (from git): pub reads
# `flutterVersion` from it to resolve `sdk: flutter` dependencies and checks
# it against the packages' `flutter:` constraints (leak_tracker_flutter_testing
# wants >=3.18), the tool reads the rest for `flutter --version` and parses
# frameworkVersion as a git tag (GitTagVersion.parse: `<x>.<y>.<z>-<n>.<m>.pre`).
#
# Two sets. Under Bazel the engine is the tree itself; a facsimile without
# engine artifacts -- the tool's unit tests', which read that the stamp
# exists (Cache.engineRevision), not what it says -- takes fixed words, as
# the SDK version's defines are in the tests' compiles (flutter_test.bzl),
# so that a commit elsewhere re-runs nothing there. A facsimile with the
# engine's directories takes the revision the build stamps into them
# (@engine_version: the frameworks' Info.plist carry it as FlutterEngine,
# and the content validation tests compare the two with the cache's) --
# those directories change with the revision anyway (their archives'
# readmes name it). The framework version is one every constraint allows:
# the checkout is newer than any package that constrains it.
[
    [
        write_file(
            name = prefix + "engine_stamp",
            out = prefix + "engine.stamp",
            content = [revision],
        ),
        write_file(
            name = prefix + "engine_stamp_stamp",
            out = prefix + "engine_stamp.stamp",
            content = [revision],
        ),
        write_file(
            name = prefix + "engine_stamp_json",
            out = prefix + "engine_stamp.json",
            content = [json.encode({
                "build_date": "1970-01-01T00:00:00.000000",
                "build_time_ms": 0,
                "git_revision": revision,
                "git_revision_date": "1970-01-01T00:00:00Z",
                "content_hash": content_hash,
            })],
        ),
        write_file(
            name = prefix + "flutter_version_json",
            out = prefix + "flutter.version.json",
            content = [json.encode({
                "frameworkVersion": "999.0.0-0.0.pre",
                "channel": "bazel",
                "repositoryUrl": "https://github.com/flutter/flutter.git",
                "frameworkRevision": "bazel",
                "frameworkCommitDate": "1970-01-01 00:00:00 +0000",
                "engineRevision": revision,
                "engineCommitDate": "1970-01-01 00:00:00.000Z",
                "engineContentHash": content_hash,
                "engineBuildDate": "1970-01-01 00:00:00.000",
                "dartSdkVersion": "bazel",
                "devToolsVersion": "bazel",
                "flutterVersion": "999.0.0-0.0.pre",
            })],
        ),
    ]
    for prefix, revision, content_hash in [
        ("", "bazel", "bazel"),
        ("versioned_", ENGINE_VERSION, CONTENT_HASH),
    ]
]

# The engine's storage realm beside the stamp (bin/cache/engine.realm, which
# the bootstrap writes from Cocoon's FLUTTER_REALM on a bot: a presubmit's
# engine artifacts live under flutter_archives_v2, not in the release
# bucket): the checkout's, through @engine_version, so that a test's tool
# downloading an artifact at run time (the integration shard's `flutter
# build ios`) looks where the checkout's tool looks; empty, the default,
# elsewhere. The Gradle plugin reads the file whether or not it needs a
# realm.
write_file(
    name = "engine_realm",
    out = "engine.realm",
    content = [ENGINE_REALM],
)

# The cache's bookkeeping for the artifacts the tests' SDK facsimile lays
# from the build instead of a download (packages/flutter_tools/BUILD.bazel):
# the tool's Cache.updateAll downloads whatever its stamp does not vouch
# for. An engine artifact's stamp is the engine revision (the versioned
# set's: these go with the engine's directories), the fonts' and the Gradle
# wrapper's the archive path their pin names.
write_file(
    name = "flutter_sdk_stamp",
    out = "flutter_sdk.stamp",
    content = [ENGINE_VERSION],
)

write_file(
    name = "font_subset_stamp",
    out = "font-subset.stamp",
    content = [ENGINE_VERSION],
)

write_file(
    name = "linux_sdk_stamp",
    out = "linux-sdk.stamp",
    content = [ENGINE_VERSION],
)

# A Mac host's counterpart (MacOSEngineArtifacts: the stamp is named
# macos-sdk), for the facsimile on a Mac.
write_file(
    name = "macos_sdk_stamp",
    out = "macos-sdk.stamp",
    content = [ENGINE_VERSION],
)

# The iOS engine artifacts' (IOSEngineArtifacts: the stamp is named
# ios-sdk), for the apple shard's facsimile on a Mac.
write_file(
    name = "ios_sdk_stamp",
    out = "ios-sdk.stamp",
    content = [ENGINE_VERSION],
)

# The Android gen_snapshot artifacts' (AndroidGenSnapshotArtifacts: the
# stamp is named android-sdk), for the tests that run `flutter build apk`.
write_file(
    name = "android_sdk_stamp",
    out = "android-sdk.stamp",
    content = [ENGINE_VERSION],
)

# The same under --config=prebuilt_engine, where the facsimile's engine.stamp
# is bin/cache's own (the engine the tool downloaded; @flutter_bin_cache's
# stamps) while the Android gen_snapshots still come from the tree: their
# stamp says bin/cache's revision, so that the tool takes them as current
# rather than downloading the set.
write_file(
    name = "prebuilt_android_sdk_stamp",
    out = "prebuilt_android-sdk.stamp",
    content = [PREBUILT_ENGINE_VERSION],
)

write_file(
    name = "flutter_web_sdk_stamp",
    out = "flutter_web_sdk.stamp",
    content = [ENGINE_VERSION],
)

copy_file(
    name = "material_fonts_stamp",
    src = "material_fonts.version",
    out = "material_fonts.stamp",
)

copy_file(
    name = "gradle_wrapper_stamp",
    src = "gradle_wrapper.version",
    out = "gradle_wrapper.stamp",
)

# The iOS USB dependencies' (IosUsbArtifacts; universal, so the tool checks
# them on every host, and downloads them on a Mac -- where the facsimile lays
# them): the version file again, one stamp each (ios-deploy's is
# ios-deploy.stamp, from :ios_deploy_stamp).
[
    copy_file(
        name = artifact.replace("-", "_") + "_stamp",
        src = artifact + ".version",
        out = artifact + ".stamp",
    )
    for artifact in IOS_USB_ARTIFACTS
]
