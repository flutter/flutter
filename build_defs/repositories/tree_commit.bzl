"""tree_commit_repository: when a DEPS tree's commit was made, as git says it.

Dart's GN build asks git about the SDK's tree while it builds
(tools/make_version.py): the VM's version string carries the time of the
tree's commit. A Bazel action has no repository to ask: the wrapped build's
tree is the action's inputs. So this asks instead, once, at fetch time, of
the tree a build reads -- the checkout's directory, or the fetched tree where
the checkout has none; both keep their `.git` -- and writes the answer down
twice: `commit.bzl`'s COMMIT_TIME, for the BUILD file of the tree's own
repository to fill into a template, and the file `commit_time`, for a test
to read. It is `git log -n 1 --pretty=format:%cd` in git's default date
format, whatever the user's configuration says; where git has no answer (a
tree without its `.git`, a machine without git) it is `Unknown timestamp`,
make_version.py's own words then.

Only what reads the tree anyway should name this repository: to ask is to
fetch the tree, in a checkout that has none.

In a file of its own, so that an edit here refetches this repository alone.
"""

load(":repositories.bzl", "checkout_root", "fetched_tree_directory", "in_checkout")

_COMMIT_BZL = """\
# Generated by tree_commit_repository (build_defs/repositories/tree_commit.bzl); do not edit.

\"\"\"When the commit of {path} was made, as git says it.\"\"\"

COMMIT_TIME = {commit_time}
"""

_COMMIT_BUILD = """\
# Generated by tree_commit_repository (build_defs/repositories/tree_commit.bzl); do not edit.

package(default_visibility = ["//visibility:public"])

exports_files([
    "commit.bzl",
    "commit_time",
])
"""

# tools/make_version.py's commit time where git gave none.
_UNKNOWN_TIME = "Unknown timestamp"

def _watch_head(rctx, git):
    """Re-runs the rule when the tree's HEAD moves (`gclient sync`, a checkout by hand).

    With git's files backend: HEAD, the ref it names, packed-refs. With
    reftable -- what a recent git creates a repository with, and so what
    gclient leaves a tree with -- HEAD is a stub and the refs are in tables:
    the tables' list, which every update of a ref rewrites.

    Args:
      rctx: the repository context.
      git: the git command with the tree's --git-dir.
    """
    directories = rctx.execute(git + ["rev-parse", "--absolute-git-dir", "--path-format=absolute", "--git-common-dir"])
    lines = directories.stdout.strip().splitlines()
    if directories.return_code != 0 or len(lines) != 2:
        return
    git_dir, common_dir = [rctx.path(line) for line in lines]
    if common_dir.get_child("reftable").exists:
        for directory in (git_dir, common_dir):
            rctx.watch(directory.get_child("reftable", "tables.list"))
        return
    head = git_dir.get_child("HEAD")
    rctx.watch(head)
    content = rctx.read(head).strip()
    if content.startswith("ref: "):
        rctx.watch(rctx.path(str(common_dir) + "/" + content[len("ref: "):]))
    rctx.watch(common_dir.get_child("packed-refs"))

def _tree_commit_repository_impl(rctx):
    path = rctx.attr.path
    checkout = checkout_root(rctx)
    rctx.watch(checkout.get_child(path))
    if in_checkout(rctx, path):
        tree = checkout.get_child(path)
    else:
        tree = fetched_tree_directory(rctx, rctx.attr.fetched)

    # The tree's own repository, named outright: the tree sits inside the
    # checkout's work tree, and git left to find a repository would answer
    # for the checkout where the tree had none of its own.
    git = ["git", "--git-dir=" + str(tree.get_child(".git"))]
    time = rctx.execute(git + ["log", "-n", "1", "--date=default", "--pretty=format:%cd"])
    commit_time = time.stdout.strip() if time.return_code == 0 else ""
    if commit_time:
        _watch_head(rctx, git)
    else:
        commit_time = _UNKNOWN_TIME

    rctx.file("BUILD.bazel", _COMMIT_BUILD)
    rctx.file("commit.bzl", _COMMIT_BZL.format(path = path, commit_time = repr(commit_time)))
    rctx.file("commit_time", commit_time + "\n")
    rctx.file("REPO.bazel", "")

tree_commit_repository = repository_rule(
    implementation = _tree_commit_repository_impl,
    doc = "When the commit of a tree of DEPS was made, as git says it: `commit.bzl`'s COMMIT_TIME and the file `commit_time`.",
    attrs = {
        "path": attr.string(mandatory = True, doc = "The tree's directory, relative to the checkout's root."),
        "fetched": attr.label(mandatory = True, doc = "The BUILD file of the tree's fetched_tree, read where the checkout lacks the directory."),
    },
    # Read from the checkout; re-created at every server start rather than
    # restored from a cache.
    local = True,
)
