"""CMake, as a Bazel repository: what `flutter build linux` runs, from the build.

flutter_tools builds a Linux desktop app by running `cmake -G Ninja` and
`ninja` over the project's CMake files (lib/src/linux/build_linux.dart),
with `clang` and `clang++` as the compilers and `pkg-config` for GTK; the
tool's integration tests of that path (build_linux_config_only_test, the
native-asset and data-asset tests) therefore want a CMake wherever they run.
Kitware's binary release is one static executable with its modules beside
it (`bin/cmake`, `share/cmake-<major.minor>`), linked to nothing but the C
library, so the repository is that archive, pinned by sha256:
`@cmake_linux_x64`. ninja and pkg-config are Debian's, from the runtime
sysroot (debian_runtime.bzl); the compilers the engine's own clang; the
headers and link-time libraries the engine's build sysroot
(//build_defs/desktop:build_tools.bzl puts them together).
"""

_VERSION = "3.31.8"
_SHA256 = "630615d8e98ac33eba7fbe472626dff5c899c85af3c024585ae109166a6909d0"
_URL = "https://github.com/Kitware/CMake/releases/download/v%s/cmake-%s-linux-x86_64.tar.gz"

_BUILD = '''# GENERATED by cmake.bzl: Kitware's CMake {version} for Linux x86_64.

package(default_visibility = ["//visibility:public"])

exports_files(["bin/cmake"])

# The executable and its modules (share/cmake-<major.minor>, found beside
# bin/ by the executable itself), each share/ entry as one directory.
filegroup(
    name = "all_files",
    srcs = ["bin/cmake"] + glob(
        ["share/*"],
        exclude_directories = 0,
    ),
)
'''

def _cmake_repository_impl(rctx):
    rctx.download_and_extract(
        url = _URL % (_VERSION, _VERSION),
        sha256 = _SHA256,
        stripPrefix = "cmake-%s-linux-x86_64" % _VERSION,
    )
    rctx.file("BUILD.bazel", _BUILD.format(version = _VERSION))
    rctx.file("REPO.bazel", "")

cmake_repository = repository_rule(
    implementation = _cmake_repository_impl,
    doc = "Kitware's CMake binary release for Linux x86_64, pinned.",
)

def _cmake_impl(_mctx):
    cmake_repository(name = "cmake_linux_x64")

cmake = module_extension(
    implementation = _cmake_impl,
    doc = "CMake for the Linux desktop builds the tool's tests run: @cmake_linux_x64.",
)
