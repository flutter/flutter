"""A runtime sysroot: Debian packages unpacked for a program to load its libraries from.

The engine's build sysroot (@sysroot_linux_x64, Chromium's Debian bullseye
tarball; extensions.bzl) is for linking -- its shared objects are stubs,
the code stripped out -- so the tests that drive a browser cannot point
LD_LIBRARY_PATH at it. debian_runtime_sysroot fetches the packages a
browser loads at run time, pinned by sha256 in debian_runtime.lock.bzl
(written by debian_runtime_lock.py from the build sysroot's own package
metadata, at the build sysroot's versions), and unpacks each one's
data.tar into one tree: `usr/lib/<multiarch>` and `lib/<multiarch>` hold
the libraries whole, `usr/share/fonts` the fonts (DejaVu and Liberation,
so that a rendering depends on no font of the host) with fontconfig's own
rules under `etc/fonts/conf.d`. The C library and the compiler
runtime are not among them (a program keeps the host's, whose dynamic
loader must match its libc), so the tree's `lib/<multiarch>` is the few
libraries Debian keeps beside libc (libpcre, libexpat, libz, libdbus-1,
libselinux, ...).

A .deb is an `ar` archive of control.tar and data.tar; the archive member
is taken out with the engine's own llvm-ar (buildtools/linux-x64/clang) and
the tar unpacked by Bazel. The repository is `@sysroot_linux_x64_runtime`,
the build sysroot's name with the use said.

Unpacking is not installing: a package's postinst does not run. The one
whose postinst matters here is fontconfig-config's, which links the
rendering choices debconf asked about into etc/fonts/conf.d; the links
for its default answers (`postinst_links`) are made after unpacking, so
that text measures as on a Debian machine nobody configured -- Chrome
reads the hinting style from fontconfig, and with none set fontconfig
says hintfull, under which Liberation Sans (what fontconfig's metric
aliases give for Arial) advances differently from under hintslight.
"""

load(":debian_runtime.lock.bzl", "DEBIAN_RUNTIME_PACKAGES")

_BUILD = '''# GENERATED by debian_runtime.bzl: the runtime sysroot's targets.

package(default_visibility = ["//visibility:public"])

# The library directories, each as one directory: what a launcher puts on
# LD_LIBRARY_PATH (//build_defs/web:browser_launcher.bzl).
filegroup(
    name = "libraries",
    srcs = glob(
        [
            "lib/*-linux-gnu*",
            "usr/lib/*-linux-gnu*",
        ],
        exclude_directories = 0,
    ),
)

# Mesa's drivers (swrast, llvmpipe) and GLVND's EGL vendor files, which
# their loaders find by absolute path unless told (LIBGL_DRIVERS_PATH,
# __EGL_VENDOR_LIBRARY_DIRS).
filegroup(
    name = "dri",
    srcs = glob(
        ["usr/lib/*-linux-gnu*/dri"],
        allow_empty = True,
        exclude_directories = 0,
    ),
)

filegroup(
    name = "egl_vendors",
    srcs = glob(
        ["usr/share/glvnd/egl_vendor.d"],
        allow_empty = True,
        exclude_directories = 0,
    ),
)

# The fonts (fonts-dejavu-core, fonts-liberation), one directory: what a
# launcher's fonts.conf confines fontconfig to; and fontconfig's own rules
# (fontconfig-config's etc/fonts/conf.d, links into
# usr/share/fontconfig/conf.avail, with the two its postinst would add),
# which that fonts.conf includes.
filegroup(
    name = "fonts",
    srcs = glob(
        ["usr/share/fonts"],
        allow_empty = True,
        exclude_directories = 0,
    ),
)

filegroup(
    name = "fontconfig_conf_d",
    srcs = glob(
        ["etc/fonts/conf.d"],
        allow_empty = True,
        exclude_directories = 0,
    ),
)

# The X server felt starts for Firefox (xvfb) and its keyboard data
# (xkb-data), for //build_defs/web:browser_launcher.bzl's display_launcher.
filegroup(
    name = "xvfb",
    srcs = glob(
        ["usr/bin/Xvfb"],
        allow_empty = True,
    ),
)

filegroup(
    name = "xkb",
    srcs = glob(
        ["usr/share/X11/xkb"],
        allow_empty = True,
        exclude_directories = 0,
    ),
)

# GIO's modules (glib-networking's TLS, the proxy resolvers): GLib loads
# the directory built into it, /usr/lib/<multiarch>/gio/modules -- the
# host's modules into the sysroot's GLib -- unless GIO_MODULE_DIR says
# otherwise.
filegroup(
    name = "gio_modules",
    srcs = glob(
        ["usr/lib/*-linux-gnu*/gio/modules"],
        allow_empty = True,
        exclude_directories = 0,
    ),
)

# What `flutter build linux` runs besides CMake and the compilers
# (ninja-build, pkg-config), for //build_defs/desktop:build_tools.bzl.
filegroup(
    name = "ninja",
    srcs = glob(
        ["usr/bin/ninja"],
        allow_empty = True,
    ),
)

filegroup(
    name = "pkg_config",
    srcs = glob(
        ["usr/bin/pkg-config"],
        allow_empty = True,
    ),
)

# The packages' metadata and files, for anything that reads them whole.
filegroup(
    name = "all_files",
    srcs = glob(["**"]),
)
'''

def _debian_runtime_sysroot_impl(ctx):
    ar = ctx.path(ctx.attr.llvm_ar)
    for package, entry in ctx.attr.packages.items():
        url, sha256 = entry
        deb = "%s.deb" % package
        ctx.download(url = url, output = deb, sha256 = sha256)
        result = ctx.execute([ar, "t", deb])
        if result.return_code != 0:
            fail("%s: llvm-ar failed on %s: %s" % (ctx.name, deb, result.stderr))
        members = [m for m in result.stdout.split("\n") if m.startswith("data.tar")]
        if len(members) != 1:
            fail("%s: %s has no data.tar member: %s" % (ctx.name, deb, result.stdout))
        result = ctx.execute([ar, "x", deb, members[0]])
        if result.return_code != 0:
            fail("%s: llvm-ar failed on %s: %s" % (ctx.name, deb, result.stderr))
        ctx.extract(members[0], output = ".")
        ctx.delete(members[0])
        ctx.delete(deb)
    for link, target in ctx.attr.postinst_links.items():
        if ctx.path(target).exists:
            ctx.symlink(target, link)
    ctx.file("BUILD.bazel", _BUILD)
    ctx.file("REPO.bazel", "")

# What fontconfig-config's postinst links into etc/fonts/conf.d for the
# debconf defaults (hinting_style hintslight, enable_bitmaps false; the
# Automatic subpixel answer links nothing): not in any .deb's data.tar.
_POSTINST_LINKS = {
    "etc/fonts/conf.d/10-hinting-slight.conf": "usr/share/fontconfig/conf.avail/10-hinting-slight.conf",
    "etc/fonts/conf.d/70-no-bitmaps.conf": "usr/share/fontconfig/conf.avail/70-no-bitmaps.conf",
}

debian_runtime_sysroot = repository_rule(
    implementation = _debian_runtime_sysroot_impl,
    doc = "Debian packages, pinned, unpacked into one tree for LD_LIBRARY_PATH.",
    attrs = {
        "packages": attr.string_list_dict(
            mandatory = True,
            doc = "Package name to [url, sha256] of its .deb (debian_runtime.lock.bzl's entries).",
        ),
        "llvm_ar": attr.label(
            default = "@clang_linux_x64//:bin/llvm-ar",
            doc = "The ar that takes the data.tar out of a .deb (the engine's own clang).",
        ),
        "postinst_links": attr.string_dict(
            default = _POSTINST_LINKS,
            doc = "Symlink to target, both repository-relative: what a package's postinst " +
                  "would have linked; made after unpacking when the target exists.",
        ),
    },
)

def _debian_runtime_extension_impl(_ctx):
    debian_runtime_sysroot(
        name = "sysroot_linux_x64_runtime",
        packages = {
            package: [entry["url"], entry["sha256"]]
            for package, entry in DEBIAN_RUNTIME_PACKAGES.items()
        },
    )

debian_runtime = module_extension(
    implementation = _debian_runtime_extension_impl,
    doc = "The browsers' runtime sysroot, from debian_runtime.lock.bzl.",
)
