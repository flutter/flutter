"""Maven artifacts, pinned, as one repository: the Android embedding's test dependencies.

`maven_artifacts` fetches each artifact of maven.lock.bzl (written by
maven_lock.py from android_tests.artifacts, the closure Gradle resolves for
shell/platform/android/test_runner) by URL and sha256 and lays it out under
`<group>/<artifact>/<version>/`: a `.jar` as it is; an `.aar` unpacked
(`classes.jar`, `res/`, `AndroidManifest.xml`, `R.txt`, `assets/`,
`jni/`), since an Android library's classes are a jar inside a zip and its
resources beside them. The generated BUILD file gives each artifact a
`<group>_<artifact>` filegroup of its jar (the `classes.jar` for an AAR),
an `<group>_<artifact>.aar` filegroup of the unpacked AAR's files when
there is one, and `jars` over every jar -- but Robolectric's `android-all`
jars, which it loads itself from one directory, `robolectric/`, the
`android_all` filegroup; `aar_manifests` and `aar_resources` are the AARs'
manifests and `res/` directories, for the resource APK and R classes a
test module links. The names flatten dots and dashes
to underscores, as rules_jvm_external spells them (`androidx_test_core`,
`org_robolectric_robolectric`), so that a later move to it would rename
nothing.

Maven Central's files are fetched from Google's mirror of it first
(maven-central.storage-download.googleapis.com, a copy of repo1.maven.org
on Cloud Storage) and from repo1.maven.org itself second: repo1 limits
requests by address, and the CI bots, each fetching the whole set afresh
into a clean checkout, share theirs (`429 Too Many Requests` on a
linux_unopt drone, 2026-11-05). The lock keeps the canonical URL; the
sha256 is checked either way.

This is the engine's own small version of what rules_jvm_external does,
kept small on purpose: the root module's graph stays the few modules it
has (the user's call of 2026-10-20 against rules_java and friends), the
resolution is Gradle's, recorded, and the fetch is Bazel's.
"""

load(":maven.lock.bzl", "MAVEN_ARTIFACTS")

def _target_name(coordinate):
    group, artifact, _ = coordinate.split(":")
    return ("%s_%s" % (group, artifact)).replace(".", "_").replace("-", "_")

_MAVEN_CENTRAL = "https://repo1.maven.org/maven2/"
_MAVEN_CENTRAL_MIRROR = "https://maven-central.storage-download.googleapis.com/maven2/"

def _urls(url):
    """The URLs to try for `url`, in order: Google's mirror of Maven Central before Maven Central."""
    if url.startswith(_MAVEN_CENTRAL):
        return [_MAVEN_CENTRAL_MIRROR + url[len(_MAVEN_CENTRAL):], url]
    return [url]

def _maven_artifacts_impl(ctx):
    build = [
        "# GENERATED by maven.bzl: the artifacts of maven.lock.bzl.",
        "",
        'package(default_visibility = ["//visibility:public"])',
        "",
    ]
    jars = []
    android_all = []
    aar_manifests = []
    aar_resources = []
    for coordinate in sorted(ctx.attr.artifacts.keys()):
        packaging, url, sha256 = ctx.attr.artifacts[coordinate]
        group, artifact, version = coordinate.split(":")
        directory = "%s/%s/%s" % (group, artifact, version)
        name = _target_name(coordinate)
        if artifact.startswith("android-all"):
            # Robolectric's framework jars, which it loads in its own class
            # loader and finds by name in one directory
            # (robolectric.dependency.dir): never on a class path.
            jar = "robolectric/%s-%s.jar" % (artifact, version)
            ctx.download(url = _urls(url), output = jar, sha256 = sha256)
            android_all.append(jar)
            continue
        if packaging == "aar":
            archive = "%s/%s-%s.aar" % (directory, artifact, version)
            ctx.download(url = _urls(url), output = archive, sha256 = sha256)
            ctx.extract(archive, output = directory)
            ctx.delete(archive)
            jar = "%s/classes.jar" % directory
            aar_manifests.append("%s/AndroidManifest.xml" % directory)
            aar_resources.append(directory + "/res")
            build.extend([
                "# %s (aar)" % coordinate,
                "filegroup(",
                '    name = "%s",' % name,
                '    srcs = ["%s"],' % jar,
                ")",
                "",
                "filegroup(",
                '    name = "%s.aar",' % name,
                '    srcs = glob(["%s/**"]),' % directory,
                ")",
                "",
            ])
        else:
            jar = "%s/%s-%s.jar" % (directory, artifact, version)
            ctx.download(url = _urls(url), output = jar, sha256 = sha256)
            build.extend([
                "# %s (jar)" % coordinate,
                "filegroup(",
                '    name = "%s",' % name,
                '    srcs = ["%s"],' % jar,
                ")",
                "",
            ])
        jars.append(":" + name)
    build.extend([
        "# Every artifact's jar, the class path (Robolectric's android-all jars apart).",
        "filegroup(",
        '    name = "jars",',
        "    srcs = [",
    ] + ['        "%s",' % jar for jar in jars] + [
        "    ],",
        ")",
        "",
        "# Robolectric's android-all jars, one directory: robolectric.dependency.dir.",
        "filegroup(",
        '    name = "android_all",',
        "    srcs = [",
    ] + ['        "%s",' % jar for jar in android_all] + [
        "    ],",
        ")",
        "",
        "# The AARs' manifests (each names its package) and resource directories,",
        "# for the resource APK and R classes a test module links (android_test_apk).",
        "filegroup(",
        '    name = "aar_manifests",',
        "    srcs = [",
    ] + ['        "%s",' % m for m in aar_manifests] + [
        "    ],",
        ")",
        "",
        "filegroup(",
        '    name = "aar_resources",',
        "    srcs = glob(",
        "        [",
    ] + ['            "%s",' % r for r in aar_resources] + [
        "        ],",
        "        allow_empty = True,",
        "        exclude_directories = 0,",
        "    ),",
        ")",
        "",
    ])
    ctx.file("BUILD.bazel", "\n".join(build))
    ctx.file("REPO.bazel", "")

maven_artifacts = repository_rule(
    implementation = _maven_artifacts_impl,
    doc = "Maven artifacts fetched by URL and sha256, AARs unpacked, one repository.",
    attrs = {
        "artifacts": attr.string_list_dict(
            mandatory = True,
            doc = "Coordinate to [packaging, url, sha256] (maven.lock.bzl's entries).",
        ),
    },
)

def maven_target(coordinate):
    """The label of `coordinate`'s jar in @maven_android_tests (`androidx.test:core:1.6.1` -> `androidx_test_core`)."""
    return "@maven_android_tests//:" + _target_name(coordinate)

def _maven_extension_impl(_ctx):
    maven_artifacts(
        name = "maven_android_tests",
        artifacts = {
            coordinate: [entry["packaging"], entry["url"], entry["sha256"]]
            for coordinate, entry in MAVEN_ARTIFACTS.items()
        },
    )

maven = module_extension(
    implementation = _maven_extension_impl,
    doc = "The Android embedding's test dependencies, from maven.lock.bzl.",
)
