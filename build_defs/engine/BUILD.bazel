# The engine as the framework's and the tool's tests consume it: built from
# the tree (the default), or the prebuilt artifacts the flutter tool
# downloaded into bin/cache (build_defs/repositories/flutter_bin_cache.bzl).
# Every test rule names these aliases rather than the engine's targets, so
# that `--//build_defs/engine:source=prebuilt` (`--config=prebuilt_engine`,
# which also points the host's Dart SDK repository at bin/cache/dart-sdk)
# runs the tests in a checkout without the engine's dependencies -- a
# framework developer's, a flutter_drone bot's -- and, in one with them,
# without building the engine first.

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@host_platform//:host.bzl", "HOST_OS")
load("//build_defs/dist:local_engine.bzl", "files_directory")

package(default_visibility = ["//visibility:public"])

string_flag(
    name = "source",
    build_setting_default = "tree",
    values = [
        "tree",
        "prebuilt",
    ],
)

config_setting(
    name = "prebuilt",
    flag_values = {":source": "prebuilt"},
)

# flutter_tester, the engine every Flutter test runs on (flutter_test.bzl).
alias(
    name = "flutter_tester",
    actual = select({
        ":prebuilt": "@flutter_bin_cache//:flutter_tester",
        "//conditions:default": "//engine/src/flutter/shell/testing:flutter_tester",
    }),
)

# ICU's data file flutter_tester loads (--icu-data-file-path).
alias(
    name = "icudtl",
    actual = select({
        ":prebuilt": "@flutter_bin_cache//:icudtl",
        "//conditions:default": "@icu//:icudata",
    }),
)

# The platform kernels the frontend server compiles a test against
# (flutter_patched_sdk; kernel.bzl's --sdk-root).
alias(
    name = "strong_platform",
    actual = select({
        ":prebuilt": "@flutter_bin_cache//:flutter_patched_sdk",
        "//conditions:default": "//engine/src/flutter/lib/snapshot:strong_platform",
    }),
)

# The shader compiler and its library, for a test's shader assets
# (flutter_assets.bzl).
alias(
    name = "impellerc",
    actual = select({
        ":prebuilt": "@flutter_bin_cache//:impellerc",
        "//conditions:default": "//build_defs/impeller:impellerc",
    }),
)

alias(
    name = "shader_lib",
    actual = select({
        ":prebuilt": "@flutter_bin_cache//:shader_lib",
        "//conditions:default": "//engine/src/flutter/impeller/compiler/shader_lib:all_files",
    }),
)

# Flutter GPU's package, as the tool's cache holds it (pkg/flutter_gpu;
# dart:ui's, pkg/sky_engine, is a directory artifact from the tree and
# files from bin/cache, which the tool's BUILD file lays each its own way).
alias(
    name = "flutter_gpu",
    actual = select({
        ":prebuilt": "@flutter_bin_cache//pkg/flutter_gpu:package",
        "//conditions:default": "//engine/src/flutter/lib/gpu:dart_sources",
    }),
)

# A Mac's prebuilt host engine directories as one directory artifact each,
# for the tool tests' SDK facsimile (packages/flutter_tools/BUILD.bazel):
# bin/cache's darwin-x64{,-profile,-release} hold FlutterMacOS.xcframework,
# whose framework is a versioned bundle of directory links (Versions/Current
# -> A, Headers -> Versions/Current/Headers, ...). @flutter_bin_cache's globs
# follow the links, so laid file by file the bundle comes flat, its contents
# three times over, which a codesign refuses ("bundle format is ambiguous";
# the apple shard's `flutter build macos` under --config=prebuilt_engine,
# the Mac's T78). files_directory copies the files and makes the links
# again (assemble_directory.py's relink_frameworks), as the tree's
# host_engine_directory has them. On Linux the files lie flat anyway and
# are laid in place (no frameworks).
[
    files_directory(
        name = "prebuilt_host_engine%s_directory" % suffix,
        srcs = ["@flutter_bin_cache//:host_engine" + suffix],
        strip_prefix = "artifacts/engine/darwin-x64" + suffix.replace("_", "-"),
    )
    for suffix in ([
        "",
        "_profile",
        "_release",
    ] if HOST_OS == "mac" else [])
]

# The iOS engine directories the same way (`flutter precache --ios`:
# bin/cache's artifacts/engine/ios{,-profile,-release}), for the apple
# shard's facsimile under the prebuilt engine: the device and simulator
# Flutter.xcframeworks, the extension-safe ones, gen_snapshot_arm64 and the
# LICENSE the cache copied in. An iOS framework is a flat bundle, so there
# is nothing to relink; the directory artifact is what the facsimile's
# writable copies (APFS clones) want. Empty where the tool has not fetched
# them, in which case the tool fetches them at run time as the checkout's
# would.
[
    files_directory(
        name = "prebuilt_ios_engine%s_directory" % suffix,
        srcs = ["@flutter_bin_cache//:ios_engine" + suffix],
        strip_prefix = "artifacts/engine/ios" + suffix.replace("_", "-"),
    )
    for suffix in ([
        "",
        "_profile",
        "_release",
    ] if HOST_OS == "mac" else [])
]
