"""A googletest suite run on an Android device, as testing/run_tests.py's --type android runs it.

`run_android_tests` (testing/run_tests.py) takes each suite's executable
from the build directory, `adb push`es it to /data/local/tmp and runs it
there with `adb shell`, with no arguments and no environment; adb's exit
status is the verdict, and on a failure `adb logcat -d` is kept
(`$FLUTTER_TEST_OUTPUTS_DIR/<name>_logcat`). `flutter_android_device_test`
does the same from a test's runfiles: the executable is a cc_binary of the
target (Android) configuration, the test a launcher that runs on the host
against the device the recipe's `android_virtual_device` context has booted
and connected (the emulator and the adb server are the context's: the
launcher starts neither, picks no serial, and takes `adb` from PATH -- an
adb of another version would restart the server under the recipe), and the
logcat goes to the test's undeclared outputs, its tail into the log.

The test runs on the machine (`local`: the adb server is reached over the
host's loopback, and the device is not an input Bazel could track:
`external`), one at a time (`exclusive`: one device, fixed paths under
/data/local/tmp), and only for an Android target configuration
(`target_compatible_with`), so a host configuration's wildcard run skips it
as it skips the cc_binary.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary")

_LAUNCHER = """#!/bin/bash
# Generated by //build_defs/testing:android_device_test.bzl -- the suite on
# the connected device, as testing/run_tests.py's run_android_unittest.
set -u
binary='{binary}'
name='{name}'
adb="${{ADB:-adb}}"
device_path="/data/local/tmp/$name"
echo "$adb push $binary $device_path"
"$adb" push "$binary" "$device_path" || exit 1
"$adb" shell chmod 755 "$device_path" || exit 1
echo "$adb shell $device_path"
# adb hands the command's exit status on (the shell protocol of API 24 and
# later; run_tests.py relies on the same).
"$adb" shell "$device_path"
status=$?
if [ "$status" -ne 0 ]; then
  outputs="${{TEST_UNDECLARED_OUTPUTS_DIR:-${{TEST_TMPDIR:-/tmp}}}}"
  logcat="$outputs/${{name}}_logcat"
  "$adb" logcat -d > "$logcat" 2>&1
  echo "--- $name exited with $status; adb logcat -d (last 200 lines; the whole log is outputs/${{name}}_logcat) ---"
  tail -n 200 "$logcat"
fi
exit "$status"
"""

def _android_device_test_impl(ctx):
    launcher = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = launcher,
        content = _LAUNCHER.format(
            binary = ctx.executable.binary.short_path,
            # The test's name is the suite's output name in GN, and the file's
            # name on the device is the same as under run_tests.py.
            name = ctx.label.name,
        ),
        is_executable = True,
    )
    runfiles = ctx.runfiles(files = [ctx.executable.binary])
    runfiles = runfiles.merge(ctx.attr.binary[DefaultInfo].default_runfiles)
    return [
        DefaultInfo(executable = launcher, runfiles = runfiles),
        # The recipe's adb on PATH and the serial/server variables it may set;
        # HOME for the client's keys should it have to start a server.
        RunEnvironmentInfo(inherited_environment = [
            "PATH",
            "HOME",
            "ADB",
            "ANDROID_SERIAL",
            "ANDROID_ADB_SERVER_PORT",
            "ADB_SERVER_SOCKET",
        ]),
    ]

_android_device_test = rule(
    implementation = _android_device_test_impl,
    test = True,
    doc = "Pushes a googletest executable to the connected Android device and runs it there, as " +
          "testing/run_tests.py --type android does.",
    attrs = {
        "binary": attr.label(
            mandatory = True,
            executable = True,
            cfg = "target",
            doc = "The suite's executable, built for the Android target configuration.",
        ),
    },
)

def flutter_android_device_test(name, size = "large", timeout = None, flaky = None, tags = [], visibility = None, args = [], env = {}, data = [], shard_count = None, **kwargs):
    """A googletest suite of the engine run on an Android device, as testing/run_tests.py --type android runs it.

    The executable is a cc_binary (`<name>_binary`) of the target
    configuration -- the Android one the suite is built for -- and the test
    target pushes it to the connected device and runs it whole: no
    gtest-parallel, no arguments, no environment (run_android_unittest).

    Args:
      name: name of the test (the suite's output name); the executable is
        `<name>_binary`, pushed as `/data/local/tmp/<name>`.
      size: the test's size (large: the push of an unstripped executable and
        the whole suite's run on an emulator).
      timeout: the test's timeout.
      flaky: the test's flaky attribute.
      tags: tags of the test, besides local, exclusive and external.
      visibility: visibility of the test.
      args: not supported -- run_android_unittest runs the suite with no
        arguments; an error, so that a parity gap is seen rather than dropped.
      env: not supported, as `args`.
      data: not supported, as `args`: nothing but the executable is pushed.
      shard_count: not supported, as `args`: the suite runs whole.
      **kwargs: the executable's attributes (cc_test's: srcs, deps, copts, ...).
    """
    for attribute, value in [("args", args), ("env", env), ("data", data), ("shard_count", shard_count)]:
        if value:
            fail("%s: flutter_android_device_test takes no %s: run_tests.py pushes the executable alone and runs it with no arguments" % (name, attribute))
    cc_binary(
        name = name + "_binary",
        testonly = True,
        visibility = ["//visibility:private"],
        **kwargs
    )
    _android_device_test(
        name = name,
        binary = ":" + name + "_binary",
        size = size,
        timeout = timeout,
        flaky = flaky,
        tags = tags + ["local", "exclusive", "external"],
        target_compatible_with = ["@platforms//os:android"],
        visibility = visibility,
    )
