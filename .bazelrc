# Hand-maintained Bazel settings: repository-wide policy. The build
# configurations mirroring the builders' `tools/gn` flags are generated into
# engine/src/flutter/ci/builders/configs.bazelrc, imported at the end.

# Keep the convenience symlinks (bazel-bin, bazel-out, bazel-testlogs, ...)
# under the GN output root rather than the repository root, so running Bazel
# leaves no trace outside directories that are already ignored.
common --symlink_prefix=engine/src/out/bazel-

# Name a build's output directory after its platform rather than the host
# CPU, which every platform shares (k8-opt/). The platforms are per runtime
# mode (build_defs/config/platforms.bzl: the builders' configurations name
# `<platform>_<mode>`, the mode a platform flag), so each mode of each
# platform has a directory of its own, as GN has a build directory per mode:
# bazel-out/linux_x64_debug-opt/, linux_x64_release-opt/,
# android_arm64_profile-opt/, wasm32_emscripten_release-opt/ -- a build that
# names no platform keeps k8-<compilation mode>. The flutter tool reads a
# build in place through its local_engine.json
# (build_defs/dist/local_engine.bzl), and an Android engine and the host
# engine it pairs with, or two modes of one engine, must all be on disk: in
# one directory each build would overwrite the others' manifests and the
# outputs whose paths they share.
common --experimental_platform_in_output_dir

# The toolchain's sysroot and standard-library headers are directory inputs
# (one symlink per action in the sandbox instead of ~11,000; see
# build/bazel/third_party/sysroot). Bazel tracks the contents of directory
# inputs soundly only with this property; without it every action warns and
# a change inside the directory may go unnoticed.
startup --host_jvm_args=-DBAZEL_TRACK_SOURCE_DIRECTORIES=1

# Actions must not inherit the invoking user's environment.
build --incompatible_strict_action_env

# C/C++ is built only with the hermetic toolchains registered in MODULE.bazel;
# never auto-detect a compiler on the host.
build --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Mirror GN: every object is position independent (-fPIC on all platforms
# that support it) and libraries are linked statically into executables and
# shared libraries -- there is no component build.
build --force_pic
build --dynamic_mode=off

# BUILDCONFIG.gn gives every executable, shared library and loadable module a
# dependency on the engine's own libc++. cc_binary and cc_test get it through
# this flag; cc_shared_library targets list it explicitly.
build --@bazel_tools//tools/cpp:link_extra_libs=//engine/src/flutter/build/bazel/toolchains:cxx_runtime

# GN's `complete_static_lib` (the Impeller SDK's libimpeller.a: an archive of
# every object in the dependency closure) is cc_static_library, which Bazel 8
# ships behind this flag.
build --experimental_cc_static_library

# Non-test rules depend on tests here, as GN's build directory holds its test
# executables: //engine/src/flutter:benchmark_binaries lists the benchmarks a
# wildcard build must compile, an install lays a builder's targets out. Bazel
# trims the test options from a test reached through a non-test rule, which
# puts the test in a second configuration beside the one `bazel test`
# analyzes, with the same output paths ("generated by these conflicting
# actions"). One configuration for both; the price is that a change of a test
# option (--test_timeout, --test_env) re-analyzes everything.
build --notrim_test_configuration

# A content-addressed cache of action outputs shared by every checkout and
# output base of this user, garbage-collected to the cap by the idle server.
# Half of a cold build is the exec configuration (impellerc's closure, built
# once per output base); with the cache a second cold build of the same
# inputs -- after `bazel clean`, in another checkout, after a branch switch
# and back -- is a hit for every action (measured: 78 s against 772 s for the
# Phase 0 exit test). CI runs on RBE instead (build:rbe below).
build --disk_cache=~/.cache/flutter_engine_bazel
build --experimental_disk_cache_gc_max_size=20G

# CI's invocations (tools/gn --bazel and testing/run_tests.py on a bot,
# through engine/src/flutter/build/bazel/bazel_ci.py; see ci.md there): plain
# output for a log, a progress line every 30 s rather than five a second,
# failures spelled out, every failing test's log in the output. A bot's
# state lives under the checkout's .bazel_ci, where bazel_ci.py puts the
# output root and, on the command line, the disk cache (bazel_ci.py's
# build_options: the builders' builds alternate flags the exec configuration
# shares, and the cache serves the repeats).
common:ci --color=no --curses=no --show_timestamps --show_progress_rate_limit=30 --announce_rc
build:ci --verbose_failures
test:ci --test_output=errors --keep_going --test_summary=short

# Flutter's RBE instance (build:rbe): the one the GN builds' reclient uses,
# projects/flutter-rbe-prod/instances/default (the builders' $flutter/rbe
# property), running the actions -- the compiles, links, kernel compiles,
# the Dart snapshots -- on its workers, 200 at a time (the builders'
# rbe_jobs), in the builders' debian11 image, and caching the results for
# every later build. Reached with Application Default Credentials: on a
# LUCI bot the emulated GCE metadata server every bot has (the rbe recipe
# module's RBE_use_gce_credentials), on a workstation `gcloud auth
# application-default login`. Execution is what fills the cache here: on
# this instance a client cannot write a locally run action's result to the
# cache (the bots' service account included), only a worker can, so a build
# that only reads the cache (--remote_cache alone) finds nothing of its own.
# The tests run on the workers too, the headless ones: the framework's
# under flutter_tester and the pure-Dart packages', which is most of a
# framework shard -- what a bot then downloads of a test is its logs and
# its results, not its kernel (50 MB each, 40 GB a shard). What stays on
# the machine: the wrapped GN builds (gn_build.bzl's no-remote-exec: their
# inputs are a synced tree, and they take an hour), the tests tagged
# no-remote-exec (dart_test.bzl, flutter_test.bzl: those that may reach the
# network, drive a browser or a display, or run a tool of the host -- the
# workers have no network and nothing of the host; every one of the tool's
# shards), and the engine's suites (run_tests.py keeps them on the machine:
# a display, a GPU, a device). Linux hosts only: the workers are Linux x64
# and so must the execution platform be; bazel_ci.py and test.dart add the
# config on a Linux bot. Measured from a workstation: fml_unittests' 676
# actions in 93 s (critical path 60), then all hits from a fresh output
# base.
build:rbe --remote_executor=grpcs://remotebuildexecution.googleapis.com
build:rbe --remote_instance_name=projects/flutter-rbe-prod/instances/default
build:rbe --google_default_credentials
build:rbe --remote_default_exec_properties=container-image=docker://gcr.io/cloud-marketplace/google/debian11@sha256:69e2789c9f3d28c6a0f13b25062c240ee7772be1f5e6d41bb4680b63eae6b304
build:rbe --remote_default_exec_properties=OSFamily=Linux
build:rbe --jobs=200
build:rbe --remote_timeout=600
# No symlink forest for a test that runs on a worker (its runfiles go to
# the worker as inputs); one is laid when a local test or `bazel run` needs
# it. //:framework_tests //:dart_tests are 2,111 forests of 650 to 5,500
# links each, minutes of a bot's network disk.
build:rbe --nobuild_runfile_links

# The prebuilt engine for the framework's and the tool's tests: the
# artifacts the flutter tool downloaded into bin/cache (`bin/flutter
# precache`; build_defs/repositories/flutter_bin_cache.bzl) in place of the
# engine the tree builds -- //build_defs/engine's aliases take the prebuilt
# side, and the host's Dart SDK repository is bin/cache/dart-sdk. For a
# checkout without the engine's dependencies (no `gclient sync`), and for
# one that has them but would rather not build the engine for a framework
# test run.
build:prebuilt_engine --//build_defs/engine:source=prebuilt
build:prebuilt_engine --repo_env=FLUTTER_BAZEL_PREBUILT_ENGINE=1

# The builders' configurations (`--config=host_debug`, ...), generated from
# ci/builders/linux_*.json by tools/gn_to_bazel.
import %workspace%/engine/src/flutter/ci/builders/configs.bazelrc

# Personal overrides (ignored by git).
try-import %workspace%/user.bazelrc
