# Hand-maintained Bazel settings: repository-wide policy. The build
# configurations mirroring the builders' `tools/gn` flags are generated into
# engine/src/flutter/ci/builders/configs.bazelrc, imported at the end.

# Keep the convenience symlinks (bazel-bin, bazel-out, bazel-testlogs, ...)
# under the GN output root rather than the repository root, so running Bazel
# leaves no trace outside directories that are already ignored.
common --symlink_prefix=engine/src/out/bazel-

# Name a cross build's output directory after its platform
# (bazel-out/android_arm64-opt/, wasm32_emscripten-opt/, linux_arm64-opt/)
# rather than the host CPU, which every platform shares (k8-opt/) -- the
# host's own build keeps k8-<mode>. The flutter tool reads a build in place
# through its local_engine.json (build_defs/dist/local_engine.bzl), and an
# Android engine and the host engine it pairs with must both be on disk: in
# one directory each build would overwrite the other's manifest and the
# outputs whose paths they share.
common --experimental_platform_in_output_dir

# The toolchain's sysroot and standard-library headers are directory inputs
# (one symlink per action in the sandbox instead of ~11,000; see
# build/bazel/third_party/sysroot). Bazel tracks the contents of directory
# inputs soundly only with this property; without it every action warns and
# a change inside the directory may go unnoticed.
startup --host_jvm_args=-DBAZEL_TRACK_SOURCE_DIRECTORIES=1

# Actions must not inherit the invoking user's environment.
build --incompatible_strict_action_env

# C/C++ is built only with the hermetic toolchains registered in MODULE.bazel;
# never auto-detect a compiler on the host.
build --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Mirror GN: every object is position independent (-fPIC on all platforms
# that support it) and libraries are linked statically into executables and
# shared libraries -- there is no component build.
build --force_pic
build --dynamic_mode=off

# BUILDCONFIG.gn gives every executable, shared library and loadable module a
# dependency on the engine's own libc++. cc_binary and cc_test get it through
# this flag; cc_shared_library targets list it explicitly.
build --@bazel_tools//tools/cpp:link_extra_libs=//engine/src/flutter/build/bazel/toolchains:cxx_runtime

# GN's `complete_static_lib` (the Impeller SDK's libimpeller.a: an archive of
# every object in the dependency closure) is cc_static_library, which Bazel 8
# ships behind this flag.
build --experimental_cc_static_library

# Non-test rules depend on tests here, as GN's build directory holds its test
# executables: //engine/src/flutter:benchmark_binaries lists the benchmarks a
# wildcard build must compile, an install lays a builder's targets out. Bazel
# trims the test options from a test reached through a non-test rule, which
# puts the test in a second configuration beside the one `bazel test`
# analyzes, with the same output paths ("generated by these conflicting
# actions"). One configuration for both; the price is that a change of a test
# option (--test_timeout, --test_env) re-analyzes everything.
build --notrim_test_configuration

# A content-addressed cache of action outputs shared by every checkout and
# output base of this user, garbage-collected to the cap by the idle server.
# Half of a cold build is the exec configuration (impellerc's closure, built
# once per output base); with the cache a second cold build of the same
# inputs -- after `bazel clean`, in another checkout, after a branch switch
# and back -- is a hit for every action (measured: 78 s against 772 s for the
# Phase 0 exit test). CI will point --remote_cache at a shared one instead.
build --disk_cache=~/.cache/flutter_engine_bazel
build --experimental_disk_cache_gc_max_size=20G

# The builders' configurations (`--config=host_debug`, ...), generated from
# ci/builders/linux_*.json by tools/gn_to_bazel.
import %workspace%/engine/src/flutter/ci/builders/configs.bazelrc

# Personal overrides (ignored by git).
try-import %workspace%/user.bazelrc
