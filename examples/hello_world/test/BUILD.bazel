# hello_world's tests under Bazel: each *_test.dart compiled by the frontend server
# from a prelude kernel and run on the Bazel-built flutter_tester, as
# `flutter test` runs it (//packages/flutter_test:package_tests.bzl;
# research/15).
#
#   bazel test //examples/hello_world/test:tests

load("//packages/flutter_test:package_tests.bzl", "flutter_package_tests")

package(default_visibility = ["//visibility:public"])

flutter_package_tests(
    name = "tests",
    srcs = glob(
        ["**/*.dart"],
        allow_empty = True,
        exclude = ["**/*_test.dart"],
    ),
    directory = "examples/hello_world",
    package = "hello_world",
    tests = glob(["**/*_test.dart"]),
    # flutter_driver, a dev dependency, is not imported by the test.
    without = ["flutter_driver"],
)

# The test files as files, for flutter_tools' command_output_test, which
# runs `flutter test test/hello_test.dart` here from its SDK facsimile.
filegroup(
    name = "files",
    srcs = glob(["**/*.dart"]),
)
