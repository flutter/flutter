# flutter_examples_layers's tests under Bazel: each *_test.dart compiled by the frontend server
# from a prelude kernel and run on the Bazel-built flutter_tester, as
# `flutter test` runs it (//packages/flutter_test:package_tests.bzl;
# research/15).
#
#   bazel test //examples/layers/test:tests

load("//packages/flutter_test:package_tests.bzl", "flutter_package_tests")

package(default_visibility = ["//visibility:public"])

flutter_package_tests(
    name = "tests",
    srcs = glob(
        ["**/*.dart"],
        allow_empty = True,
        exclude = ["**/*_test.dart"],
    ),
    # The isolate example's smoke test loads services/data.json.
    assets = ["//examples/layers:assets"],
    directory = "examples/layers",
    package = "flutter_examples_layers",
    # package:material_ui, a dependency, reaches flutter_localizations.
    packages = {"//packages/flutter_localizations:sources": "flutter_localizations"},
    tests = glob(["**/*_test.dart"]),
)
