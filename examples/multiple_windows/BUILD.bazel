# The multiple-windows example (a package outside the pub workspace, whose
# dependencies the workspace's lock covers): its files, for its tests
# (test/BUILD.bazel).

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["lib/**"]) + ["pubspec.yaml"],
)

exports_files(["pubspec.yaml"])
