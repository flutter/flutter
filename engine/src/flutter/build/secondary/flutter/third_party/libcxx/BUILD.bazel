# The engine's libc++ configuration headers (__config_site and
# __assertion_handler). Every C++ compile action gets this directory on its
# include path from the toolchain; see
# //engine/src/flutter/build/bazel/toolchains.

package(default_visibility = ["//visibility:public"])

# The toolchain derives the include path from this file's location.
exports_files(["config/__config_site"])

filegroup(
    name = "config_headers",
    srcs = [
        "config/__assertion_handler",
        "config/__config_site",
    ],
)
