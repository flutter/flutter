# What GN has no words for; maintained in the converter's manifest
# (tools/gn_to_bazel/lib/src/manifest.dart).

# The GN file, for the wrapped GN builds that read //flutter/build
# (//engine/src/flutter/build:gn_files; a glob does not enter a package).
filegroup(
    name = "gn_files",
    srcs = ["BUILD.gn"],
    visibility = ["//engine/src/flutter/build:__pkg__"],
)

# The host's development artifacts unpacked as the flutter tool's cache lays
# them, for the tests' SDK facsimile (a dart_test's cache_files; what
# `flutter precache` downloads for the host): bin/cache/artifacts/engine/<host>
# is artifacts.zip and font-subset.zip unpacked together -- and the debug
# desktop embedding's archives, which `flutter precache --linux|--macos`
# adds: on Linux the GTK shell's, on a Mac the universal framework's and
# gen_snapshots' below -- <host>-profile and <host>-release the other
# modes' (gen_snapshot and the embedding, built under that mode's
# configuration: in_configuration), common/ the patched SDK's debug and
# product archives. The directories exist for the Linux and Mac hosts (the
# Mac's T43); elsewhere they are incompatible rather than failing the
# package's analysis.
bundle_directory(
    name = "host_engine_directory",
    bundles = [
        ":artifacts",
        "//engine/src/flutter/tools/font_subset:font_subset",
    ] + select({
        "@platforms//os:linux": ["//engine/src/flutter/shell/platform/linux:flutter_gtk"],
        "@platforms//os:macos": [
            ":macos_framework",
            ":macos_gen_snapshot",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# The recipe's other Mac archives, which the cache unpacks into the same
# darwin-x64* directories: framework.zip (FlutterMacOS.xcframework) and
# gen_snapshot.zip (gen_snapshot_arm64 and gen_snapshot_x64) are the Mac
# builders' generators, not GN targets (ci/builders/mac_host_engine.json:
# create_macos_framework.py lipos an arm64 and an x64 build's frameworks
# into one xcframework -- with its dSYM, stripped, in release --,
# create_macos_gen_snapshots.py gathers the two builds' universal
# gen_snapshots). Here each is one target over both builds
# (//build_defs/dist:universal.bzl: a split transition, in the current
# runtime mode, the recipe's script over them) and the archive the recipe
# uploads, under darwin-x64[-<mode>] -- the recipe's name for the universal
# artifacts whatever the Mac ("until darwin artifacts are universal and
# moved out of darwin-x64", artifacts.dart).
apple_universal(
    name = "universal_macos_framework",
    args = [
        "--dst",
        "{dst}",
        "--arm64-out-dir",
        "{build:arm64}",
        "--x64-out-dir",
        "{build:x64}",
    ] + select({
        "//engine/src/flutter/common:runtime_mode_release": [
            "--dsym",
            "--strip",
        ],
        "//conditions:default": [],
    }),
    builds = {
        "arm64": "macos_arm64",
        "x64": "macos_x64",
    },
    directories = ["FlutterMacOS.xcframework"],
    script = "//engine/src/flutter/sky:tools/create_macos_framework.py",
    script_deps = [
        "//engine/src/flutter/sky:tools/create_xcframework.py",
        "//engine/src/flutter/sky:tools/sky_utils.py",
    ],
    stage = ["FlutterMacOS.framework"],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//engine/src/flutter/shell/platform/darwin/macos:universal_flutter_framework"],
)

apple_universal(
    name = "universal_macos_gen_snapshots",
    args = [
        "--dst",
        "{dst}",
        "--arm64-path",
        "{build:arm64}/universal/gen_snapshot_arm64",
        "--x64-path",
        "{build:x64}/universal/gen_snapshot_x64",
    ],
    builds = {
        "arm64": "macos_arm64",
        "x64": "macos_x64",
    },
    files = [
        "gen_snapshot_arm64",
        "gen_snapshot_x64",
    ],
    script = "//engine/src/flutter/sky:tools/create_macos_gen_snapshots.py",
    stage = ["universal"],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//engine/src/flutter/lib/snapshot:create_macos_gen_snapshots"],
)

_MAC_DIRECTORY = {
    "debug": "darwin-x64",
    "profile": "darwin-x64-profile",
    "release": "darwin-x64-release",
    "jit_release": "darwin-x64-jit_release",
}

zip_bundle(
    name = "macos_framework",
    files = {"FlutterMacOS.xcframework": ":universal_macos_framework"},
    output = select({
        "//engine/src/flutter/common:runtime_mode_" + mode: directory + "/framework.zip"
        for mode, directory in _MAC_DIRECTORY.items()
    }),
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

zip_bundle(
    name = "macos_gen_snapshot",
    files = {
        "gen_snapshot_arm64": ":universal_macos_gen_snapshots",
        "gen_snapshot_x64": ":universal_macos_gen_snapshots",
    },
    output = select({
        "//engine/src/flutter/common:runtime_mode_" + mode: directory + "/gen_snapshot.zip"
        for mode, directory in _MAC_DIRECTORY.items()
    }),
    sources = {
        "gen_snapshot_arm64": "universal_macos_gen_snapshots/gen_snapshot_arm64",
        "gen_snapshot_x64": "universal_macos_gen_snapshots/gen_snapshot_x64",
    },
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

[
    in_configuration(
        name = "%s_%s" % (bundle, mode),
        runtime_mode = mode,
        target = ":" + bundle,
        target_compatible_with = ["@platforms//os:macos"],
    )
    for bundle in [
        "macos_framework",
        "macos_gen_snapshot",
    ]
    for mode in [
        "profile",
        "release",
    ]
]

in_configuration(
    name = "artifacts_profile",
    runtime_mode = "profile",
    target = ":artifacts",
)

in_configuration(
    name = "flutter_gtk_profile",
    runtime_mode = "profile",
    target = "//engine/src/flutter/shell/platform/linux:flutter_gtk",
    target_compatible_with = ["@platforms//os:linux"],
)

bundle_directory(
    name = "host_engine_profile_directory",
    bundles = [":artifacts_profile"] + select({
        "@platforms//os:linux": [":flutter_gtk_profile"],
        "@platforms//os:macos": [
            ":macos_framework_profile",
            ":macos_gen_snapshot_profile",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

in_configuration(
    name = "artifacts_release",
    runtime_mode = "release",
    target = ":artifacts",
)

in_configuration(
    name = "flutter_gtk_release",
    runtime_mode = "release",
    target = "//engine/src/flutter/shell/platform/linux:flutter_gtk",
    target_compatible_with = ["@platforms//os:linux"],
)

bundle_directory(
    name = "host_engine_release_directory",
    bundles = [":artifacts_release"] + select({
        "@platforms//os:linux": [":flutter_gtk_release"],
        "@platforms//os:macos": [
            ":macos_framework_release",
            ":macos_gen_snapshot_release",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

in_configuration(
    name = "flutter_patched_sdk_release",
    runtime_mode = "release",
    target = ":flutter_patched_sdk",
)

bundle_directory(
    name = "common_engine_directory",
    bundles = [
        ":flutter_patched_sdk",
        ":flutter_patched_sdk_release",
    ],
)

# The Android artifacts the same way, for the tests that run `flutter
# build apk` (//build_defs/android:build_tools.bzl): gen_snapshot per CPU
# and AOT mode as android-<cpu>-<mode>/linux-x64, and the embedding's Maven
# artifacts as a repository (android_engine_maven) -- the engine built for
# arm, arm64 and x64 in debug, profile and release, the Android builders'
# configurations, through in_configuration.
# The Linux host's for now: the JDK overlay (@openjdk) lays out a Linux
# JDK, not a Mac's bundle (Contents/Home), so the jars' actions do not
# analyze on a Mac (the Mac's T14).
android_engine_artifacts(
    name = "android_engine",
    target_compatible_with = ["@platforms//os:linux"],
)
