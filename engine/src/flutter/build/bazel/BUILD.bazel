# Bazel-only build support. This package exists so that the generated
# `deps.lock.bzl` belongs to a Bazel package and can be loaded by module
# extensions and tooling, and holds the build-wide config_settings.

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

exports_files([
    "deps.lock.bzl",
    # zip_bundle.bzl's wrapper of build/zip.py.
    "zip_bundle.py",
])

# GN's `is_debug` is "unoptimized", which Bazel spells -c dbg or -c fastbuild;
# `optimized` is the complement (tools/gn without --unoptimized) and
# `unoptimized` is `is_debug` itself, for the generated files that select()
# on it.
config_setting(
    name = "optimized",
    values = {"compilation_mode": "opt"},
)

config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
)

config_setting(
    name = "fastbuild",
    values = {"compilation_mode": "fastbuild"},
)

selects.config_setting_group(
    name = "unoptimized",
    match_any = [
        ":dbg",
        ":fastbuild",
    ],
)

# The complements of BUILDCONFIG.gn's OS predicates. `!is_wasm` on its own
# is a select() with the wasm key empty, but inside a conjunction
# (`impeller_enable_opengles && !is_wasm`) a config_setting_group needs a
# setting that *holds* when the OS is another one -- which, the predicates
# being mutually exclusive, is any of the other seven. The converter names
# these for the negated terms of the groups it generates.
_OS_CONSTRAINTS = {
    "android": "@platforms//os:android",
    "fuchsia": "@platforms//os:fuchsia",
    "ios": "@platforms//os:ios",
    "linux": "@platforms//os:linux",
    "mac": "@platforms//os:macos",
    "qnx": "@platforms//os:qnx",
    "wasm": "@platforms//os:emscripten",
    "win": "@platforms//os:windows",
}

[
    selects.config_setting_group(
        name = "not_" + os,
        match_any = [
            constraint
            for other, constraint in _OS_CONSTRAINTS.items()
            if other != os
        ],
    )
    for os in _OS_CONSTRAINTS
]

# GN's `current_toolchain == host_toolchain`, which the engine's files test
# for "the host's own build" (testing.gni's enable_unittests, the shell's
# tester, glfw's shell), read in Bazel's terms: the target OS is one a host
# runs. A cross-compile for the host's own OS and another CPU is the one GN
# case this does not tell apart. The converter names the predicate
# is_host_toolchain (gn_eval's hostToolchainPredicate); the complement is
# the OSes only a target runs.
_HOST_OSES = [
    "linux",
    "mac",
    "win",
]

selects.config_setting_group(
    name = "host_toolchain",
    match_any = [_OS_CONSTRAINTS[os] for os in _HOST_OSES],
)

selects.config_setting_group(
    name = "not_host_toolchain",
    match_any = [
        constraint
        for os, constraint in _OS_CONSTRAINTS.items()
        if os not in _HOST_OSES
    ],
)

# GN's is_asan (build/config/sanitizers/sanitizers.gni; tools/gn --asan,
# which Linux's host_debug_unopt test builder passes): AddressSanitizer on
# every compile and link. The toolchain's `asan` feature selects on it
# (toolchains/BUILD.bazel), the wrapped GN builds pass it on as is_asan, and
# the test launchers export CI's sanitizer environment under it
# (sanitizers.bzl). Nothing else: the engine's GN links no sanitizer options
# of its own (//build/config/sanitizers:deps comes only with BUILDCONFIG.gn's
# component() template, which no engine target uses), so the runtime's
# defaults stand there as here, qualified by that environment.
bool_flag(
    name = "asan",
    build_setting_default = False,
)

config_setting(
    name = "asan_enabled",
    flag_values = {":asan": "True"},
)
