# Bazel-only build support. This package exists so that the generated
# `deps.lock.bzl` belongs to a Bazel package and can be loaded by module
# extensions and tooling, and holds the build-wide config_settings.

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

exports_files([
    "deps.lock.bzl",
    # zip_bundle.bzl's wrapper of build/zip.py.
    "zip_bundle.py",
])

# GN's `is_debug` is "unoptimized", which Bazel spells -c dbg or -c fastbuild;
# `optimized` is the complement (tools/gn without --unoptimized) and
# `unoptimized` is `is_debug` itself, for the generated files that select()
# on it.
config_setting(
    name = "optimized",
    values = {"compilation_mode": "opt"},
)

config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
)

config_setting(
    name = "fastbuild",
    values = {"compilation_mode": "fastbuild"},
)

selects.config_setting_group(
    name = "unoptimized",
    match_any = [
        ":dbg",
        ":fastbuild",
    ],
)

# The complements of BUILDCONFIG.gn's OS predicates. `!is_wasm` on its own
# is a select() with the wasm key empty, but inside a conjunction
# (`impeller_enable_opengles && !is_wasm`) a config_setting_group needs a
# setting that *holds* when the OS is another one -- which, the predicates
# being mutually exclusive, is any of the other seven. The converter names
# these for the negated terms of the groups it generates.
_OS_CONSTRAINTS = {
    "android": "@platforms//os:android",
    "fuchsia": "@platforms//os:fuchsia",
    "ios": "@platforms//os:ios",
    "linux": "@platforms//os:linux",
    "mac": "@platforms//os:macos",
    "qnx": "@platforms//os:qnx",
    "wasm": "@platforms//os:emscripten",
    "win": "@platforms//os:windows",
}

[
    selects.config_setting_group(
        name = "not_" + os,
        match_any = [
            constraint
            for other, constraint in _OS_CONSTRAINTS.items()
            if other != os
        ],
    )
    for os in _OS_CONSTRAINTS
]

# The complements of BUILDCONFIG.gn's CPU names (target_cpu, current_cpu),
# the same way: `target_cpu != "x64"` inside a disjunction or conjunction
# (skcms's `target_cpu != "x64" || target_os == "android"`) needs a setting
# that holds when the CPU is another one. The names are GN's.
_CPU_CONSTRAINTS = {
    "arm": "@platforms//cpu:armv7",
    "arm64": "@platforms//cpu:aarch64",
    "mips": "@platforms//cpu:mips64",
    "ppc": "@platforms//cpu:ppc",
    "riscv64": "@platforms//cpu:riscv64",
    "wasm": "@platforms//cpu:wasm32",
    "x64": "@platforms//cpu:x86_64",
    "x86": "@platforms//cpu:x86_32",
}

[
    selects.config_setting_group(
        name = "not_cpu_" + cpu,
        match_any = [
            constraint
            for other, constraint in _CPU_CONSTRAINTS.items()
            if other != cpu
        ],
    )
    for cpu in _CPU_CONSTRAINTS
]

# GN's `current_toolchain == host_toolchain`, which the engine's files test
# for "the host's own build" (testing.gni's enable_unittests, the shell's
# tester, glfw's shell), read in Bazel's terms: the target OS is one a host
# runs and the target CPU is the host's (x64, the converter's host_cpu) --
# a cross-compile for the host's own OS and another CPU, the Linux arm64
# build, is GN's clang_arm64 toolchain and not the host's, so its tests and
# host-only targets drop out as GN's do. The converter names the predicate
# is_host_toolchain (gn_eval's hostToolchainPredicate); the complement is
# the OSes only a target runs, or a CPU other than the host's.
_HOST_OSES = [
    "linux",
    "mac",
    "win",
]

_HOST_CPU = "@platforms//cpu:x86_64"

# The other CPUs the engine builds for (BUILDCONFIG.gn's target_cpu values,
# as the converter's CPU settings spell them).
_OTHER_CPUS = [
    "@platforms//cpu:aarch64",
    "@platforms//cpu:armv7",
    "@platforms//cpu:riscv64",
    "@platforms//cpu:wasm32",
    "@platforms//cpu:x86_32",
]

selects.config_setting_group(
    name = "host_os",
    match_any = [_OS_CONSTRAINTS[os] for os in _HOST_OSES],
)

selects.config_setting_group(
    name = "host_toolchain",
    match_all = [
        ":host_os",
        _HOST_CPU,
    ],
)

selects.config_setting_group(
    name = "not_host_toolchain",
    match_any = [
        constraint
        for os, constraint in _OS_CONSTRAINTS.items()
        if os not in _HOST_OSES
    ] + _OTHER_CPUS,
)

# BUILDCONFIG.gn's use_flutter_cxx, `is_clang && (is_linux || is_android ||
# is_mac || is_ios)`: where the engine builds and links its own libc++
# (toolchains:cxx_runtime selects on it); elsewhere the toolchain's serves.
_FLUTTER_CXX_OSES = [
    "android",
    "ios",
    "linux",
    "mac",
]

selects.config_setting_group(
    name = "flutter_cxx",
    match_any = [_OS_CONSTRAINTS[os] for os in _FLUTTER_CXX_OSES],
)

selects.config_setting_group(
    name = "not_flutter_cxx",
    match_any = [
        constraint
        for os, constraint in _OS_CONSTRAINTS.items()
        if os not in _FLUTTER_CXX_OSES
    ],
)

# GN's is_asan (build/config/sanitizers/sanitizers.gni; tools/gn --asan,
# which Linux's host_debug_unopt test builder passes): AddressSanitizer on
# every compile and link. The toolchain's `asan` feature selects on it
# (toolchains/BUILD.bazel), the wrapped GN builds pass it on as is_asan, and
# the test launchers export CI's sanitizer environment under it
# (sanitizers.bzl). Nothing else: the engine's GN links no sanitizer options
# of its own (//build/config/sanitizers:deps comes only with BUILDCONFIG.gn's
# component() template, which no engine target uses), so the runtime's
# defaults stand there as here, qualified by that environment.
bool_flag(
    name = "asan",
    build_setting_default = False,
)

config_setting(
    name = "asan_enabled",
    flag_values = {":asan": "True"},
)

# GN's enable_lto (tools/gn: on unless --no-lto, and never in an unoptimized
# build): link-time optimization, -flto on every compile and link of an
# optimized build (//build/config/compiler:optimize). The Android AOT
# builders are the ones that build with it; every other Linux builder says
# --no-lto. Off by default, as the developer's configurations have it.
bool_flag(
    name = "lto",
    build_setting_default = False,
)

config_setting(
    name = "lto_enabled",
    flag_values = {":lto": "True"},
)

# tools/gn's stripped_symbols: on unless --no-stripped, which only the
# developer's local_engine.json configurations pass (and off for Android,
# where GN strips elsewhere). GN's Linux toolchains write every executable
# to exe.unstripped/ and `llvm-objcopy --strip-all` it into the build root
# regardless, and do the same for a shared library through lib.unstripped/
# under the argument. The Bazel build's binaries in bazel-bin stay as linked
# -- its tests run them, and GN keeps the unstripped copies to be run under
# a debugger -- and the stripping happens where GN's layout is produced:
# build_directory_aspect (build_directory.bzl) strips what an install or an
# archive ships, executables always and shared libraries under this flag.
bool_flag(
    name = "stripped",
    build_setting_default = True,
)
