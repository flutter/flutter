# ---------------------------------------------------------------------------
# macOS: GN's //build/toolchain/mac:clang_arm64 and clang_x64 (a Mac host;
# tools/gn --mac --mac-cpu <cpu>): the checkout's clang for the Mac
# (@clang_mac_<cpu>), the SDK of its Xcode (@macos_sdk, -isysroot), the
# engine's libc++, `--target=<cpu>-apple-macos -arch <cpu>` and
# -mmacosx-version-min=12.0.0 (cc_toolchain_config.bzl, os = "mac"). A Mac
# of either CPU builds for either; the platforms name the CPU built for.
# Incompatible off macOS (macos_toolchain.bzl).
# ---------------------------------------------------------------------------

runtime_mode_platforms(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

runtime_mode_platforms(
    name = "macos_x64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

macos_clang_toolchain(
    name = "macos_arm64_clang",
    clang = "@clang_mac_arm64",
    exec_cpu = "arm64",
    target_cpu = "arm64",
)

macos_clang_toolchain(
    name = "macos_x64_clang",
    clang = "@clang_mac_x64",
    exec_cpu = "x64",
    target_cpu = "x64",
)

macos_clang_toolchain(
    name = "macos_x64_on_arm64_clang",
    clang = "@clang_mac_arm64",
    exec_cpu = "arm64",
    target_cpu = "x64",
)

macos_clang_toolchain(
    name = "macos_arm64_on_x64_clang",
    clang = "@clang_mac_x64",
    exec_cpu = "x64",
    target_cpu = "arm64",
)

# ---------------------------------------------------------------------------
# iOS: GN's //build/toolchain/mac:ios_clang_arm (a device), ios_clang_arm_sim
# and ios_clang_x64_sim (the simulator; tools/gn --ios [--simulator
# [--simulator-cpu <cpu>]]): the Mac's clang over the iPhoneOS or
# iPhoneSimulator SDK of its Xcode (@macos_sdk's ios_view and
# ios_simulator_view), `--target=<cpu>-apple-darwin -arch <cpu>` and
# -miphoneos-version-min / -mios-simulator-version-min=15.0
# (cc_toolchain_config.bzl, os = "ios"). The platforms name the CPU and the
# environment (build/bazel:ios_environment), which the toolchains resolve
# by; a Mac of either CPU builds for each. Incompatible off macOS
# (macos_toolchain.bzl).
# ---------------------------------------------------------------------------

runtime_mode_platforms(
    name = "ios_arm64",
    constraint_values = [
        "@platforms//os:ios",
