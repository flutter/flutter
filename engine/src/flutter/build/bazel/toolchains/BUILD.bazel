    ar = HOST_CLANG + "//:bin/llvm-ar",
    arch_copts = ANDROID_ARM64_API26_COMPILE_FLAGS,
    arch_linkopts = ANDROID_ARM64_API26_LINK_FLAGS,
    asan = select({
        "//engine/src/flutter/build/bazel:asan_enabled": True,
        "//conditions:default": False,
    }),
    clang = HOST_CLANG + "//:bin/clang",
    clangxx = HOST_CLANG + "//:bin/clang++",
    crt_begin_exe = "@android_tools//:" + ANDROID_ARM64_API26_LIB + "/crtbegin_dynamic.o",
    crt_begin_so = "@android_tools//:" + ANDROID_ARM64_API26_LIB + "/crtbegin_so.o",
    crt_end_exe = "@android_tools//:" + ANDROID_ARM64_API26_LIB + "/crtend_android.o",
    crt_end_so = "@android_tools//:" + ANDROID_ARM64_API26_LIB + "/crtend_so.o",
    cxx_include_markers = CXX_INCLUDE_MARKERS,
    lto = select({
        "//engine/src/flutter/build/bazel:lto_enabled": True,
        "//conditions:default": False,
    }),
    objcopy = HOST_CLANG + "//:bin/llvm-objcopy",
    os = "android",
    resource_include_marker = HOST_CLANG + "//:resource_include_marker",
    runtime_library = "@android_tools//:builtins_arm64_api26",
    strip = HOST_CLANG + "//:bin/llvm-strip",
    sysroot_marker = "@android_tools//:sdk/ndk/28.2.13676358/toolchains/llvm/prebuilt/" + HOST_NDK_PREBUILT + "/sysroot/NOTICE",
    target_compatible_with = _ANDROID,
    target_cpu = "aarch64",
    target_libc = "bionic_26",
    target_system_name = "aarch64-unknown-linux-android",
    thin_lto = select({
        "//engine/src/flutter/build/bazel:thin_lto_enabled": True,
        "//conditions:default": False,
    }),
    toolchain_identifier = "android_arm64_api26_clang",
)

cc_toolchain(
    name = "android_arm64_api26_clang",
    all_files = ":android_arm64_api26_all_files",
    ar_files = HOST_CLANG + "//:ar_files",
    compiler_files = ":android_arm64_compiler_files",
    dwp_files = ":empty",
    linker_files = ":android_arm64_api26_linker_files",
    objcopy_files = HOST_CLANG + "//:objcopy_files",
    strip_files = HOST_CLANG + "//:strip_files",
    supports_param_files = True,
    target_compatible_with = _ANDROID,
    toolchain_config = ":android_arm64_api26_clang_config",
    toolchain_identifier = "android_arm64_api26_clang",
)

# Registered ahead of android_arm64_clang_toolchain (MODULE.bazel), which
# matches the api26 platform too: the first match wins.
toolchain(
    name = "android_arm64_api26_clang_toolchain",
    exec_compatible_with = [
        HOST_OS_CONSTRAINT,
        HOST_CPU_CONSTRAINT,
    ],
    target_compatible_with = [
        "@platforms//os:android",
        "@platforms//cpu:aarch64",
        ":api26",
    ],
    toolchain = ":android_arm64_api26_clang",
