    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# ---------------------------------------------------------------------------
# android-arm64 at API level 26: GN's clang_arm64_apilevel26 toolchain
# (build/toolchain/android/BUILD.gn), which builds one target, the Vulkan
# validation layer (//third_party/vulkan_validation_layers: API 26's
# AHardwareBuffer functions), for the Android embedding's debug jar. The
# android_arm64 toolchain with `--target=aarch64-linux-android26` and the
# API 26 sysroot libraries; its platform carries the api26 constraint, which
# the action that packs the layer sets through a transition on that one
# dependency (gn_action's platform_deps), as GN's `($apilevel26_toolchain)`
# suffix does.
# ---------------------------------------------------------------------------

# The API level a platform targets, where it departs from the default of
# GN's android toolchains for the CPU (24 for arm64).
constraint_setting(
    name = "android_api_level",
    default_constraint_value = ":api_default",
)

constraint_value(
    name = "api_default",
    constraint_setting = ":android_api_level",
)

constraint_value(
    name = "api26",
    constraint_setting = ":android_api_level",
)

runtime_mode_platforms(
    name = "android_arm64_api26",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:aarch64",
        ":api26",
    ],
)

filegroup(
    name = "android_arm64_api26_linker_files",
    srcs = [
        "@android_tools//:libraries_arm64_api26",
        HOST_CLANG + "//:linker_files",
    ],
    target_compatible_with = _ANDROID,
)

filegroup(
    name = "android_arm64_api26_all_files",
    srcs = [
        ":android_arm64_api26_linker_files",
        ":android_arm64_compiler_files",
        HOST_CLANG + "//:all_files",
    ],
    target_compatible_with = _ANDROID,
)

ANDROID_ARM64_API26_LIB = "sdk/ndk/28.2.13676358/toolchains/llvm/prebuilt/" + HOST_NDK_PREBUILT + "/sysroot/usr/lib/aarch64-linux-android/26"

