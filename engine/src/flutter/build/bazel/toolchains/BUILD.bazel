)

runtime_mode_platforms(
    name = "ios_sim_x64",
    constraint_values = [
        "@platforms//os:ios",
        "@platforms//cpu:x86_64",
        "//engine/src/flutter/build/bazel:ios_simulator",
    ],
)

ios_clang_toolchain(
    name = "ios_arm64_clang",
    clang = "@clang_mac_arm64",
    environment = "device",
    exec_cpu = "arm64",
    target_cpu = "arm64",
)

ios_clang_toolchain(
    name = "ios_arm64_on_x64_clang",
    clang = "@clang_mac_x64",
    environment = "device",
    exec_cpu = "x64",
    target_cpu = "arm64",
)

ios_clang_toolchain(
    name = "ios_sim_arm64_clang",
    clang = "@clang_mac_arm64",
    environment = "simulator",
    exec_cpu = "arm64",
    target_cpu = "arm64",
)

ios_clang_toolchain(
    name = "ios_sim_arm64_on_x64_clang",
    clang = "@clang_mac_x64",
    environment = "simulator",
    exec_cpu = "x64",
    target_cpu = "arm64",
)

ios_clang_toolchain(
    name = "ios_sim_x64_clang",
    clang = "@clang_mac_x64",
    environment = "simulator",
    exec_cpu = "x64",
    target_cpu = "x64",
)

ios_clang_toolchain(
    name = "ios_sim_x64_on_arm64_clang",
    clang = "@clang_mac_arm64",
    environment = "simulator",
    exec_cpu = "arm64",
    target_cpu = "x64",
)

