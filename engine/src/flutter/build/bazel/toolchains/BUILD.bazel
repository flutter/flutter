# The engine's hermetic C/C++ toolchains. Each one is the clang package,
# sysroot and C++ standard library that the GN build uses for the same
# platform, registered in the root MODULE.bazel.

load("@host_platform//:host.bzl", "HOST_CLANG", "HOST_CPU_CONSTRAINT", "HOST_NDK_PREBUILT", "HOST_OS_CONSTRAINT")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_toolchain")
load("//build_defs/config:platforms.bzl", "runtime_mode_platforms")
load(
    ":cc_toolchain_config.bzl",
    "ANDROID_ARM64_API26_COMPILE_FLAGS",
    "ANDROID_ARM64_API26_LINK_FLAGS",
    "ANDROID_ARM64_COMPILE_FLAGS",
    "ANDROID_ARM64_LINK_FLAGS",
    "ANDROID_ARM_COMPILE_FLAGS",
    "ANDROID_ARM_LINK_FLAGS",
    "ANDROID_RISCV64_COMPILE_FLAGS",
    "ANDROID_RISCV64_LINK_FLAGS",
    "ANDROID_X64_COMPILE_FLAGS",
    "ANDROID_X64_LINK_FLAGS",
    "CXX_INCLUDE_MARKERS",
    "LINUX_ARM64_COMPILE_FLAGS",
    "LINUX_ARM64_LINK_FLAGS",
    "flutter_cc_toolchain_config",
)
load(":macos_toolchain.bzl", "ios_clang_toolchain", "macos_clang_toolchain")

package(default_visibility = ["//visibility:public"])

# Every target of a Linux or Android toolchain is compatible with that OS
# alone, as the macOS toolchains' are with macOS (macos_toolchain.bzl): a
# wildcard build on another host skips them without fetching the Linux
# clang and the Debian sysroots, which a Mac's checkout has not (DEPS syncs
# them under download_linux_deps). A toolchain's files are configured for
# its target platform when it is used, so the constraint holds there.
_LINUX = ["@platforms//os:linux"]

_ANDROID = ["@platforms//os:android"]

# The C++ standard library GN links into every executable, shared library and
# loadable module (BUILDCONFIG.gn's default deps). The root .bazelrc attaches
# it to every cc_binary and cc_test through --@bazel_tools//tools/cpp:link_extra_libs;
# cc_shared_library targets must list it in their deps. GN builds it from
# source only where use_flutter_cxx holds (BUILDCONFIG.gn: clang on Linux,
# Android, macOS and iOS -- the flutter_cxx group); Fuchsia's binaries take
# their toolchain's libc++ (the Fuchsia clang's runtimes, through
# rules_fuchsia), as the web's take Emscripten's.
cc_library(
    name = "cxx_runtime",
    deps = select({
        "//engine/src/flutter/build/bazel:flutter_cxx": ["@libcxx"],
        "//conditions:default": [],
    }),
)

# ---------------------------------------------------------------------------
# linux-x64
# ---------------------------------------------------------------------------

# The host's own platform, the same constraints as Bazel's host platform
# (@platforms//host on a Linux x64 machine): what the builders'
# configurations name for a host build, in a runtime mode
# (`--platforms=...:linux_x64_release`, build_defs/config/platforms.bzl),
# so that each mode's outputs have a directory of their own
# (bazel-out/linux_x64_release-opt/). A build that names no platform
# (`bazel test //...`) stays on Bazel's host platform, in bazel-out/k8-*/.
runtime_mode_platforms(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# The headers every C++ compile needs because the toolchain replaces the
# standard library include paths (-nostdinc++).
filegroup(
    name = "linux_cxx_headers",
    srcs = [
        "//engine/src/flutter/build/secondary/flutter/third_party/libcxx:config_headers",
        "@libcxx//:headers",
        "@libcxxabi//:headers",
    ],
)

filegroup(
    name = "linux_x64_compiler_files",
    srcs = [
        ":linux_cxx_headers",
        "@clang_linux_x64//:compiler_files",
        "@sysroot_linux_x64//:headers",
    ],
    target_compatible_with = _LINUX,
)

filegroup(
    name = "linux_x64_linker_files",
    srcs = [
        "@clang_linux_x64//:linker_files",
        "@sysroot_linux_x64//:libraries",
    ],
    target_compatible_with = _LINUX,
)

filegroup(
    name = "linux_x64_all_files",
    srcs = [
        ":linux_x64_compiler_files",
        ":linux_x64_linker_files",
        "@clang_linux_x64//:all_files",
    ],
    target_compatible_with = _LINUX,
)

flutter_cc_toolchain_config(
    name = "linux_x64_clang_config",
    ar = "@clang_linux_x64//:bin/llvm-ar",
    # GN's is_asan, as the build-wide flag says.
    asan = select({
        "//engine/src/flutter/build/bazel:asan_enabled": True,
        "//conditions:default": False,
    }),
    clang = "@clang_linux_x64//:bin/clang",
    clangxx = "@clang_linux_x64//:bin/clang++",
    # The C++ standard library's include directories in GN's search order
    # (CXX_INCLUDE_MARKERS, cc_toolchain_config.bzl).
    cxx_include_markers = CXX_INCLUDE_MARKERS,
    lto = select({
        "//engine/src/flutter/build/bazel:lto_enabled": True,
        "//conditions:default": False,
    }),
    objcopy = "@clang_linux_x64//:bin/llvm-objcopy",
    resource_include_marker = "@clang_linux_x64//:resource_include_marker",
    strip = "@clang_linux_x64//:bin/llvm-strip",
    sysroot_marker = "@sysroot_linux_x64//:BUILD.bazel",
    target_compatible_with = _LINUX,
    target_cpu = "k8",
    # The bullseye sysroot's library is glibc 2.31; its features.h is patched
    # by the Chrome sysroot creator to advertise 2.26 (see the smoke test).
    target_libc = "glibc_2.31",
    target_system_name = "x86_64-unknown-linux-gnu",
    thin_lto = select({
        "//engine/src/flutter/build/bazel:thin_lto_enabled": True,
        "//conditions:default": False,
    }),
    toolchain_identifier = "linux_x64_clang",
)

cc_toolchain(
    name = "linux_x64_clang",
    all_files = ":linux_x64_all_files",
    ar_files = "@clang_linux_x64//:ar_files",
    compiler_files = ":linux_x64_compiler_files",
    dwp_files = ":empty",
    linker_files = ":linux_x64_linker_files",
    objcopy_files = "@clang_linux_x64//:objcopy_files",
    strip_files = "@clang_linux_x64//:strip_files",
    supports_param_files = True,
    target_compatible_with = _LINUX,
    toolchain_config = ":linux_x64_clang_config",
    toolchain_identifier = "linux_x64_clang",
)

toolchain(
    name = "linux_x64_clang_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":linux_x64_clang",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

