# ---------------------------------------------------------------------------
# android-arm64: GN's `--android --android-cpu arm64` build (the android
# clang_arm64 toolchain, build/toolchain/android/BUILD.gn): the same clang,
# the NDK's sysroot (@android_tools), `--target=aarch64-linux-android24`,
# and a -nostdlib link that names the sysroot's crt objects and libraries
# and the NDK clang's compiler runtime (cc_toolchain_config.bzl, os =
# "android"). Host tools build in the exec configuration, as the arm64
# cross build's do.
# ---------------------------------------------------------------------------

runtime_mode_platforms(
    name = "android_arm64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:aarch64",
    ],
)

# The compiler's files are the same for every Android ABI (one sysroot, one
# clang); the linker's differ by ABI.
filegroup(
    name = "android_arm64_compiler_files",
    srcs = [
        ":linux_cxx_headers",
        "@android_tools//:sysroot_headers",
        HOST_CLANG + "//:compiler_files",
    ],
    target_compatible_with = _ANDROID,
)

filegroup(
    name = "android_arm64_linker_files",
    srcs = [
        "@android_tools//:libraries_arm64",
        HOST_CLANG + "//:linker_files",
    ],
    target_compatible_with = _ANDROID,
)

filegroup(
    name = "android_arm64_all_files",
    srcs = [
        ":android_arm64_compiler_files",
        ":android_arm64_linker_files",
        HOST_CLANG + "//:all_files",
    ],
    target_compatible_with = _ANDROID,
)

ANDROID_ARM64_LIB = "sdk/ndk/28.2.13676358/toolchains/llvm/prebuilt/" + HOST_NDK_PREBUILT + "/sysroot/usr/lib/aarch64-linux-android/24"

flutter_cc_toolchain_config(
    name = "android_arm64_clang_config",
    ar = HOST_CLANG + "//:bin/llvm-ar",
    arch_copts = ANDROID_ARM64_COMPILE_FLAGS,
    arch_linkopts = ANDROID_ARM64_LINK_FLAGS,
    asan = select({
        "//engine/src/flutter/build/bazel:asan_enabled": True,
        "//conditions:default": False,
    }),
    clang = HOST_CLANG + "//:bin/clang",
    clangxx = HOST_CLANG + "//:bin/clang++",
    crt_begin_exe = "@android_tools//:" + ANDROID_ARM64_LIB + "/crtbegin_dynamic.o",
    crt_begin_so = "@android_tools//:" + ANDROID_ARM64_LIB + "/crtbegin_so.o",
    crt_end_exe = "@android_tools//:" + ANDROID_ARM64_LIB + "/crtend_android.o",
    crt_end_so = "@android_tools//:" + ANDROID_ARM64_LIB + "/crtend_so.o",
    cxx_include_markers = CXX_INCLUDE_MARKERS,
    lto = select({
        "//engine/src/flutter/build/bazel:lto_enabled": True,
        "//conditions:default": False,
    }),
    objcopy = HOST_CLANG + "//:bin/llvm-objcopy",
    os = "android",
    resource_include_marker = HOST_CLANG + "//:resource_include_marker",
    runtime_library = "@android_tools//:builtins_arm64",
    strip = HOST_CLANG + "//:bin/llvm-strip",
    sysroot_marker = "@android_tools//:sdk/ndk/28.2.13676358/toolchains/llvm/prebuilt/" + HOST_NDK_PREBUILT + "/sysroot/NOTICE",
    target_compatible_with = _ANDROID,
    target_cpu = "aarch64",
    target_libc = "bionic_24",
    target_system_name = "aarch64-unknown-linux-android",
    thin_lto = select({
        "//engine/src/flutter/build/bazel:thin_lto_enabled": True,
        "//conditions:default": False,
    }),
    toolchain_identifier = "android_arm64_clang",
)

cc_toolchain(
    name = "android_arm64_clang",
    all_files = ":android_arm64_all_files",
    ar_files = HOST_CLANG + "//:ar_files",
    compiler_files = ":android_arm64_compiler_files",
    dwp_files = ":empty",
    linker_files = ":android_arm64_linker_files",
    objcopy_files = HOST_CLANG + "//:objcopy_files",
    strip_files = HOST_CLANG + "//:strip_files",
    supports_param_files = True,
    target_compatible_with = _ANDROID,
    toolchain_config = ":android_arm64_clang_config",
    toolchain_identifier = "android_arm64_clang",
