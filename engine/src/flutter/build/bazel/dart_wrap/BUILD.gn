# The root target of the Bazel-wrapped GN build of the Dart SDK (see
# BUILD.bazel next to this file). It is not part of the engine's own GN
# build, which never references this directory: gn_build runs GN with
# `--root-target=//flutter/build/bazel/dart_wrap`, so that only this file,
# the Dart targets below and their dependencies are loaded.
#
# The list is every //flutter/third_party/dart target the engine's GN build
# files depend on, besides create_sdk and kernel-service:frontend_server_aot
# (the engine's flutter_frontend_server builds that one only without the
# prebuilt SDK; with it, GN copies the SDK's snapshot, as the Bazel build
# takes it from @dart_sdk_linux_x64). The tools that run at build time --
# gen_snapshot, analyze_snapshot, bootstrap_compile_platform -- are the host
# toolchain's, as //flutter/lib/snapshot names them: in a cross build (the
# Linux arm64 one, target_cpu = "arm64") GN writes them under clang_x64/,
# built for the host and emitting the target's snapshots, while the
# libraries are the target's; in the host's own build the two toolchains
# are one and the outputs sit in the build root. gen_snapshot is also
# built for the target itself: artifacts.zip ships that one (build/archives:
# "a target-platform-specific binary"), the arm64 build's for arm64 hosts.

import("//flutter/third_party/dart/runtime/runtime_args.gni")

group("dart_wrap") {
  deps = [
    "//flutter/third_party/dart/runtime:dart_api",
    "//flutter/third_party/dart/runtime:libdart_aotruntime",
    "//flutter/third_party/dart/runtime:libdart_jit",
    "//flutter/third_party/dart/runtime/bin:common_embedder_dart_io",
    "//flutter/third_party/dart/runtime/bin:elf_loader",
    "//flutter/third_party/dart/runtime/bin:gen_snapshot",
    "//flutter/third_party/dart/runtime/bin:gen_snapshot($host_toolchain)",
    "//flutter/third_party/dart/runtime/bin:native_assets_api",
    "//flutter/third_party/dart/third_party/double-conversion/src:libdouble_conversion",
    "//flutter/third_party/dart/third_party/perfetto:libprotozero",
    "//flutter/third_party/dart/utils:bootstrap_compile_platform.exe($host_toolchain)",
  ]

  # The analyze_snapshot tool is a 64-bit target's (runtime_args.gni): the
  # host toolchain's, which lib/snapshot's generate_snapshot_bins and the
  # Android shell's archive name, and -- where the engine artifacts are
  # built (common/config.gni's build_engine_artifacts: never Android) --
  # the target's own, which the root group lists: an aarch64 binary in the
  # Linux arm64 cross build, the same file as the host's in the host's own.
  if (build_analyze_snapshot) {
    deps += [ "//flutter/third_party/dart/runtime/bin:analyze_snapshot($host_toolchain)" ]
    if (!is_android) {
      deps += [ "//flutter/third_party/dart/runtime/bin:analyze_snapshot" ]
    }
  }
}
