# Stand-in for //flutter/flutter_vma/BUILD.gn inside the wrapped GN build of
# the GPU test backends (../../../BUILD.bazel). ANGLE's allocator wrapper
# (angle_vk_mem_alloc_wrapper) depends on this target because the engine's
# build_overrides/angle.gni names //flutter/flutter_vma as ANGLE's
# VulkanMemoryAllocator; what it takes from it is the include path of
# vk_mem_alloc.h and of the Vulkan headers, which the real target hands on
# through these same public_deps. The real target's own objects (the
# allocator's implementation, on fml) are not built here: the facade for
# ANGLE depends on //engine/src/flutter/flutter_vma, Bazel's build of them.
# The shared libraries the wrap links itself (ANGLE's libGLESv2.dylib on a
# Mac) need a definition of vma* all the same: flutter_vma.cc beside this
# file is the allocator's implementation without fml, which the archive
# boundary on this target keeps out of libangle.a.

source_set("flutter_vma") {
  sources = [ "flutter_vma.cc" ]
  public_deps = [
    "//flutter/third_party/vulkan-deps/vulkan-headers/src:vulkan_headers",
    "//flutter/third_party/vulkan_memory_allocator",
  ]
}
