# The stand-in GN files of the wrapped build of the GPU test backends
# (../BUILD.bazel), laid out as they sit under the GN source root: a
# package of its own so that the files are relative to this directory and
# the wrap can map it onto the root.

filegroup(
    name = "stubs",
    srcs = glob([
        "**/BUILD.gn",
        "**/*.cc",
    ]),
    visibility = ["//engine/src/flutter/build/bazel/gl_wrap:__pkg__"],
)
