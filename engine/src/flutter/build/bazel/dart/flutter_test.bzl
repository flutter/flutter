"""A framework test (`flutter test`'s kind) compiled by Bazel and run on flutter_tester.

`flutter test` compiles each test file with the frontend server behind a
generated bootstrap and runs it on flutter_tester, hosting package:test's
runner itself (packages/flutter_tools/lib/src/test/). flutter_test does
the same without flutter_tools: the bootstrap is written here, the compile
is a Bazel action (kernel.bzl's, against the engine's platform kernel and a
package configuration over the repository's pub packages -- pub.bzl), and
the run is the Bazel-built flutter_tester with `flutter test`'s flags and
environment, the package's asset directory among them (flutter_assets.bzl).

The bootstrap imports the test file and the directory's
flutter_test_config.dart (as `flutter test` does: the framework's configures
goldens and leak tracking around every test), sets the golden comparator to
the test's directory, and runs the test's main through package:test's
engine in the process (test_core's direct runner, the mode of `dart
some_test.dart`, with stack traces chained as `flutter test` has them):
results on stdout, exit status 1 on a failure. One flutter_tester per
test file, from the package's directory,
as `flutter test` runs them. The runner process that hosts package:test's
protocol (per-test-case results, --name filters, test_core's shards) is the
next step; see research/15.

Sources are compiled under the virtual root kernel.bzl describes
(org-dartlang-root:///<path from the execution root>), so the kernel is the
same on every machine; the golden comparator gets the test's path in the
runfiles tree, which is where its goldens are.

A compile of one test is a compile of the whole framework (13 s alone,
50 s with 24 in parallel). flutter_test_prelude compiles the libraries the
tests share -- package:flutter's, flutter_test, the runner, the test
configuration -- once, and a test's compile starts from that kernel
(`--incremental --initialize-from-dill`, the frontend server reusing every
library of the prelude): 3 s. Such a kernel carries no platform libraries,
as flutter_tools' do not, and flutter_tester supplies them.
"""

load("@bazel_skylib//lib:paths.bzl", "paths")
load("//engine/src/flutter/build/bazel/dart:flutter_assets.bzl", "FlutterTestAssetsInfo")
load(
    "//engine/src/flutter/build/bazel/dart:kernel.bzl",
    "KERNEL_TOOL_ATTRS",
    "SOURCE_URI_SCHEME",
    "compile_to_kernel",
)
load("//engine/src/flutter/build/bazel/dart:pub.bzl", "PubPackageConfigInfo")

def _bootstrap(ctx, test_uri):
    test = ctx.file.test
    test_config = ctx.file.test_config
    lines = [
        "// Generated by flutter_test (engine/src/flutter/build/bazel/dart/flutter_test.bzl):",
        "// %s on flutter_tester, through package:test's engine, as `flutter test` runs it." % test.short_path,
        "import 'dart:async';",
        "import 'dart:io';",
        "import 'dart:isolate';",
        "",
        "import 'package:flutter_test/flutter_test.dart';",
        "import 'package:path/path.dart' as p;",
        "import 'package:test_api/backend.dart' show Metadata, Runtime, SuitePlatform;",
        "import 'package:test_api/src/backend/declarer.dart';",
        "import 'package:test_api/src/backend/invoker.dart';",
        "import 'package:test_core/src/runner/engine.dart';",
        "import 'package:test_core/src/runner/plugin/environment.dart';",
        "import 'package:test_core/src/runner/reporter/direct.dart';",
        "import 'package:test_core/src/runner/runner_suite.dart';",
        "import 'package:test_core/src/runner/suite.dart';",
        "import 'package:test_core/src/util/os.dart';",
        "",
        "import '%s:///%s' as test;" % (SOURCE_URI_SCHEME, test.path),
    ]
    if test_config != None:
        lines.append("import '%s:///%s' as test_config;" % (SOURCE_URI_SCHEME, test_config.path))
    lines += [
        "",
        "// test_core's direct runner (direct_run.dart) with stack traces",
        "// chained, as `flutter test` runs the runner (--chain-stack-traces).",
        "// A file that declares no test passes with a note, as it does among",
        "// a directory's under `flutter test` (painting/network_image_web_test",
        "// has nothing to do on the VM); the ReceivePort below is what keeps",
        "// an isolate from quitting before its main declared the tests.",
        "Future<bool> runTests(FutureOr<void> Function() testMain) async {",
        "  final declarer = Declarer(metadata: Metadata(chainStackTraces: true));",
        "  await declarer.declare(testMain);",
        "  final suite = RunnerSuite(",
        "    const PluginEnvironment(),",
        "    SuiteConfiguration.empty,",
        "    declarer.build(),",
        "    SuitePlatform(Runtime.vm, compiler: null, os: currentOSGuess),",
        "    path: p.prettyUri(Uri.base),",
        "  );",
        "  final engine = Engine()",
        "    ..suiteSink.add(suite)",
        "    ..suiteSink.close();",
        "  createDirectReporter(engine);",
        "  final success =",
        "      await runZoned(() => Invoker.guard(engine.run), zoneValues: {#test.declarer: declarer}) ??",
        "      false;",
        "  if (engine.liveTests.isEmpty) {",
        "    print('No tests were declared by %s.');" % test.short_path,
        "  }",
        "  return success;",
        "}",
        "",
        "Future<void> main() async {",
        "  // Keep the isolate alive while the tests run: flutter_tester quits once",
        "  // the isolate has no open port and no pending timer, and an engine",
        "  // operation in flight -- the image decode a test file's main awaits",
        "  // before declaring its tests -- is neither. `flutter test`'s harness",
        "  // holds a WebSocket to the runner for the whole run.",
        "  final ReceivePort keepAlive = ReceivePort();",
        "  // The test's directory, where its goldens are, relative to the working",
        "  // directory (the package's, as under `flutter test`).",
        "  goldenFileComparator = LocalFileComparator(Uri.base.resolve('%s'));" % test_uri,
        "  final bool success = await runTests(",
    ]
    if test_config != None:
        lines.append("    () => test_config.testExecutable(test.main),")
    else:
        lines.append("    test.main,")
    lines += [
        "  );",
        "  // The reporter's last line (\"All tests passed!\") follows the runner's",
        "  // completion through futures of its own; let the event loop drain",
        "  // before exiting, or a short file's only line is lost.",
        "  await Future<void>.delayed(Duration.zero);",
        "  keepAlive.close();",
        "  exit(success ? 0 : 1);",
        "}",
        "",
    ]
    bootstrap = ctx.actions.declare_file(ctx.label.name + ".bootstrap.dart")
    ctx.actions.write(bootstrap, "\n".join(lines))
    return bootstrap

# The fontconfig flutter_tester reads under FONTCONFIG_FILE: no system fonts
# (the test font is the engine's own, --use-test-fonts), a cache directory
# of the test's own.
_FONTS_CONF = """<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <cachedir>fontconfig-cache</cachedir>
</fontconfig>
"""

# flutter test's compile (packages/flutter_tools/lib/src/compile.dart): the
# debug mode's defines, and the creation-location tracking the inspector's
# tests check for (`flutter test` tracks unless told
# --no-track-widget-creation; 65 of widget_inspector_test's are skipped
# without it). The prelude and the tests compile alike, so that the tests
# can start from the prelude.
_COMPILE_ARGS = [
    "-Ddart.vm.profile=false",
    "-Ddart.vm.product=false",
    "--track-creation-locations",
    # `flutter test` defines the SDK's version for FlutterVersion
    # (build_info.dart's kDartDefines) from git -- the tag, the revision, the
    # channel. Under Bazel they are fixed words, so that a kernel is the same
    # on every commit and the cache holds across them; the tests that read
    # them compare them with their own String.fromEnvironment.
    "-DFLUTTER_VERSION=bazel",
    "-DFLUTTER_CHANNEL=bazel",
    "-DFLUTTER_GIT_URL=https://github.com/flutter/flutter.git",
    "-DFLUTTER_FRAMEWORK_REVISION=bazel",
    "-DFLUTTER_ENGINE_REVISION=bazel",
    "-DFLUTTER_DART_VERSION=bazel",
]

FlutterTestPreludeInfo = provider(
    doc = "A kernel of the libraries the tests share, for their compiles to start from.",
    fields = {"kernel": "File: the prelude's kernel."},
)

def _flutter_test_prelude_impl(ctx):
    test_config = ctx.file.test_config
    main = ctx.actions.declare_file(ctx.label.name + ".prelude.dart")
    lines = [
        "// Generated by flutter_test_prelude (engine/src/flutter/build/bazel/dart/flutter_test.bzl):",
        "// the libraries the tests share, compiled once.",
    ] + ["import '%s';" % uri for uri in ctx.attr.imports]
    if test_config != None:
        lines.append("import '%s:///%s';" % (SOURCE_URI_SCHEME, test_config.path))
    lines += ["", "void main() {}", ""]
    ctx.actions.write(main, "\n".join(lines))
    kernel = ctx.actions.declare_file(ctx.label.name + ".dill")
    compile_to_kernel(
        ctx,
        main = main,
        out = kernel,
        srcs = depset(
            ([test_config] if test_config else []) + ctx.files.srcs,
            transitive = [ctx.attr.package_config[PubPackageConfigInfo].sources] +
                         [dep[DefaultInfo].files for dep in ctx.attr.deps],
        ),
        package_config = ctx.file.package_config,
        platform = ctx.files.platform,
        args = _COMPILE_ARGS + ctx.attr.compile_args,
    )
    return [
        DefaultInfo(files = depset([kernel])),
        FlutterTestPreludeInfo(kernel = kernel),
    ]

flutter_test_prelude = rule(
    implementation = _flutter_test_prelude_impl,
    doc = "The libraries a directory's tests share, compiled once for their compiles to start from.",
    attrs = {
        "imports": attr.string_list(
            mandatory = True,
            doc = "The libraries, as the tests import them (`package:flutter/material.dart`).",
        ),
        "test_config": attr.label(
            allow_single_file = [".dart"],
            doc = "The tests' flutter_test_config.dart, imported too.",
        ),
        "srcs": attr.label_list(
            allow_files = True,
            doc = "Other files the imports reach.",
        ),
        "deps": attr.label_list(
            allow_files = True,
            doc = "Other files the compile may read besides the configuration's packages.",
        ),
        "compile_args": attr.string_list(
            doc = "Further frontend server arguments, the same as the tests'.",
        ),
        "package_config": attr.label(
            allow_single_file = True,
            mandatory = True,
            providers = [PubPackageConfigInfo],
            doc = "The package configuration for the compile (pub_package_config, execroot layout).",
        ),
        "platform": attr.label(
            default = "//engine/src/flutter/lib/snapshot:strong_platform",
            allow_files = True,
            doc = "The platform kernel's directory contents (flutter_patched_sdk).",
        ),
    } | KERNEL_TOOL_ATTRS,
)

def _flutter_test_impl(ctx):
    # The working directory: the package's, as `flutter test` runs tests from
    # the project directory (tests read `pubspec.yaml`, `test/...` relative
    # to it); FLUTTER_ROOT stays the runfiles tree's root.
    package_directory = ctx.file.pubspec.dirname
    test_path = ctx.file.test.short_path
    if not test_path.startswith(package_directory + "/"):
        fail("%s: the test %s is not under the package of %s" % (ctx.label, test_path, ctx.file.pubspec.short_path))
    bootstrap = _bootstrap(ctx, test_path[len(package_directory) + 1:])
    kernel = ctx.actions.declare_file(ctx.label.name + ".dill")
    prelude = ctx.attr.prelude[FlutterTestPreludeInfo].kernel if ctx.attr.prelude else None
    compile_to_kernel(
        ctx,
        main = bootstrap,
        out = kernel,
        srcs = depset(
            [ctx.file.test] + ([ctx.file.test_config] if ctx.file.test_config else []) + ctx.files.srcs,
            # The packages of the configuration (pub_package_config provides
            # their files) and whatever else deps name.
            transitive = [ctx.attr.package_config[PubPackageConfigInfo].sources] +
                         [dep[DefaultInfo].files for dep in ctx.attr.deps],
        ),
        package_config = ctx.file.package_config,
        platform = ctx.files.platform,
        args = _COMPILE_ARGS + ctx.attr.compile_args + (
            # Start from the prelude's kernel: the frontend server's
            # incremental mode, initialized from it, reuses its libraries.
            ["--incremental", "--initialize-from-dill", prelude.path] if prelude else []
        ),
        extra_inputs = [prelude] if prelude else [],
    )

    fonts_conf = ctx.actions.declare_file(ctx.label.name + ".fonts.conf")
    ctx.actions.write(fonts_conf, _FONTS_CONF)

    # The launcher: flutter_tester as flutter_tester_device.dart starts it,
    # from the runfiles tree's root. FLUTTER_ROOT is the tree's root too: the
    # repository's layout, where flutter_goldens (the framework's test
    # configuration) places a test's goldens directory relative to the root
    # and writes under bin/cache/pkg/skia_goldens.
    # The asset directory goes to flutter_tester (--flutter-assets-dir, the
    # engine's asset manager: FragmentProgram.fromAsset reads the shaders
    # there) and to the test (UNIT_TEST_ASSETS with APP_NAME: flutter_test
    # answers the flutter/assets channel from the directory itself, and
    # package:flutter's asset bundle takes the channel in that case --
    # mockFlutterAssets in flutter_test's _binding_io.dart,
    # PlatformAssetBundle.loadBuffer).
    assets = ctx.attr.assets
    assets_flag = ""
    assets_env = ""
    if assets != None:
        assets_dir = "$root/" + assets[FlutterTestAssetsInfo].asset_manifest.short_path.rsplit("/", 1)[0]
        assets_flag = "  --flutter-assets-dir=\"%s\" \\\n" % assets_dir
        assets_env = "export UNIT_TEST_ASSETS=\"%s\"\n" % assets_dir
    launcher = ctx.actions.declare_file(ctx.label.name + ".launcher.sh")
    ctx.actions.write(
        output = launcher,
        content = """#!/bin/bash
set -euo pipefail
root="$PWD"
export FLUTTER_TEST=true
export FLUTTER_ROOT="$root"
export APP_NAME="{app_name}"
{assets_env}export FONTCONFIG_FILE="$root/{fonts_conf}"
cd "{package_directory}"
mkdir -p fontconfig-cache
exec "$root/{flutter_tester}" \\
  {vm_service_flag} \\
  --icu-data-file-path="$root/{icudtl}" \\
  --enable-checked-mode \\
  --verify-entry-points \\
  --enable-software-rendering \\
  --skia-deterministic-rendering \\
  --non-interactive \\
  --use-test-fonts \\
  --disable-asset-fonts \\
{assets_flag}  --packages="$root/{package_config}" \\
  "$root/{kernel}" "$@"
""".format(
            app_name = ctx.attr.app_name,
            assets_env = assets_env,
            # `flutter test --enable-vmservice` asks for a port (any); the
            # default disables the service.
            vm_service_flag = "--vm-service-port=0" if ctx.attr.vm_service else "--disable-vm-service",
            fonts_conf = fonts_conf.short_path,
            package_directory = package_directory,
            flutter_tester = ctx.executable.flutter_tester.short_path,
            icudtl = ctx.file.icudtl.short_path,
            assets_flag = assets_flag,
            package_config = ctx.file.runtime_package_config.short_path,
            kernel = kernel.short_path,
        ),
        is_executable = True,
    )

    # The SDK cache's paths under FLUTTER_ROOT/bin/cache: each target's files
    # at their paths within their repository, under the directory named.
    cache = {}
    for target, directory in ctx.attr.cache.items():
        for file in target[DefaultInfo].files.to_list():
            path = file.short_path
            if path.startswith("../"):
                path = path.split("/", 2)[2]
            cache[paths.join("bin/cache", directory, path)] = file
    runfiles = ctx.runfiles(
        files = [kernel, fonts_conf, ctx.file.icudtl, ctx.file.runtime_package_config, ctx.file.test, ctx.file.pubspec] + ctx.files.data,
        transitive_files = assets[DefaultInfo].files if assets != None else None,
        symlinks = cache,
    ).merge(ctx.attr.flutter_tester[DefaultInfo].default_runfiles)
    for dep in ctx.attr.data:
        runfiles = runfiles.merge(dep[DefaultInfo].default_runfiles)
    return [DefaultInfo(executable = launcher, runfiles = runfiles)]

flutter_test = rule(
    implementation = _flutter_test_impl,
    test = True,
    doc = "A framework test file compiled by the frontend server and run on flutter_tester, as `flutter test` runs it.",
    attrs = {
        "test": attr.label(
            allow_single_file = [".dart"],
            mandatory = True,
            doc = "The test file.",
        ),
        "test_config": attr.label(
            allow_single_file = [".dart"],
            doc = "The flutter_test_config.dart whose testExecutable() wraps the test (the nearest one " +
                  "above the test file, as flutter test finds it).",
        ),
        "srcs": attr.label_list(
            allow_files = True,
            doc = "Other files of the test's directory it imports (helpers beside it).",
        ),
        "deps": attr.label_list(
            allow_files = True,
            doc = "Other files the compile may read besides the configuration's packages: the " +
                  "test directory tree's shared helpers (the test configuration's imports).",
        ),
        "data": attr.label_list(
            allow_files = True,
            doc = "What the test reads at run time (goldens, fixtures).",
        ),
        "app_name": attr.string(
            mandatory = True,
            doc = "The name of the package under test (its pubspec's), APP_NAME in the test's " +
                  "environment: the `packages/<name>/` prefix flutter_test strips from an asset key.",
        ),
        "pubspec": attr.label(
            allow_single_file = ["pubspec.yaml"],
            mandatory = True,
            doc = "The package's pubspec.yaml; the test runs from its directory, as `flutter test` " +
                  "runs from the project's.",
        ),
        "cache": attr.label_keyed_string_dict(
            allow_files = True,
            doc = "What the test reads of the Flutter SDK's cache (FLUTTER_ROOT/bin/cache): each " +
                  "target's files, at their paths within their repository, under the directory " +
