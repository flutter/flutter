"""A framework test (`flutter test`'s kind) compiled by Bazel and run on flutter_tester.

`flutter test` compiles each test file with the frontend server behind a
generated bootstrap and runs it on flutter_tester, hosting package:test's
runner itself (packages/flutter_tools/lib/src/test/). flutter_test does
the same without flutter_tools: the bootstrap is written here, the compile
is a Bazel action (kernel.bzl's, against the engine's platform kernel and a
package configuration over the repository's pub packages -- pub.bzl), and
the run is the Bazel-built flutter_tester with `flutter test`'s flags and
environment, the package's asset directory among them (flutter_assets.bzl).

The bootstrap imports the test file and the directory's
flutter_test_config.dart (as `flutter test` does: the framework's configures
goldens and leak tracking around every test), sets the golden comparator to
the test's directory, and runs the test's main through package:test's
direct runner (test_core's directRunTests, the mode of `dart some_test.dart`):
results on stdout, exit status 1 on a failure. One flutter_tester per test
file, as `flutter test` runs them. The runner process that hosts
package:test's protocol (per-test-case results, --name filters, test_core's
shards) is the next step; see research/15.

Sources are compiled under the virtual root kernel.bzl describes
(org-dartlang-root:///<path from the execution root>), so the kernel is the
same on every machine; the golden comparator gets the test's path in the
runfiles tree, which is where its goldens are.
"""

load("//engine/src/flutter/build/bazel/dart:flutter_assets.bzl", "FlutterTestAssetsInfo")
load(
    "//engine/src/flutter/build/bazel/dart:kernel.bzl",
    "KERNEL_TOOL_ATTRS",
    "SOURCE_URI_SCHEME",
    "compile_to_kernel",
)
load("//engine/src/flutter/build/bazel/dart:pub.bzl", "PubPackageConfigInfo")

def _bootstrap(ctx):
    test = ctx.file.test
    test_config = ctx.file.test_config
    lines = [
        "// Generated by flutter_test (engine/src/flutter/build/bazel/dart/flutter_test.bzl):",
        "// %s on flutter_tester, through package:test's direct runner." % test.short_path,
        "import 'dart:io';",
        "import 'dart:isolate';",
        "",
        "import 'package:flutter_test/flutter_test.dart';",
        "import 'package:test_core/src/direct_run.dart';",
        "",
        "import '%s:///%s' as test;" % (SOURCE_URI_SCHEME, test.path),
    ]
    if test_config != None:
        lines.append("import '%s:///%s' as test_config;" % (SOURCE_URI_SCHEME, test_config.path))
    lines += [
        "",
        "Future<void> main() async {",
        "  // Keep the isolate alive while the tests run: flutter_tester quits once",
        "  // the isolate has no open port and no pending timer, and an engine",
        "  // operation in flight -- the image decode a test file's main awaits",
        "  // before declaring its tests -- is neither. `flutter test`'s harness",
        "  // holds a WebSocket to the runner for the whole run.",
        "  final ReceivePort keepAlive = ReceivePort();",
        "  // The test's directory in the runfiles tree, where its goldens are;",
        "  // the working directory is the tree's root.",
        "  goldenFileComparator = LocalFileComparator(Uri.base.resolve('%s'));" % test.short_path,
        "  final bool success = await directRunTests(",
    ]
    if test_config != None:
        lines.append("    () => test_config.testExecutable(test.main),")
    else:
        lines.append("    test.main,")
    lines += [
        "  );",
        "  // The reporter's last line (\"All tests passed!\") follows the runner's",
        "  // completion through futures of its own; let the event loop drain",
        "  // before exiting, or a short file's only line is lost.",
        "  await Future<void>.delayed(Duration.zero);",
        "  keepAlive.close();",
        "  exit(success ? 0 : 1);",
        "}",
        "",
    ]
    bootstrap = ctx.actions.declare_file(ctx.label.name + ".bootstrap.dart")
    ctx.actions.write(bootstrap, "\n".join(lines))
    return bootstrap

# The fontconfig flutter_tester reads under FONTCONFIG_FILE: no system fonts
# (the test font is the engine's own, --use-test-fonts), a cache directory
# of the test's own.
_FONTS_CONF = """<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <cachedir>fontconfig-cache</cachedir>
</fontconfig>
"""

def _flutter_test_impl(ctx):
    bootstrap = _bootstrap(ctx)
    kernel = ctx.actions.declare_file(ctx.label.name + ".dill")
    compile_to_kernel(
        ctx,
        main = bootstrap,
        out = kernel,
        srcs = depset(
            [ctx.file.test] + ([ctx.file.test_config] if ctx.file.test_config else []) + ctx.files.srcs,
            # The packages of the configuration (pub_package_config provides
            # their files) and whatever else deps name.
            transitive = [ctx.attr.package_config[PubPackageConfigInfo].sources] +
                         [dep[DefaultInfo].files for dep in ctx.attr.deps],
        ),
        package_config = ctx.file.package_config,
        platform = ctx.files.platform,
        # flutter test's compile (packages/flutter_tools/lib/src/compile.dart):
        # the debug mode's defines, and the creation-location tracking the
        # inspector's tests check for (`flutter test` tracks unless told
        # --no-track-widget-creation; 65 of widget_inspector_test's are
        # skipped without it).
        args = [
            "-Ddart.vm.profile=false",
            "-Ddart.vm.product=false",
            "--track-creation-locations",
        ] + ctx.attr.compile_args,
    )

    fonts_conf = ctx.actions.declare_file(ctx.label.name + ".fonts.conf")
    ctx.actions.write(fonts_conf, _FONTS_CONF)

    # The launcher: flutter_tester as flutter_tester_device.dart starts it,
    # from the runfiles tree's root. FLUTTER_ROOT is the tree's root too: the
    # repository's layout, where flutter_goldens (the framework's test
    # configuration) places a test's goldens directory relative to the root
    # and writes under bin/cache/pkg/skia_goldens.
    # The asset directory goes to flutter_tester (--flutter-assets-dir, the
    # engine's asset manager: FragmentProgram.fromAsset reads the shaders
    # there) and to the test (UNIT_TEST_ASSETS with APP_NAME: flutter_test
    # answers the flutter/assets channel from the directory itself, and
    # package:flutter's asset bundle takes the channel in that case --
    # mockFlutterAssets in flutter_test's _binding_io.dart,
    # PlatformAssetBundle.loadBuffer).
    assets = ctx.attr.assets
    assets_flag = ""
    assets_env = ""
    if assets != None:
        assets_dir = "$PWD/" + assets[FlutterTestAssetsInfo].asset_manifest.short_path.rsplit("/", 1)[0]
        assets_flag = "  --flutter-assets-dir=\"%s\" \\\n" % assets_dir
        assets_env = "export UNIT_TEST_ASSETS=\"%s\"\n" % assets_dir
    launcher = ctx.actions.declare_file(ctx.label.name + ".launcher.sh")
    ctx.actions.write(
        output = launcher,
        content = """#!/bin/bash
set -euo pipefail
export FLUTTER_TEST=true
export FLUTTER_ROOT="$PWD"
export APP_NAME="{app_name}"
{assets_env}export FONTCONFIG_FILE="$PWD/{fonts_conf}"
mkdir -p fontconfig-cache
exec "{flutter_tester}" \\
  --disable-vm-service \\
  --icu-data-file-path="{icudtl}" \\
  --enable-checked-mode \\
  --verify-entry-points \\
  --enable-software-rendering \\
  --skia-deterministic-rendering \\
  --non-interactive \\
  --use-test-fonts \\
  --disable-asset-fonts \\
{assets_flag}  --packages="{package_config}" \\
  "{kernel}" "$@"
""".format(
            app_name = ctx.attr.app_name,
            assets_env = assets_env,
            fonts_conf = fonts_conf.short_path,
            flutter_tester = ctx.executable.flutter_tester.short_path,
            icudtl = ctx.file.icudtl.short_path,
            assets_flag = assets_flag,
            package_config = ctx.file.runtime_package_config.short_path,
            kernel = kernel.short_path,
        ),
        is_executable = True,
    )
    runfiles = ctx.runfiles(
        files = [kernel, fonts_conf, ctx.file.icudtl, ctx.file.runtime_package_config, ctx.file.test] + ctx.files.data,
        transitive_files = assets[DefaultInfo].files if assets != None else None,
    ).merge(ctx.attr.flutter_tester[DefaultInfo].default_runfiles)
    for dep in ctx.attr.data:
        runfiles = runfiles.merge(dep[DefaultInfo].default_runfiles)
    return [DefaultInfo(executable = launcher, runfiles = runfiles)]

flutter_test = rule(
    implementation = _flutter_test_impl,
    test = True,
    doc = "A framework test file compiled by the frontend server and run on flutter_tester, as `flutter test` runs it.",
    attrs = {
        "test": attr.label(
            allow_single_file = [".dart"],
            mandatory = True,
            doc = "The test file.",
        ),
        "test_config": attr.label(
            allow_single_file = [".dart"],
            doc = "The flutter_test_config.dart whose testExecutable() wraps the test (the nearest one " +
                  "above the test file, as flutter test finds it).",
        ),
        "srcs": attr.label_list(
            allow_files = True,
            doc = "Other files of the test's directory it imports (helpers beside it).",
        ),
        "deps": attr.label_list(
            allow_files = True,
            doc = "Other files the compile may read besides the configuration's packages: the " +
                  "test directory tree's shared helpers (the test configuration's imports).",
        ),
        "data": attr.label_list(
            allow_files = True,
            doc = "What the test reads at run time (goldens, fixtures).",
        ),
        "app_name": attr.string(
            mandatory = True,
            doc = "The name of the package under test (its pubspec's), APP_NAME in the test's " +
                  "environment: the `packages/<name>/` prefix flutter_test strips from an asset key.",
        ),
        "assets": attr.label(
            providers = [FlutterTestAssetsInfo],
            doc = "The package's test asset directory (flutter_test_assets), flutter_tester's " +
                  "--flutter-assets-dir; none when the package's tests load no asset.",
        ),
        "compile_args": attr.string_list(
            doc = "Further frontend server arguments for the compile (`args` and `env` are the test's own, " +
                  "as on every test rule: flutter_tester's further arguments and the run's environment).",
        ),
        "package_config": attr.label(
            allow_single_file = True,
            mandatory = True,
            providers = [PubPackageConfigInfo],
            doc = "The package configuration for the compile (pub_package_config, execroot layout), " +
                  "whose packages' files the compile reads.",
        ),
        "runtime_package_config": attr.label(
            allow_single_file = True,
            mandatory = True,
            doc = "The package configuration for the run (pub_package_config, runfiles layout).",
        ),
        "platform": attr.label(
            default = "//engine/src/flutter/lib/snapshot:strong_platform",
            allow_files = True,
            doc = "The platform kernel's directory contents (flutter_patched_sdk).",
        ),
        "flutter_tester": attr.label(
            default = "//engine/src/flutter/shell/testing:flutter_tester",
            executable = True,
            cfg = "target",
            doc = "The flutter_tester to run on.",
        ),
        "icudtl": attr.label(
            default = "@icu//:icudata",
            allow_single_file = True,
            doc = "ICU's data file.",
        ),
    } | KERNEL_TOOL_ATTRS,
)

def flutter_tests(name, tests, size = "medium", tags = [], network = False, **kwargs):
    """One flutter_test per test file, and a test_suite of them.

    Args:
      name: the suite's name.
      tests: the test files (a glob of `*_test.dart`).
      size: each test's size; medium by default (`flutter test`'s per-file
        runs take seconds to a minute).
      tags: each test's tags.
      network: whether the tests may reach the network. Off by default
        (`block-network`): flutter_goldens then skips the golden
        comparisons instead of fetching Skia Gold's expectations, as it
        does wherever Gold is unreachable -- `flutter test` on a developer
        machine compares against Gold, and one query in 390 files failed
        with Gold's "Could not complete query" (NEED_DECISION D14, 7).
      **kwargs: flutter_test's attributes, the same for every file (app_name,
        test_config, deps, data, assets, package_config,
        runtime_package_config).
    """
    test_tags = list(tags) + ([] if network else ["block-network"])
    targets = []
    for test in tests:
        test_name = test.removesuffix(".dart").replace("/", "_")
        flutter_test(
            name = test_name,
            test = test,
            size = size,
            tags = test_tags,
            **kwargs
        )
        targets.append(":" + test_name)
    native.test_suite(name = name, tests = targets, tags = tags)
