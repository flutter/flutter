# Root BUILD file of @dart: the Dart SDK sources pinned in DEPS.
#
# The VM, gen_snapshot and the other Dart targets the engine depends on are
# not built from these sources by Bazel rules; the engine's GN build of them
# is wrapped as one action instead (see ../../dart_wrap). This file therefore
# exposes the embedding API headers, which the engine compiles against
# directly, `build_tree`, the inputs of that wrapped build, and what the
# engine's own snapshot pipeline (//flutter/lib/snapshot) reads from the tree:
# the core library sources and the bin_to_assembly script.

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The C API an embedder compiles against: the headers of
# //third_party/dart/runtime:dart_api (runtime/BUILD.gn) plus the bin/ ones
# the engine's dart:io glue includes. The engine includes them as
# "third_party/dart/runtime/include/<name>.h", which GN resolves through the
# engine root include directory; include_prefix reproduces that path here so
# no source has to change. Header-only: dart_api_dl.c belongs to the embedder
# that uses the dynamic linking API, not here.
cc_library(
    name = "dart_api_headers",
    hdrs = glob(["runtime/include/**/*.h"]),
    include_prefix = "third_party/dart",
    # dart_public_config's include_dirs (runtime/ and runtime/include/): a few
    # sources include "dart_api.h" bare (lib/ui's scene_builder.cc).
    includes = [
        "runtime",
        "runtime/include",
    ],
)

# runtime/BUILD.gn's config("dart_config"), which the engine's dart:io glue
# (//flutter/lib/io) lists privately: the defines it resolves to under every
# host configuration tools/gn writes (dart_debug is false unless --dart-debug
# is given; SUPPORT_PERFETTO and EXPERIMENTAL_VM_SERVICE are the Dart
# arguments' defaults). Its compiler flags cannot ride a dependency; the
# converter inlines them from its mapping (ConfigDependency.copts).
cc_library(
    name = "dart_config",
    defines = [
        "NDEBUG",
        "SUPPORT_PERFETTO",
        "EXPERIMENTAL_VM_SERVICE",
    ],
    deps = [":dart_api_headers"],
)

# The embedder-side headers of runtime/bin that the engine includes
# (elf_loader.h, io_natives.h, platform.h), with the bin/ and platform/
# headers they include among themselves relative to runtime/ (hence
# `includes`). The code behind them is in the archives of
# //engine/src/flutter/build/bazel/dart_wrap.
cc_library(
    name = "runtime_bin_headers",
    hdrs = glob([
        "runtime/bin/*.h",
        "runtime/platform/*.h",
    ]),
    include_prefix = "third_party/dart",
    includes = ["runtime"],
    deps = [":dart_api_headers"],
)

# The core libraries (dart:core, dart:async, ..., with the VM's patches) and
# their libraries.json: what compile_platform reads, through the engine's
# lib/snapshot/libraries.json, to build the platform kernel. GN tracks these
# through the compiler's depfile; a sandboxed action declares them.
filegroup(
    name = "sdk_lib",
    srcs = glob(["sdk/lib/**"]),
)

# The script GN's bin_to_assembly template runs (//flutter/build/bin_to_obj.gni).
exports_files(["runtime/tools/bin_to_assembly.py"])

# ANGLE's gni imports this one file of the Dart tree (through
# build_overrides/angle.gni's angle_has_build); for the wrapped GN build of
# the GPU test backends.
filegroup(
    name = "gclient_args",
    srcs = ["build/config/gclient_args.gni"],
)

# Everything the engine's GN build of the Dart SDK targets reads, as measured
# on the build graph of those targets (GN's own inputs, the compiler's
# dependency output and the Dart compilers' depfiles): about 12k of the
# tree's 82k files. The patterns are deliberately a little wider than the
# measurement so that a Dart roll which adds a source does not usually need a
# change here; one that reads from a new area fails the (sandboxed) wrapped
# build with a missing-file error, and the fix is a pattern below.
filegroup(
    name = "build_tree",
    srcs = [
        "BUILD.gn",
        "tools/VERSION",
        # Resolves the Dart packages compile_platform, gen_kernel and the
        # frontend server are compiled from (globbed below).
        ".dart_tool/package_config.json",
        # The prebuilt SDK that bootstraps the build (`dart compile exe` of
        # compile_platform and gen_kernel), from DEPS: the launcher, the
        # runtimes, and the gen_snapshot it drives. Its snapshots and
        # libraries are globbed below.
        "tools/sdks/dart-sdk/bin/dart",
        "tools/sdks/dart-sdk/bin/dartaotruntime",
        "tools/sdks/dart-sdk/bin/dartvm",
        "tools/sdks/dart-sdk/bin/utils/gen_snapshot",
        "tools/sdks/dart-sdk/version",
        "third_party/perfetto/BUILD.gn",
        "third_party/perfetto/src/BUILD.gn",
    ] + glob(
        [
            # Build definitions and the scripts they run.
            "*.gni",
            "build/**",
            "utils/**",
            "tools/*.py",
            # The runtime (VM, embedder library, gen_snapshot) and the core
            # library sources it is built with.
            "runtime/**",
            "sdk/**",
            # The Dart packages the compilers are built from. Only a
            # package's lib/, bin/ and tool/ are reachable from those entry
            # points, except that front_end's compile_platform imports
            # helpers from its test/ directory.
            "pkg/*",
            "pkg/*/*",
            "pkg/*/bin/**",
            "pkg/*/lib/**",
            "pkg/*/test/*.dart",
            "pkg/*/tool/**",
            "third_party/pkg/**/lib/**",
            "third_party/pkg/**/pubspec.yaml",
            # Bundled C++ dependencies of the runtime (the engine provides
            # boringssl, zlib and icu itself).
            "third_party/double-conversion/**",
            "third_party/perfetto/mock_protobuf/**",
            "third_party/perfetto/protos/**",
            "third_party/perfetto/src/gn/**",
            "third_party/perfetto/src/include/**",
            "third_party/perfetto/src/src/base/**",
            "third_party/perfetto/src/src/protozero/**",
            # What the bootstrap SDK loads.
            "tools/sdks/dart-sdk/bin/snapshots/**",
            "tools/sdks/dart-sdk/lib/**",
        ],
        exclude = [
            "**/__pycache__/**",
            "**/testcases/**",
            "**/testdata/**",
            "pkg/*/lib/**/test/**",
            "runtime/docs/**",
            "runtime/tests/**",
            "runtime/tools/dartfuzz/**",
            "runtime/tools/graphexplorer/**",
            "runtime/tools/wiki/**",
            "third_party/pkg/**/test/**",
        ],
    ),
)

# The Dart packages the engine's Dart tests (//flutter/testing/dart, run by
# flutter_tester) import: package:test and what it reaches (test_api,
# test_core, matcher, and the core and tools packages below them), vm_service
# with its protos and protobuf, ffi, meta -- as measured on the kernel
# compiles' depfiles under GN (about 30 packages, 520 files); whole package
# groups here, for the next roll. The engine's package configuration names
# them by their paths under this tree, which dart_package_root reproduces.
filegroup(
    name = "test_package_sources",
    srcs = glob([
        "pkg/meta/lib/**/*.dart",
        "pkg/vm_service/lib/**/*.dart",
        "pkg/vm_service_protos/lib/**/*.dart",
        "third_party/pkg/core/pkgs/*/lib/**/*.dart",
        "third_party/pkg/native/pkgs/ffi/lib/**/*.dart",
        "third_party/pkg/protobuf/protobuf/lib/**/*.dart",
        "third_party/pkg/test/pkgs/*/lib/**/*.dart",
        "third_party/pkg/tools/pkgs/*/lib/**/*.dart",
    ]),
)

# The packages of this tree that the engine's own Dart tools and their tests
# import when `dart test` runs in a package of the tree
# (testing/run_tests.py --type dart-host; build/bazel/dart/package_test.bzl):
# package:test's runner and everything below it -- the analyzer it parses
# test files with, coverage, shelf and the web-socket packages of its browser
# platforms, vm_service, frontend_server_client -- and the core and tools
# packages the tools use directly (args, path, yaml, logging, ...); 48
# packages as resolved in the engine's package configuration. Whole package
# groups again, for the next roll.
filegroup(
    name = "host_package_sources",
    srcs = glob([
        "pkg/_fe_analyzer_shared/lib/**/*.dart",
        "pkg/analyzer/lib/**/*.dart",
        "pkg/frontend_server_client/lib/**/*.dart",
        "pkg/meta/lib/**/*.dart",
        "pkg/vm_service/lib/**/*.dart",
        "third_party/pkg/core/pkgs/*/lib/**/*.dart",
        "third_party/pkg/http/pkgs/*/lib/**/*.dart",
        "third_party/pkg/native/pkgs/ffi/lib/**/*.dart",
        "third_party/pkg/shelf/pkgs/*/lib/**/*.dart",
        "third_party/pkg/test/pkgs/*/lib/**/*.dart",
        "third_party/pkg/tools/pkgs/*/lib/**/*.dart",
        "third_party/pkg/web/web/lib/**/*.dart",
        "third_party/pkg/webkit_inspection_protocol/lib/**/*.dart",
    ]) + [":test_runner"],
)

# package:test's entry point, which dart_package_test runs on the VM: what
# `dart test` delegates to.
filegroup(
    name = "test_runner",
    srcs = ["third_party/pkg/test/pkgs/test/bin/test.dart"],
)
