# Root BUILD file of a Debian sysroot repository (@sysroot_linux_x64, ...):
# the tarballs pinned in build/linux/sysroot_scripts/sysroots.json, either
# unpacked by the gclient hook or downloaded by Bazel. The toolchain passes
# the repository root as --sysroot and needs the headers and libraries as
# action inputs.

package(default_visibility = ["//visibility:public"])

# The toolchain derives the --sysroot path from this file's location.
exports_files(["BUILD.bazel"])

filegroup(
    name = "headers",
    srcs = glob(
        [
            "usr/include/**",
            # Headers that live next to their library, which pkg-config
            # adds with -I (usr/lib/x86_64-linux-gnu/glib-2.0/include, ...).
            "usr/lib/*/*/include/**",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "libraries",
    # Only what the linker resolves: shared objects (and the linker scripts
    # named like them), archives and the crt objects, in the directories clang
    # searches for a Debian multiarch sysroot. Subdirectories hold plugins,
    # Python and Perl modules, systemd units with names Bazel cannot label, ...
    srcs = glob(
        [
            "lib/*-linux-gnu*/*.so*",
            "lib64/*",
            "usr/lib/*-linux-gnu*/*.a",
            "usr/lib/*-linux-gnu*/*.o",
            "usr/lib/*-linux-gnu*/*.so*",
            "usr/lib/gcc/*/*/*.a",
            "usr/lib/gcc/*/*/*.o",
            "usr/lib/gcc/*/*/*.so*",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "all_files",
    srcs = [
        ":headers",
        ":libraries",
    ],
)

# What a GN build using this sysroot reads, for rules that wrap a GN build:
# the above, plus the pkg-config metadata (build/config/linux/pkg_config.gni)
# and the loader configuration build/linux/sysroot_ld_path.sh evaluates.
filegroup(
    name = "build_tree",
    srcs = [
        ":headers",
        ":libraries",
    ] + glob(
        [
            "etc/ld.so.conf*",
            "etc/ld.so.conf.d/*",
            "usr/lib/pkgconfig/*.pc",
            "usr/lib/*-linux-gnu*/pkgconfig/*.pc",
            "usr/share/pkgconfig/*.pc",
        ],
        allow_empty = True,
    ),
)
