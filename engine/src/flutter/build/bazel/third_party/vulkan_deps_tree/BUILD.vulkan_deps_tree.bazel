# Root BUILD file of @vulkan_deps_tree: the vulkan-deps directory -- the
# Khronos trees (headers, loader, tools, SPIRV-Tools, SPIRV-Headers, glslang,
# ...) as DEPS lays them out -- as files, for the wrapped GN build of the GPU
# test backends (//engine/src/flutter/build/bazel/gl_wrap). The repositories
# Bazel builds from the same trees (@vulkan-headers, @spirv-tools, ...) are
# separate, over the subdirectories.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "build_tree",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "REPO.bazel",
            "*.bzl",
            # The checkout's git state is no input of the build.
            "**/.git/**",
            "**/test/**",
            "**/tests/**",
            "**/docs/**",
            "spirv-cross/**",
        ],
    ),
)
