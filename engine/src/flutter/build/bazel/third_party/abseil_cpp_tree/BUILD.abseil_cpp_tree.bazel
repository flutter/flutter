# Root BUILD file of @abseil_cpp_tree: the abseil-cpp tree, for its headers
# under the path the engine includes them by and for the two configs of its
# Chromium-style GN file that ANGLE's GN names. Bazel's own abseil is
# @abseil-cpp, upstream's rules over the same tree.

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Abseil's headers under the engine's root-relative spelling,
# "third_party/abseil-cpp/absl/<path>.h", which GN's root include directory
# (-I../..) resolves beside the canonical "absl/<path>.h" that abseil's own
# Bazel build exposes: a view of the same files under that prefix, so that
# no engine include changes for Bazel. The converter lists it beside every
# @abseil-cpp dependency (bazel_mapping's rootIncludeViews).
cc_library(
    name = "root_includes",
    hdrs = glob(
        [
            "absl/**/*.h",
            "absl/**/*.inc",
        ],
        exclude = [
            "**/*_test.h",
            "**/*_testing.h",
            "**/testdata/**",
        ],
    ),
    include_prefix = "third_party/abseil-cpp",
)

# config("absl_define_config") of abseil's Chromium-style BUILD.gn, which
# ANGLE's own abseil config lists (so that ANGLE's sources see abseil's
# allocator trait as abseil's GN-built sources do): as a library, for the
# converted ANGLE to depend on.
cc_library(
    name = "absl_define_config",
    defines = ["ABSL_ALLOCATOR_NOTHROW=1"],
)

# config("absl_include_config") of the same file: abseil's root as an
# include directory, which every library of @abseil-cpp carries already;
# the label exists so that the GN configs naming it have a home.
cc_library(
    name = "absl_include_config",
)
