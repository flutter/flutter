# Root BUILD file of @zlib: Chromium's zlib fork pinned in DEPS. Mirrors the
# targets of its BUILD.gn that the engine uses (`zlib` and the SIMD source
# sets it is assembled from) as the engine's GN build configures them.
#
# Four CPUs are covered: x86-64 (use_x86_x64_optimizations in BUILD.gn: the
# SIMD source sets and their defines), arm64 and arm
# (use_arm_neon_optimizations: the NEON source sets and the ARMv8 CRC32, the
# 64-bit chunk reads on arm64 alone) and wasm32 (neither optimization: the
# portable zlib -- CPU_NO_SIMD, the plain inflate.c, no SIMD source sets --
# as the web build has it). The select()s have no default, so a build for
# another CPU fails at analysis rather than silently producing a zlib
# without its SIMD paths.

# This file is loaded as the root of @zlib, so the main module is named.
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@flutter//engine/src/flutter/build/bazel:copts.bzl", "CHROMIUM_CODE_COPTS", "FLUTTER_LOCAL_DEFINES", "FLUTTER_THIRD_PARTY_COPTS")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The CPUs the engine builds zlib for: GN's use_x86_x64_optimizations (x64),
# use_arm_neon_optimizations (arm64: the Linux cross build and Android;
# arm: Android) and neither (wasm32: CPU_NO_SIMD, the plain inflate.c).
_X86_64 = "@platforms//cpu:x86_64"

_AARCH64 = "@platforms//cpu:aarch64"

_ARMV7 = "@platforms//cpu:armv7"

_WASM32 = "@platforms//cpu:wasm32"

# The ARM CPUs on Android and elsewhere (Linux): zlib_arm_crc32_config's
# ARMV8_OS_* define, which picks the CPU-feature query (the NDK-compatible
# cpu-features on Android, getauxval on Linux).
selects.config_setting_group(
    name = "arm_android",
    match_all = [
        "@platforms//os:android",
        ":arm_any",
    ],
)

selects.config_setting_group(
    name = "arm_elsewhere",
    match_all = [
        "@flutter//engine/src/flutter/build/bazel:not_android",
        ":arm_any",
    ],
)

selects.config_setting_group(
    name = "arm_any",
    match_any = [
        _AARCH64,
        _ARMV7,
    ],
)

# config("zlib_internal_config"): ZLIB_DEBUG in unoptimized builds.
_INTERNAL_DEFINES = ["ZLIB_IMPLEMENTATION"] + select({
    "@flutter//engine/src/flutter/build/bazel:optimized": [],
    "//conditions:default": ["ZLIB_DEBUG"],
})

# config("zlib_warnings")
_ZLIB_WARNINGS = [
    "-Wno-incompatible-pointer-types",
    "-Wunused-variable",
]

# The public_configs of the SIMD source sets, which apply to them and to
# the zlib target that depends on them.
_ADLER32_SIMD_DEFINES = select({
    _X86_64: [
        "ADLER32_SIMD_SSSE3",
        "X86_NOT_WINDOWS",
    ],
    _AARCH64: ["ADLER32_SIMD_NEON"],
    _ARMV7: ["ADLER32_SIMD_NEON"],
    _WASM32: [],
})

_CRC32_SIMD_DEFINES = select({
    _X86_64: ["CRC32_SIMD_SSE42_PCLMUL"],
    _AARCH64: [],
    _ARMV7: [],
    _WASM32: [],
})

# config("zlib_arm_crc32_config"): the ARMv8 CRC32 instructions, and the OS
# whose CPU-feature query says whether the CPU has them.
_ARM_CRC32_DEFINES = select({
    ":arm_any": ["CRC32_ARMV8_CRC32"],
    "//conditions:default": [],
}) + select({
    ":arm_android": ["ARMV8_OS_ANDROID"],
    ":arm_elsewhere": ["ARMV8_OS_LINUX"],
    "//conditions:default": [],
})

# The 64-bit chunk reads and writes are the 64-bit CPUs' (GN: x64, arm64).
_DATA_CHUNK_SIMD_DEFINES = select({
    _X86_64: [
        "INFLATE_CHUNK_SIMD_SSE2",
        "INFLATE_CHUNK_READ_64LE",
        "DEFLATE_CHUNK_WRITE_64LE",
    ],
    _AARCH64: [
        "INFLATE_CHUNK_SIMD_NEON",
        "INFLATE_CHUNK_READ_64LE",
        "DEFLATE_CHUNK_WRITE_64LE",
    ],
    _ARMV7: ["INFLATE_CHUNK_SIMD_NEON"],
    _WASM32: [],
})

_SLIDE_HASH_SIMD_DEFINES = select({
    _X86_64: ["DEFLATE_SLIDE_HASH_SSE2"],
    _AARCH64: ["DEFLATE_SLIDE_HASH_NEON"],
    _ARMV7: ["DEFLATE_SLIDE_HASH_NEON"],
    _WASM32: [],
})

# source_set("zlib_common_headers")
cc_library(
    name = "zlib_common_headers",
    hdrs = [
        "chromeconf.h",
        "deflate.h",
        "inffast.h",
        "inffixed.h",
        "inflate.h",
        "inftrees.h",
        "zconf.h",
        "zlib.h",
        "zutil.h",
    ],
    visibility = ["//visibility:private"],
)

# source_set("zlib_adler32_simd") -- chromium_code, unlike zlib itself.
cc_library(
    name = "zlib_adler32_simd",
    srcs = ["adler32_simd.c"],
    hdrs = ["adler32_simd.h"],
    copts = CHROMIUM_CODE_COPTS + select({
        _X86_64: ["-mssse3"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    local_defines = FLUTTER_LOCAL_DEFINES + _INTERNAL_DEFINES + _ADLER32_SIMD_DEFINES,
    visibility = ["//visibility:private"],
    deps = [":zlib_common_headers"],
)

# source_set("zlib_crc32_simd") -- chromium_code.
cc_library(
    name = "zlib_crc32_simd",
    srcs = [
        "crc32_simd.c",
        "crc_folding.c",
    ],
    hdrs = ["crc32_simd.h"],
    copts = CHROMIUM_CODE_COPTS + [
        "-msse4.2",
        "-mpclmul",
    ],
    linkstatic = True,
    local_defines = FLUTTER_LOCAL_DEFINES + _INTERNAL_DEFINES + _CRC32_SIMD_DEFINES,
    target_compatible_with = [_X86_64],
    visibility = ["//visibility:private"],
    deps = [":zlib_common_headers"],
)

# source_set("zlib_arm_crc32") -- the ARM builds' CRC32 (clang needs no
# -march for the intrinsics; GN adds one for gcc alone).
cc_library(
    name = "zlib_arm_crc32",
    srcs = ["crc32_simd.c"],
    hdrs = ["crc32_simd.h"],
    copts = CHROMIUM_CODE_COPTS,
    includes = ["."],
    linkstatic = True,
    local_defines = FLUTTER_LOCAL_DEFINES + _INTERNAL_DEFINES + _ARM_CRC32_DEFINES,
    target_compatible_with = select({
        ":arm_any": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = [":zlib_common_headers"],
)

# source_set("zlib_data_chunk_simd"): the chunk-copying inflate that
# replaces inflate.c; no_chromium_code with zlib_warnings.
cc_library(
    name = "zlib_data_chunk_simd",
    srcs = [
        "contrib/optimizations/inffast_chunk.c",
        "contrib/optimizations/inflate.c",
    ],
    hdrs = [
        "contrib/optimizations/chunkcopy.h",
        "contrib/optimizations/inffast_chunk.h",
    ],
    copts = FLUTTER_THIRD_PARTY_COPTS + _ZLIB_WARNINGS,
    includes = ["."],
    linkstatic = True,
    local_defines = _INTERNAL_DEFINES + _DATA_CHUNK_SIMD_DEFINES,
    visibility = ["//visibility:private"],
    deps = [":zlib_common_headers"],
)

# source_set("zlib_slide_hash_simd") -- header only.
cc_library(
    name = "zlib_slide_hash_simd",
    hdrs = ["slide_hash_simd.h"],
    visibility = ["//visibility:private"],
    deps = [":zlib_common_headers"],
)

# component("zlib"), as a static library (there is no component build).
# config("zlib_config") is `includes`; the engine also includes the headers
# as "third_party/zlib/zlib.h", which include_prefix provides.
cc_library(
    name = "zlib",
    srcs = [
        "adler32.c",
        "compress.c",
        "contrib/optimizations/insert_string.h",
        "cpu_features.c",
        "cpu_features.h",
        "crc32.c",
        "crc32.h",
        "deflate.c",
        "deflate.h",
        "gzclose.c",
        "gzguts.h",
        "gzlib.c",
        "gzread.c",
        "gzwrite.c",
        "infback.c",
        "inffast.c",
        "inffast.h",
        "inffixed.h",
        "inflate.h",
        "inftrees.c",
        "inftrees.h",
        "trees.c",
        "trees.h",
        "uncompr.c",
        "zutil.c",
        "zutil.h",
    ] + select({
        _X86_64: [],
        _AARCH64: [],
        _ARMV7: [],
        # Without the chunk-copying inflate of zlib_data_chunk_simd.
        _WASM32: ["inflate.c"],
    }),
    hdrs = [
        "chromeconf.h",
        "zconf.h",
        "zlib.h",
    ],
    copts = FLUTTER_THIRD_PARTY_COPTS + _ZLIB_WARNINGS,
    include_prefix = "third_party/zlib",
    includes = ["."],
    linkstatic = True,
    local_defines = _INTERNAL_DEFINES + _ADLER32_SIMD_DEFINES + _CRC32_SIMD_DEFINES +
                    _ARM_CRC32_DEFINES + _DATA_CHUNK_SIMD_DEFINES + _SLIDE_HASH_SIMD_DEFINES +
                    select({
                        _X86_64: [],
                        _AARCH64: [],
                        _ARMV7: [],
                        _WASM32: ["CPU_NO_SIMD"],
                    }),
    deps = [":zlib_common_headers"] + select({
        _X86_64: [
            ":zlib_adler32_simd",
            ":zlib_crc32_simd",
            ":zlib_data_chunk_simd",
            ":zlib_slide_hash_simd",
        ],
        _AARCH64: [
            ":zlib_adler32_simd",
            ":zlib_arm_crc32",
            ":zlib_data_chunk_simd",
            ":zlib_slide_hash_simd",
        ],
        _ARMV7: [
            ":zlib_adler32_simd",
            ":zlib_arm_crc32",
            ":zlib_data_chunk_simd",
            ":zlib_slide_hash_simd",
        ],
        _WASM32: [],
    }) + select({
        # BUILD.gn: an Android build's CPU detection goes through the
        # NDK-compatible cpu-features (//third_party/cpu_features:ndk_compat).
        "@platforms//os:android": ["@cpu_features//:ndk_compat"],
        "//conditions:default": [],
    }),
)

# static_library("compression_utils_portable") in google/BUILD.gn: the
# gzip helpers over zlib that ANGLE's shader cache uses. The secondary tree's
# //third_party/zlib/google:compression_utils_portable, through which ANGLE
# names it, adds google/ as an include directory.
cc_library(
    name = "compression_utils_portable",
    srcs = ["google/compression_utils_portable.cc"],
    hdrs = ["google/compression_utils_portable.h"],
    copts = FLUTTER_THIRD_PARTY_COPTS,
    includes = ["google"],
    linkstatic = True,
    deps = [":zlib"],
)

# What the GN build of this tree reads, for rules that wrap a GN build (the
# Dart SDK's uses zlib; the GPU test backends' uses zlib and
# google:compression_utils_portable).
filegroup(
    name = "build_tree",
    srcs = glob(
        ["**"],
        exclude = [
            # This repository's Bazel files are not GN inputs.
            "BUILD.bazel",
            "REPO.bazel",
            "*.bzl",
            # Nor the bytecode caches a GN build in the same checkout
            # leaves beside the Python scripts it runs (Bazel's own runs
            # write none: PYTHONDONTWRITEBYTECODE).
            "**/__pycache__/**",
            "contrib/tests/**",
            "examples/**",
            "google/test/**",
            "patches/**",
            "test/**",
        ],
    ),
)
