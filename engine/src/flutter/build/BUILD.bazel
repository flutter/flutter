# The engine's additions to the GN build configuration: templates, and the
# secondary source tree (//flutter/build/secondary) that supplies BUILD.gn
# files for dependencies which ship none. Inputs of the rules that wrap a GN
# build of part of the tree. The bazel/ subdirectory is its own package.

# zip_bundle.gni's script, which bazel/zip_bundle.bzl runs the same way.
exports_files(["zip.py"])

# What a wrapped GN build reads here. The build configuration (config/, dart/,
# the .gni files) is in whole, with slack: it is small and changes rarely. The
# secondary tree is not: a wrapped build loads only the BUILD.gn files of its
# own dependencies (for the Dart SDK: the C++ runtime, zlib, BoringSSL, ICU,
# perfetto, gtest -- `gn gen --root-target=//flutter/build/bazel/dart_wrap`
# reads 10 files under flutter/build, and ninja none; for the GPU test
# backends, the allocator and jsoncpp besides), and listing the whole tree
# would make every edit to flatbuffers' or harfbuzz's BUILD.gn rebuild the
# Dart SDK from scratch. A wrapped build that starts reading from a new
# directory fails with a missing file in the sandbox; the fix is a line here.
filegroup(
    name = "gn_files",
    srcs = glob(
        [
            "*.gni",
            "*.py",
            "*.sh",
            "archives/**",
            "config/**",
            "dart/**",
            "esbuild/**",
            "secondary/flutter/third_party/libcxxabi/**",
            "secondary/flutter/third_party/llvm_libc/**",
            "secondary/flutter/third_party/vulkan_memory_allocator/**",
            "secondary/testing/**",
            "secondary/third_party/boringssl/**",
            "secondary/third_party/dart/**",
            "secondary/third_party/icu/**",
            "secondary/third_party/jsoncpp/**",
            "secondary/third_party/perfetto/**",
            "secondary/third_party/vulkan_validation_layers/**",
            "secondary/third_party/zlib/**",
        ],
        exclude = [
            # Bazel's own files are not GN inputs.
            "**/BUILD.bazel",
            "**/*.bzl",
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ) + [
        # Subpackages the glob does not enter.
        "//engine/src/flutter/build/secondary/flutter/third_party/libcxx:gn_files",
    ],
    visibility = ["//engine/src/flutter/build/bazel:__subpackages__"],
)
