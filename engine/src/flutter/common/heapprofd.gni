declare_args() {
  # Enables Dart heap allocation sampling integration with Android's Perfetto
  # tracing daemon (/dev/socket/traced_producer) using Perfetto's
  # SharedMemoryABI and protozero.
  flutter_enable_heapprofd = false
}
