import("//flutter/testing/testing.gni")
import("config.gni")

config("flutter_config") {
  defines = feature_defines_list
}

source_set("common") {
  sources = [
    "macros.h",
    "settings.cc",
    "settings.h",
    "task_runners.cc",
    "task_runners.h",
    "vulkan_driver_info.cc",
    "vulkan_driver_info.h",
  ]

  deps = [ "//flutter/fml" ]

  public_configs = [
    ":flutter_config",
    "//flutter:config",
  ]
}

if (enable_unittests) {
  test_fixtures("common_fixtures") {
    fixtures = []
  }

  executable("common_unittests") {
    testonly = true

    sources = [ "vulkan_driver_info_unittests.cc" ]

    deps = [
      ":common",
      ":common_fixtures",
      "//flutter/testing",
    ]
  }
}
