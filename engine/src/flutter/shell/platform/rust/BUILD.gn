import("//build/config/android/config.gni")
import("//flutter/build/bin_to_obj.gni")
import("//flutter/testing/testing.gni")

_flutter_shell_core_output = "$target_gen_dir/rust/libflutter_shell_core.a"
_flutter_shell_winit_output = "$target_gen_dir/rust/libflutter_shell_winit.a"
_flutter_shell_wgpu_output = "$target_gen_dir/rust/libflutter_shell_wgpu.a"

# Cargo owns Rust dependency resolution. This action produces the static
# runtime archive consumed by the private C++/Rust ABI test and, later, by the
# Rust runner. The workspace rust-toolchain.toml pins Rust 1.93.1.
action("flutter_shell_core_rust") {
  script = "build_rust.py"

  inputs = [
    "Cargo.lock",
    "Cargo.toml",
    "rust-toolchain.toml",
    "crates/flutter-plugin-sdk/Cargo.toml",
    "crates/flutter-plugin-sdk/src/lib.rs",
    "crates/flutter-shell-core/Cargo.toml",
    "crates/flutter-shell-core/src/lib.rs",
  ]

  outputs = [ _flutter_shell_core_output ]

  args = [
    "--manifest-path",
    rebase_path("Cargo.toml", root_build_dir),
    "--package",
    "flutter-shell-core",
    "--output",
    rebase_path(_flutter_shell_core_output, root_build_dir),
  ]
}

# This archive owns winit's event loop. It remains separate from the small
# core ABI archive because the final native runner is responsible for linking
# its platform system libraries alongside the Flutter engine.
action("flutter_shell_winit_rust") {
  script = "build_rust.py"

  inputs = [
    "Cargo.lock",
    "Cargo.toml",
    "rust-toolchain.toml",
    "crates/flutter-plugin-sdk/Cargo.toml",
    "crates/flutter-plugin-sdk/src/lib.rs",
    "crates/flutter-shell-core/Cargo.toml",
    "crates/flutter-shell-core/src/lib.rs",
    "crates/flutter-shell-winit/Cargo.toml",
    "crates/flutter-shell-winit/src/lib.rs",
    "crates/flutter-shell-wgpu/Cargo.toml",
    "crates/flutter-shell-wgpu/src/lib.rs",
  ]

  outputs = [ _flutter_shell_winit_output ]

  args = [
    "--manifest-path",
    rebase_path("Cargo.toml", root_build_dir),
    "--package",
    "flutter-shell-winit",
    "--output",
    rebase_path(_flutter_shell_winit_output, root_build_dir),
  ]
}

# The broker owns wgpu and is intentionally isolated from the C++ engine ABI.
# It is built as a Rust library until the winit runner links the final native
# executable, where its platform system dependencies can be supplied together.
action("flutter_shell_wgpu_rust") {
  script = "build_rust.py"

  inputs = [
    "Cargo.lock",
    "Cargo.toml",
    "rust-toolchain.toml",
    "crates/flutter-shell-wgpu/Cargo.toml",
    "crates/flutter-shell-wgpu/src/lib.rs",
  ]

  outputs = [ _flutter_shell_wgpu_output ]

  args = [
    "--manifest-path",
    rebase_path("Cargo.toml", root_build_dir),
    "--package",
    "flutter-shell-wgpu",
    "--output",
    rebase_path(_flutter_shell_wgpu_output, root_build_dir),
  ]
}

# Unlike the Java Android embedding, this shared library has no Activity/
# AssetManager-backed asset loading yet (see flutter-rs-proggress.md
# milestone 2); ICU data still must be linked in as a binary symbol, since
# //flutter/shell/common/switches.cc unconditionally expects
# _binary_icudtl_dat_start/_size to exist on Android rather than accepting a
# filesystem icu_data_path there.
if (is_android) {
  bin_to_assembly("rust_shell_icudtl_asm") {
    deps = []
    input = "//flutter/third_party/icu/flutter/icudtl.dat"
    symbol = "_binary_icudtl_dat_start"
    size_symbol = "_binary_icudtl_dat_size"
    executable = false
  }
}

# This target is intentionally independent of a particular native platform.
# Platform-specific Rust implementations are selected by the Rust runner, not
# by the existing GTK, Win32, Android, or Darwin shell targets.
source_set("flutter_rust_shell") {
  public = [
    "cpp/platform_view_rust.h",
    "cpp/rust_bridge.h",
    "cpp/rust_external_texture.h",
    "cpp/rust_shell.h",
    "cpp/rust_task_runner.h",
    "cpp/rust_vulkan_surface.h",
    "cpp/vulkan_context_rust.h",
  ]

  sources = [
    "cpp/platform_view_rust.cc",
    "cpp/rust_external_texture.cc",
    "cpp/rust_shell.cc",
    "cpp/rust_task_runner.cc",
    "cpp/rust_vulkan_surface.cc",
    "cpp/vulkan_context_rust.cc",
  ]

  public_deps = [
    "//flutter/shell/common",
    "//flutter/shell/gpu:gpu_surface_vulkan",
  ]

  deps = [
    "//flutter/fml",
    "//flutter/impeller",
    "//flutter/impeller/renderer/backend/vulkan",
    "//flutter/lib/ui",
    "//flutter/runtime",
    "//flutter/shell/platform/common:common_cpp_switches",
  ]

  if (is_android) {
    sources += get_target_outputs(":rust_shell_icudtl_asm")
    deps += [ ":rust_shell_icudtl_asm" ]
  }
}

# The application-facing engine boundary. Cargo links a small Rust binary to
# this library; GN keeps ownership of the private Flutter, Dart, Impeller, and
# Skia dependency closure. This is deliberately not the public Embedder API.
shared_library("flutter_rust_engine") {
  output_name = "flutter_rust_engine"

  # Ninja must relink if the Linux export policy changes.
  inputs = [ "cpp/rust_engine_exports.lst" ]

  # source_set object files only propagate through public_deps.  The shared
  # object is the owner of this implementation, so make the implementation
  # source set public to the link while keeping its C++ headers private at the
  # Rust/C ABI boundary.
  public_deps = [ ":flutter_rust_shell" ]

  deps = [
    "//flutter/lib/snapshot",
    "//flutter/runtime:libdart",
  ]

  # Export only the private C ABI plus the two debug snapshot symbols the Dart
  # VM discovers from this loaded library. The Rust executable itself remains
  # unaware of Dart, Impeller, and Skia.
  if (is_linux || is_android) {
    ldflags = [ "-Wl,--version-script=" +
                rebase_path("cpp/rust_engine_exports.lst", root_build_dir) ]
  }

  public_configs = [ "//flutter:config" ]
}

# The standalone native runner. Rust owns the winit main loop and native
# window; this executable is only the process entry point and the private
# ABI callback implementations linked in through :flutter_rust_shell.
executable("flutter_rust_shell_runner") {
  sources = [
    "cpp/main.cc",
    "cpp/rust_runner.h",
  ]

  # The Dart VM resolves its JIT snapshot symbols by looking inside the
  # currently loaded process; this makes them visible despite the default
  # hidden-visibility build config. See shell_host_executable in
  # //flutter/shell/common/BUILD.gn for the same requirement.
  inputs = []
  ldflags = []
  if (is_linux) {
    inputs += [ "cpp/rust_runner_exports.sym" ]
    ldflags +=
        [ "-Wl,--dynamic-list=" + rebase_path(inputs[0], root_build_dir) ]
  } else {
    public_configs = [ "//flutter:export_dynamic_symbols" ]
  }

  deps = [
    ":flutter_rust_shell",
    ":flutter_shell_winit_rust",
    "//flutter/lib/snapshot",
    "//flutter/runtime:libdart",
  ]

  # The Rust archive is passed directly to the linker, so declare it as an
  # input as well as depending on its producing action. Otherwise changes to
  # Rust-only event handling do not cause the native runner to relink.
  inputs += [ _flutter_shell_winit_output ]
  ldflags += [ rebase_path(_flutter_shell_winit_output, root_build_dir) ]

  libs = [
    "dl",
    "pthread",
  ]
}

# Android milestones 1 and 2 (see flutter-rs-proggress.md). Unlike the other
# actions above, this crate is a cdylib: Android has no separate host
# executable, so the OS loads this shared object directly and calls its
# exported `android_main`. It does not link :flutter_shell_winit_rust's
# static archive the way the desktop runner does; instead its own build.rs
# dynamically links against :flutter_rust_engine's shared object, the same
# way a generated app's runner-rs links against the SDK-distributed one on
# Linux (see build.rs's doc comment).
if (is_android && (current_cpu == "arm64" || current_cpu == "x64")) {
  if (current_cpu == "arm64") {
    _rust_android_target = "aarch64-linux-android"
  } else {
    _rust_android_target = "x86_64-linux-android"
  }

  _flutter_shell_android_runner_output = "$root_out_dir/android_shell/jniLibs/$android_app_abi/libflutter_shell_android_runner.so"

  # Deliberately outside android_shell/jniLibs/: Gradle's jniLibs source set
  # scans that whole directory tree for native libraries, so Cargo's build
  # scratch (host-built proc-macro .so files, intermediate objects) must not
  # live underneath the ABI directory that only the final artifact belongs
  # in.
  _flutter_shell_android_runner_cargo_target_dir =
      "$root_out_dir/android_shell/cargo-target/$android_app_abi"

  _android_clang = "$android_toolchain_root/bin/$_rust_android_target$android_api_level-clang"
  _android_clang_cxx = "$android_toolchain_root/bin/$_rust_android_target$android_api_level-clang++"
  _android_ar = "$android_toolchain_root/bin/llvm-ar"

  action("flutter_shell_android_runner_rust") {
    script = "build_rust.py"
    deps = [ ":flutter_rust_engine" ]

    inputs = [
      "Cargo.lock",
      "Cargo.toml",
      "rust-toolchain.toml",
      "crates/flutter-plugin-sdk/Cargo.toml",
      "crates/flutter-plugin-sdk/src/lib.rs",
      "crates/flutter-shell-core/Cargo.toml",
      "crates/flutter-shell-core/src/lib.rs",
      "crates/flutter-shell-wgpu/Cargo.toml",
      "crates/flutter-shell-wgpu/src/lib.rs",
      "crates/flutter-shell-winit/Cargo.toml",
      "crates/flutter-shell-winit/src/lib.rs",
      "crates/flutter-shell-android-runner/Cargo.toml",
      "crates/flutter-shell-android-runner/src/lib.rs",
      "crates/flutter-shell-android-runner/build.rs",
      _android_clang,
      _android_clang_cxx,
      _android_ar,
    ]

    outputs = [ _flutter_shell_android_runner_output ]

    args = [
      "--manifest-path",
      rebase_path("Cargo.toml", root_build_dir),
      "--package",
      "flutter-shell-android-runner",
      "--output",
      rebase_path(_flutter_shell_android_runner_output, root_build_dir),
      "--target",
      _rust_android_target,
      "--crate-type",
      "cdylib",
      "--android-clang",
      rebase_path(_android_clang, root_build_dir),
      "--android-clang-cxx",
      rebase_path(_android_clang_cxx, root_build_dir),
      "--android-ar",
      rebase_path(_android_ar, root_build_dir),
      "--cargo-target-dir",
      rebase_path(_flutter_shell_android_runner_cargo_target_dir,
                  root_build_dir),
      "--engine-dir",
      rebase_path(root_out_dir, root_build_dir),
    ]
  }
}

if (enable_unittests) {
  executable("flutter_rust_shell_unittests") {
    testonly = true

    sources = [
      "cpp/platform_view_rust_unittests.cc",
      "cpp/rust_external_texture_unittests.cc",
      "cpp/rust_task_runner_unittests.cc",
    ]

    deps = [
      ":flutter_rust_shell",
      ":flutter_shell_core_rust",
      "//flutter/common",
      "//flutter/testing",
      "//flutter/testing:dart",
    ]

    inputs = [ _flutter_shell_core_output ]
    ldflags = [ rebase_path(_flutter_shell_core_output, root_build_dir) ]
  }
}
