        "-Wno-implicit-fallthrough",  # from :embedder_gpu_configuration
        "-Wno-nullability-completeness",  # from :embedder_gpu_configuration
        "-Wno-suggest-destructor-override",  # from :embedder_gpu_configuration
        "-Wno-suggest-override",  # from :embedder_gpu_configuration
        "-Wno-unused-private-field",  # from :embedder_gpu_configuration
        "-Wno-unused-variable",  # from :embedder_gpu_configuration
