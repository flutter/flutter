import("//flutter/build/dart/rules.gni")

if (!is_fuchsia) {
  ext = "so"
  if (is_mac || is_ios) {
    ext = "dylib"
  } else if (is_win) {
    ext = "dll"
  }

  # Build a minimal snapshot that can be used to launch the VM service isolate.
  flutter_snapshot("vmservice_snapshot") {
    main_dart = "//flutter/third_party/dart/pkg/dart_runtime_service_vm/bin/vm_service_entrypoint.dart"
    package_config = "//flutter/third_party/dart/.dart_tool/package_config.json"
    output_aot_lib = "libvmservice_snapshot.$ext"
  }
}

if (is_fuchsia || flutter_runtime_mode == "profile" ||
    flutter_runtime_mode == "release") {
  flutter_frontend_server("vmservice_snapshot_dill") {
    main_dart = "//flutter/third_party/dart/pkg/dart_runtime_service_vm/bin/vm_service_entrypoint.dart"
    package_config = "//flutter/third_party/dart/.dart_tool/package_config.json"
    kernel_output = "$root_out_dir/vmservice_snapshot.dill"
    extra_args = [ "--no-link-platform" ]
  }
} else {
  copy("vmservice_snapshot_dill") {
    sources = [ "$target_gen_dir/kernel_blob.bin" ]
    outputs = [ "$root_out_dir/vmservice_snapshot.dill" ]
    deps = [ ":vmservice_snapshot" ]
  }
}
