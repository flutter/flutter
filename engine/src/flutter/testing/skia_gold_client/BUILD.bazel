# package:skia_gold_client: the Skia Gold client of the engine's golden
# tests, which the Dart tests of testing/dart import. A Dart package with no
# GN build file; its tests are run_tests.py's (--type dart-host).

load("//build_defs/dart:package_test.bzl", "dart_package_test")

package(default_visibility = ["//visibility:public"])

# The library and the in-tree packages it imports, for the packages and
# kernel compiles that import it.
filegroup(
    name = "dart_sources",
    srcs = glob(["lib/**/*.dart"]) + [
        "//engine/src/flutter/tools/pkg/engine_repo_tools:dart_sources",
        "//engine/src/flutter/tools/pkg/git_repo_tools:dart_sources",
    ],
)

dart_package_test(
    name = "tests",
    deps = [
        ":dart_sources",
        "//engine/src/flutter/tools/pkg/process_fakes:dart_sources",
    ],
)
