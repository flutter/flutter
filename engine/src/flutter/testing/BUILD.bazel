# testing.gni's enable_unittests: `current_toolchain == host_toolchain ||
# is_fuchsia || is_mac` -- the host's own build (its OS and its CPU:
# //engine/src/flutter/build/bazel:host_toolchain; the Linux arm64 cross
# build has no tests, as GN's clang_arm64 toolchain has none), Fuchsia, macOS.
selects.config_setting_group(
    name = "unittests_enabled",
    match_any = [
        "//engine/src/flutter/build/bazel:host_toolchain",
        "@platforms//os:fuchsia",
        "@platforms//os:macos",
    ],
)

# testing.gni's enable_ios_unittests: `is_ios && flutter_runtime_mode ==
# "debug"` -- the iOS embedding's XCTest suite (shell/platform/darwin/ios's
# ios_test_flutter), built in the debug runtime mode alone ("we compile
# with --enable-tests, which impacts exported symbols").
selects.config_setting_group(
    name = "ios_unittests_enabled",
    match_all = [
        "@platforms//os:ios",
        "//engine/src/flutter/common:runtime_mode_debug",
    ],
)

# testing/rules/runtime_mode.gni's is_aot: `flutter_runtime_mode == "profile"
# || flutter_runtime_mode == "release"`, the modes in which the Android and
# iOS test apps are AOT-compiled (flutter_snapshot); and its denial, the
# JIT modes.
selects.config_setting_group(
    name = "aot_enabled",
    match_any = [
        "//engine/src/flutter/common:runtime_mode_profile",
        "//engine/src/flutter/common:runtime_mode_release",
    ],
)

selects.config_setting_group(
    name = "aot_disabled",
    match_any = [
        "//engine/src/flutter/common:runtime_mode_debug",
        "//engine/src/flutter/common:runtime_mode_jit_release",
    ],
)

# The goldens and other resources testing/run_tests.py hands suites with
# --golden-dir (flow_unittests).
filegroup(
    name = "resources",
    srcs = glob(["resources/**"]),
)
