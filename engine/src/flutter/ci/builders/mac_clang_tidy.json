{
    "_comment": [
        "The builds run under Bazel (--bazel among the tools/gn flags; flutter/build/bazel/ci.md), and each",
        "lints itself as linux_clang_tidy.json's do: ci/clang_tidy.sh, run as the build's own test step, makes",
        "the compile database from the build's action graph (tools/gn_to_bazel/tool/compile_commands.py; the",
        "Apple toolchains' remote-compile wrapper resolved to the Mac's clang, where clang-tidy is) and runs",
        "the lint over its share. The database names the drone's own execution root, so GN's tester drones",
        "over a CAS archive -- which re-ran tools/gn for a database of their own -- cannot work here. The host",
        "variant is built on two drones (ci/host_debug_clang_tidy and _1: the same build, the second's install",
        "from the remote cache), each linting one half of the same database (--shard-id over the sorted list,",
        "--shard-variants naming the drone's own database: two shards); the iOS simulator variant lints every",
        "file of its own database on one drone. The builds name the drones' CPU (--mac-cpu arm64,",
        "--simulator-cpu arm64), as the other Mac files do: tools/gn's x64 default would have the lint read an",
        "x64 build on an arm64 drone, whose host tools (flutter_tester_opengles) are then no build of the platform's."
    ],
    "builds": [
        {
            "archives": [],
            "cas_archive": false,
            "drone_dimensions": [
                "device_type=none",
                "os=Mac-15.7|Mac-26.6",
                "cpu=arm64"
            ],
            "gclient_variables": {
                "download_android_deps": false,
                "use_rbe": true,
                "download_bazelisk": true
            },
            "gn": [
                "--runtime-mode",
                "debug",
                "--prebuilt-dart-sdk",
                "--no-lto",
                "--target-dir",
                "ci/host_debug_clang_tidy",
                "--mac-cpu",
                "arm64",
                "--no-rbe",
                "--no-goma",
                "--xcode-symlinks",
                "--bazel"
            ],
            "name": "ci/host_debug_clang_tidy",
            "description": "A debug mode macOS host build used only as the basis for a clang-tidy run, which runs as its test step.",
            "ninja": {
                "config": "ci/host_debug_clang_tidy"
            },
            "properties": {
                "$flutter/osx_sdk": {
                    "sdk_version": "17c52"
                }
            },
            "tests": [
                {
                    "name": "test: lint host_debug 0",
                    "script": "flutter/ci/clang_tidy.sh",
                    "parameters": [
                        "--variant",
                        "ci/host_debug_clang_tidy",
                        "--lint-all",
                        "--shard-id=0",
                        "--shard-variants=ci/host_debug_clang_tidy"
                    ]
                }
            ]
        },
        {
            "archives": [],
            "cas_archive": false,
            "drone_dimensions": [
                "device_type=none",
                "os=Mac-15.7|Mac-26.6",
                "cpu=arm64"
            ],
            "gclient_variables": {
                "download_android_deps": false,
                "use_rbe": true,
                "download_bazelisk": true
            },
            "gn": [
                "--runtime-mode",
                "debug",
                "--prebuilt-dart-sdk",
                "--no-lto",
                "--target-dir",
                "ci/mac_host_debug_clang_tidy_1",
                "--mac-cpu",
                "arm64",
                "--no-rbe",
                "--no-goma",
                "--xcode-symlinks",
                "--bazel"
            ],
            "name": "ci/mac_host_debug_clang_tidy_1",
            "description": "A debug mode macOS host build (the second of two drones) used only as the basis for a clang-tidy run, which runs as its test step.",
            "ninja": {
                "config": "ci/mac_host_debug_clang_tidy_1"
            },
            "properties": {
                "$flutter/osx_sdk": {
                    "sdk_version": "17c52"
                }
            },
            "tests": [
                {
                    "name": "test: lint host_debug 1",
                    "script": "flutter/ci/clang_tidy.sh",
                    "parameters": [
                        "--variant",
                        "ci/mac_host_debug_clang_tidy_1",
                        "--lint-all",
                        "--shard-id=1",
                        "--shard-variants=ci/mac_host_debug_clang_tidy_1"
                    ]
                }
            ]
        },
        {
            "archives": [],
            "cas_archive": false,
            "drone_dimensions": [
                "device_type=none",
                "os=Mac-15.7|Mac-26.6",
                "cpu=arm64"
            ],
            "gclient_variables": {
                "download_android_deps": false,
                "use_rbe": true,
                "download_bazelisk": true
            },
            "gn": [
                "--ios",
                "--runtime-mode",
                "debug",
                "--simulator",
                "--no-lto",
                "--target-dir",
                "ci/ios_debug_sim_clang_tidy",
                "--simulator-cpu",
                "arm64",
                "--no-rbe",
                "--no-goma",
                "--xcode-symlinks",
                "--bazel"
            ],
            "name": "ci/ios_debug_sim_clang_tidy",
            "description": "A debug mode iOS simulator build used only as the basis for a clang-tidy run, which runs as its test step.",
            "ninja": {
                "config": "ci/ios_debug_sim_clang_tidy"
            },
            "properties": {
                "$flutter/osx_sdk": {
                    "sdk_version": "17c52"
                }
            },
            "tests": [
                {
                    "name": "test: lint ios_debug_sim",
                    "script": "flutter/ci/clang_tidy.sh",
                    "parameters": [
                        "--variant",
                        "ci/ios_debug_sim_clang_tidy",
                        "--lint-all"
                    ]
                }
            ]
        }
    ]
