{
    "_comment": [
        "The builds run under Bazel (--bazel among the tools/gn flags; flutter/build/bazel/ci.md), and each",
        "lints itself as linux_clang_tidy.json's do: ci/clang_tidy.sh, run as the build's own test step, makes",
        "the compile database from the build's action graph (tools/gn_to_bazel/tool/compile_commands.py; the",
        "Apple toolchains' remote-compile wrapper resolved to the Mac's clang, where clang-tidy is) and runs",
        "the lint over the whole variant. The database names the drone's own execution root, so GN's tester",
        "drones over a CAS archive -- which re-ran tools/gn for a database of their own -- cannot work here;",
        "the host variant's four shards' work runs on one drone, and the iOS simulator variant lints every",
        "file of its own database rather than its share of the host's intersection."
    ],
    "builds": [
        {
            "archives": [],
            "cas_archive": false,
            "drone_dimensions": [
                "device_type=none",
                "os=Mac-15.7|Mac-26.6",
                "cpu=arm64"
            ],
            "gclient_variables": {
                "download_android_deps": false,
                "use_rbe": true,
                "download_bazelisk": true
            },
            "gn": [
                "--runtime-mode",
                "debug",
                "--prebuilt-dart-sdk",
                "--no-lto",
                "--target-dir",
                "ci/host_debug_clang_tidy",
                "--no-rbe",
                "--no-goma",
                "--xcode-symlinks",
                "--bazel"
            ],
            "name": "ci/host_debug_clang_tidy",
            "description": "A debug mode macOS host build used only as the basis for a clang-tidy run, which runs as its test step.",
            "ninja": {
                "config": "ci/host_debug_clang_tidy"
            },
            "properties": {
                "$flutter/osx_sdk": {
                    "sdk_version": "17c52"
                }
            },
            "tests": [
                {
                    "name": "test: lint host_debug",
                    "script": "flutter/ci/clang_tidy.sh",
                    "parameters": [
                        "--variant",
                        "ci/host_debug_clang_tidy",
                        "--lint-all"
                    ]
                }
            ]
        },
        {
            "archives": [],
            "cas_archive": false,
            "drone_dimensions": [
                "device_type=none",
                "os=Mac-15.7|Mac-26.6",
                "cpu=arm64"
            ],
            "gclient_variables": {
                "download_android_deps": false,
                "use_rbe": true,
                "download_bazelisk": true
            },
            "gn": [
                "--ios",
                "--runtime-mode",
                "debug",
                "--simulator",
                "--no-lto",
                "--target-dir",
                "ci/ios_debug_sim_clang_tidy",
                "--no-rbe",
                "--no-goma",
                "--xcode-symlinks",
                "--bazel"
            ],
            "name": "ci/ios_debug_sim_clang_tidy",
            "description": "A debug mode iOS simulator build used only as the basis for a clang-tidy run, which runs as its test step.",
            "ninja": {
                "config": "ci/ios_debug_sim_clang_tidy"
            },
            "properties": {
                "$flutter/osx_sdk": {
                    "sdk_version": "17c52"
                }
            },
            "tests": [
                {
                    "name": "test: lint ios_debug_sim",
                    "script": "flutter/ci/clang_tidy.sh",
                    "parameters": [
                        "--variant",
                        "ci/ios_debug_sim_clang_tidy",
                        "--lint-all"
                    ]
                }
            ]
        }
    ]
}
