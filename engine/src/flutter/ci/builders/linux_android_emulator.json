{
    "_comment": [
        "The build runs under Bazel (--bazel among the tools/gn flags; flutter/build/bazel/ci.md):",
        "`ninja -C out/ci/android_emulator_debug_x64` runs the build's Bazel install target (the APK) instead",
        "of GN, and run_tests.py --type android runs the three device suites as the build's Bazel suite",
        "(ci/builders/BUILD.bazel: each pushed to the emulator the android_virtual_device context boots",
        "and run there, as run_android_tests does). --variant names the same directory as",
        "--android-variant: run_tests.py's Bazel mode reads the build's bazel.json from every directory named."
    ],
    "builds": [
        {
            "drone_dimensions": [
                "device_type=none",
                "os=Linux",
                "kvm=1",
                "cores=8"
            ],
            "gclient_variables": {
                "use_rbe": true,
                "download_bazelisk": true
            },
            "gn": [
                "--android",
                "--android-cpu=x64",
                "--no-lto",
                "--no-rbe",
                "--target-dir",
                "ci/android_emulator_debug_x64",
                "--bazel"
            ],
            "dependencies": [
                {
                    "dependency": "goldctl",
                    "version": "git_revision:720a542f6fe4f92922c3b8f0fdcc4d2ac6bb83cd"
                },
                {
                    "dependency": "open_jdk",
                    "version": "version:25.0.2"
                }
            ],
            "name": "ci/android_emulator_debug_x64",
            "description": "Build for debug mode x64 Android emulator tests.",
            "ninja": {
                "config": "ci/android_emulator_debug_x64",
                "targets": [
                    "flutter/impeller/renderer/backend/vulkan:vulkan_android_unittests",
                    "flutter/impeller/renderer/backend/vulkan:vulkan_android_apk_unittests",
                    "flutter/impeller/toolkit/android:unittests",
                    "flutter/shell/platform/android:flutter_shell_native_unittests"
                ]
            },
            "tests": [
                {
                    "language": "python3",
                    "name": "Android Unit Tests",
                    "test_dependencies": [
                        {
                            "dependency": "android_virtual_device",
                            "version": "android_37_google_apis_ps16k_x64.textpb"
                        },
                        {
                            "dependency": "avd_cipd_version",
                            "version": "build_id:8669307410622793521"
                        }
                    ],
                    "contexts": [
                        "android_virtual_device"
                    ],
                    "script": "flutter/testing/run_tests.py",
                    "parameters": [
                        "--variant",
                        "ci/android_emulator_debug_x64",
                        "--android-variant",
                        "ci/android_emulator_debug_x64",
                        "--type",
                        "android"
                    ]
                },
                {
                    "language": "dart",
                    "name": "skia_gold_client/e2e_test",
                    "script": "flutter/testing/skia_gold_client/tool/e2e_test.dart",
                    "max_attempts": 1
                }
            ]
        }
    ]
}
