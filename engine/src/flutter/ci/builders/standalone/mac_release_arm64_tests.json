{
    "cas_archive": false,
    "dependencies": [
        {
            "dependency": "goldctl",
            "version": "git_revision:720a542f6fe4f92922c3b8f0fdcc4d2ac6bb83cd"
        }
    ],
    "drone_dimensions": [
        "device_type=none",
        "os=Mac-15.7|Mac-26.6",
        "cpu=arm64"
    ],
    "gclient_variables": {
        "download_android_deps": false,
        "use_rbe": true
    },
    "gn": [
        "--target-dir",
        "ci/mac_release_arm64_tests",
        "--mac",
        "--mac-cpu",
        "arm64",
        "--runtime-mode",
        "release",
        "--no-lto",
        "--prebuilt-dart-sdk",
        "--rbe",
        "--xcode-symlinks",
        "--use-glfw-swiftshader"
    ],
    "name": "ci/mac_release_arm64_tests",
    "description": "Produces release mode arm64 macOS host-side tooling.",
    "ninja": {
        "config": "ci/mac_release_arm64_tests",
        "targets": []
    },
    "tests": [
        {
            "language": "python3",
            "name": "Impeller-golden for host_release",
            "script": "flutter/testing/run_tests.py",
            "parameters": [
                "--variant",
                "ci/mac_release_arm64_tests",
                "--type",
                "impeller-golden"
            ]
        }
    ]
}
