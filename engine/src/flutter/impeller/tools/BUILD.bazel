# Impeller's build tools: the scripts its GN templates run, and the Bazel side
# of args.gni. The templates themselves are //build_defs/impeller.

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

package(default_visibility = ["//visibility:public"])

exports_files(
    [
        "metal_library.py",
        "xxd.py",
    ],
    visibility = ["//build_defs/impeller:__subpackages__"],
)

# The platforms of args.gni's default formulas: Metal on Apple's, OpenGL ES
# and Vulkan on the desktops, Android and the web for GLES (none on Fuchsia,
# which the Bazel build has not got).
selects.config_setting_group(
    name = "metal_platform",
    match_any = [
        "@platforms//os:ios",
        "@platforms//os:macos",
    ],
)

selects.config_setting_group(
    name = "vulkan_platform",
    match_any = [
        "@platforms//os:android",
        "@platforms//os:linux",
        "@platforms//os:macos",
        "@platforms//os:windows",
    ],
)

selects.config_setting_group(
    name = "opengles_platform",
    match_any = [
        "@platforms//os:android",
        "@platforms//os:emscripten",
        "@platforms//os:linux",
        "@platforms//os:macos",
        "@platforms//os:windows",
    ],
)

# GN's impeller_enable_metal, impeller_enable_opengles and
# impeller_enable_vulkan: which rendering backends are built. args.gni derives
# their defaults from the platform (Metal on Apple; OpenGL ES and Vulkan on
# the desktops, Android and QNX, and wherever unit tests run; none on
# Fuchsia) and a build's args may override them. Each is a tri-state flag
# here: `auto`, the default, is GN's formula over the target platform (the
# groups above), `true` and `false` the override -- a platform's own flags may
# set them too, as the wasm platform does (toolchains/emscripten). The
# config_setting the generated files select() on (`:metal`, `:opengles`,
# `:vulkan`) holds for `true` and for `auto` where the formula does. The
# derived arguments (impeller_supports_rendering = any of the three,
# impeller_enable_compute = Vulkan or Metal) need no settings of their own:
# the converter writes them as the select() over these.
[
    (
        string_flag(
            name = "enable_" + backend,
            build_setting_default = "auto",
            values = [
                "auto",
                "true",
                "false",
            ],
        ),
        config_setting(
            name = "enable_" + backend + "_true",
            flag_values = {":enable_" + backend: "true"},
        ),
        config_setting(
            name = "enable_" + backend + "_auto",
            flag_values = {":enable_" + backend: "auto"},
        ),
        selects.config_setting_group(
            name = backend + "_by_default",
            match_all = [
                ":enable_" + backend + "_auto",
                ":" + backend + "_platform",
            ],
        ),
        selects.config_setting_group(
            name = backend,
            match_any = [
                ":enable_" + backend + "_true",
                ":" + backend + "_by_default",
            ],
        ),
    )
    for backend in [
        "metal",
        "opengles",
        "vulkan",
    ]
]

# The GLES 2 shaders' setting: GLES on and not the web (shaders.gni: "wasm
# builds only use GLES3, no need to build GLES2 shaders"), for
# impeller_shaders' GLES 2 backend.
selects.config_setting_group(
    name = "opengles_gles2",
    match_all = [
        ":opengles",
        "//engine/src/flutter/build/bazel:not_wasm",
    ],
)
