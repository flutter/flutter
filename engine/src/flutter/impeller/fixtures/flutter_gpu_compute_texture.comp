// Writes the same triangle as flutter_gpu_compute_triangle.comp, scaled by the
// red channel of a sampled texture. Dispatched as one workgroup.

layout(local_size_x = 3) in;

layout(std430) buffer;

layout(binding = 0) uniform sampler2D scale_texture;

layout(binding = 1) writeonly buffer Vertices {
  vec2 positions[];
}
vertices;

void main() {
  uint index = gl_GlobalInvocationID.x;
  vec2 corner = vec2(index == 1u ? 3.0 : -1.0, index == 2u ? 3.0 : -1.0);
  float scale = textureLod(scale_texture, vec2(0.5), 0.0).r;
  vertices.positions[index] = corner * scale;
}
