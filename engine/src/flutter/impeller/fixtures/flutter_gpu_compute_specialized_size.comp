// Sizes its workgroup with a specialization constant, which shader bundles
// reject.

layout(local_size_x_id = 0) in;

layout(std430, binding = 0) buffer Data {
  uint values[];
}
data;

void main() {
  data.values[gl_GlobalInvocationID.x] += 1u;
}
