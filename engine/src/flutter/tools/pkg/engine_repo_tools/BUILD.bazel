# package:engine_repo_tools: how the engine's Dart tools find the checkout
# (Engine.findWithin). A Dart package with no GN build file; its tests are
# run_tests.py's (--type dart-host).

load("//build_defs/dart:package_test.bzl", "dart_package_test")

package(default_visibility = ["//visibility:public"])

# The library, for the packages and kernel compiles that import it.
# The package as a pub package -- its pubspec and library -- for a
# pub_package_config (felt's, lib/web_ui).
filegroup(
    name = "package",
    srcs = ["pubspec.yaml"] + glob(["lib/**"]),
)

filegroup(
    name = "dart_sources",
    srcs = glob(["lib/**/*.dart"]),
)

dart_package_test(name = "tests")
