# package:git_repo_tools: the git queries of the engine's Dart tools. A Dart
# package with no GN build file; its tests are run_tests.py's
# (--type dart-host).

load("//build_defs/dart:package_test.bzl", "dart_package_test")

package(default_visibility = ["//visibility:public"])

# The package as a pub package -- its pubspec and library -- for a
# pub_package_config (felt's, lib/web_ui).
filegroup(
    name = "package",
    srcs = ["pubspec.yaml"] + glob(["lib/**"]),
)

filegroup(
    name = "dart_sources",
    srcs = glob(["lib/**/*.dart"]),
)

dart_package_test(
    name = "tests",
    deps = ["//engine/src/flutter/tools/pkg/process_fakes:dart_sources"],
)
