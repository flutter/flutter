# package:build_bucket_golden_scraper: a tool over LUCI build logs. A Dart
# package with no GN build file; its tests are run_tests.py's
# (--type dart-host).

load("//build_defs/dart:package_test.bzl", "dart_package_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "dart_sources",
    srcs = glob(["lib/**/*.dart"]) + [
        "//engine/src/flutter/tools/pkg/engine_repo_tools:dart_sources",
    ],
)

dart_package_test(
    name = "tests",
    deps = [":dart_sources"],
)
