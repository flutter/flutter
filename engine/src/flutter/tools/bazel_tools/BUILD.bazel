# package:bazel_tools: the generators and checks that keep the Bazel workspace
# in step with DEPS and the GN build. A Dart package with no GN build file;
# its tests are run_tests.py's (--type dart-host).

load("//build_defs/dart:package_test.bzl", "dart_package_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "dart_sources",
    srcs = glob(["lib/**/*.dart"]),
)

# The tests parse the checkout's DEPS and pubspec.lock and check the
# generated files against them. lib/web_ui's pubspec.lock, the other lock
# pub.lock.bzl mirrors, is not here: the engine's .gitignore ignores every
# *.lock, so it exists only where `pub get` (felt) has run -- the test
# checks it when it is there, under `dart test` in this directory.
dart_package_test(
    name = "tests",
    data = [
        "//:.bazelignore",
        "//:DEPS",
        "//:pubspec.lock",
        "//build_defs/dart:pub.lock.bzl",
        "//build_defs/repositories:deps.lock.bzl",
    ],
)
