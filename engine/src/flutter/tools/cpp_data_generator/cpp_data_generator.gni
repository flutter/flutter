import("//flutter/build/dart/dart.gni")
import("//flutter/common/config.gni")
import("$dart_src/build/dart/dart_action.gni")

template("cpp_data_generator") {
  assert(defined(invoker.input), "Must pass 'input'")
  assert(defined(invoker.cpp_out), "Must pass 'cpp_out'")
  assert(defined(invoker.dart_out), "Must pass 'dart_out'")

  prebuilt_dart_action(target_name) {
    packages = "//flutter/.dart_tool/package_config.json"
    pool = "//build/toolchain:toolchain_pool"

    script = "//flutter/tools/cpp_data_generator/bin/main.dart"

    inputs = [
      "//flutter/tools/cpp_data_generator/lib/cpp_data_generator.dart",
      "//flutter/tools/cpp_data_generator/lib/src/cpp_generator.dart",
      "//flutter/tools/cpp_data_generator/lib/src/dart_generator.dart",
      "//flutter/tools/cpp_data_generator/lib/src/parser.dart",
      invoker.input,
      invoker.cpp_out,
      invoker.dart_out,
    ]

    stamp_file = "$target_gen_dir/$target_name.stamp"
    outputs = [ stamp_file ]

    args = [
      "--input=" + rebase_path(invoker.input, root_build_dir),
      "--cpp-out=" + rebase_path(invoker.cpp_out, root_build_dir),
      "--dart-out=" + rebase_path(invoker.dart_out, root_build_dir),
      "--stamp=" + rebase_path(stamp_file, root_build_dir),
    ]
  }
}
