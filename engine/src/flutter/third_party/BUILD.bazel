# This directory on the include path: GN's `include_dirs = [
# "//flutter/third_party" ]` (tonic's public config, which lets its headers
# be included as "tonic/..."), for the generated BUILD files to depend on
# (the converter's includeDirLibraries). The trees gclient syncs below this
# directory are external repositories, not part of this package.

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build_defs/testing:testing.bzl", "source_tree_files")

cc_library(
    name = "include_dir",
    includes = ["."],
    visibility = ["//engine/src/flutter:__subpackages__"],
)

# GN's //third_party:fontconfig (build/secondary/third_party/BUILD.gn): the
# system fontconfig, linked from the sysroot on Linux and nothing elsewhere.
# Skia's fontmgr_fontconfig and //flutter/txt link it when the fontconfig
# flag (//flutter/txt:use_fontconfig, tools/gn's --enable-fontconfig) is on.
cc_library(
    name = "fontconfig",
    linkopts = select({
        "@platforms//os:linux": ["-lfontconfig"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

# test_shaders/ is part of this repository (not a synced tree): the shaders
# lib/ui's fixtures compile (`//flutter/third_party/test_shaders/selman/...`).
exports_files(
    glob(["test_shaders/**/*.frag"]),
    visibility = ["//engine/src/flutter:__subpackages__"],
)

# Skia's test images (a synced tree, @skia) at their path under the source
# root, flutter/third_party/skia/resources/images/..., which the Dart tests
# of testing/dart read from that root as run_tests.py runs them.
source_tree_files(
    name = "skia_resources",
    trees = {"@skia//:resources_images": "skia"},
    visibility = ["//engine/src/flutter/testing:__subpackages__"],
)

# The two Dart packages of this directory the web SDK rewrites into
# dart:_web_test_fonts and dart:_web_locale_keymap (web_sdk/BUILD.gn's
# sdk_rewriter invocations; the converter's directorySources names the
# filegroups): each library's sources and its API file.
filegroup(
    name = "web_test_fonts_sources",
    srcs = glob(["web_test_fonts/lib/web_test_fonts/**/*.dart"]),
    visibility = ["//engine/src/flutter/web_sdk:__pkg__"],
)

filegroup(
    name = "web_locale_keymap_sources",
    srcs = glob(["web_locale_keymap/lib/web_locale_keymap/**/*.dart"]),
    visibility = ["//engine/src/flutter/web_sdk:__pkg__"],
)

# The same two as pub packages -- each pubspec and library -- for the web
# engine's unit tests, which import them (lib/web_ui's pubspec).
filegroup(
    name = "web_test_fonts_package",
    srcs = ["web_test_fonts/pubspec.yaml"] + glob(["web_test_fonts/lib/**"]),
    visibility = ["//engine/src/flutter/lib/web_ui:__pkg__"],
)

filegroup(
    name = "web_locale_keymap_package",
    srcs = ["web_locale_keymap/pubspec.yaml"] + glob(["web_locale_keymap/lib/**"]),
    visibility = ["//engine/src/flutter/lib/web_ui:__pkg__"],
)

exports_files(
    [
        "web_locale_keymap/lib/web_locale_keymap.dart",
        "web_test_fonts/lib/web_test_fonts.dart",
    ],
    visibility = ["//engine/src/flutter/web_sdk:__pkg__"],
)
