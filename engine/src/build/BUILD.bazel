# The engine's GN build configuration (//build in GN). Nothing here is used
# by Bazel's own toolchains; the files are inputs of the rules that wrap a GN
# build of part of the tree. The Debian sysroots that live under linux/ are
# repositories of their own and are listed in .bazelignore.

filegroup(
    name = "gn_files",
    srcs = glob(
        ["**"],
        exclude = [
            # Bazel's own files are not GN inputs.
            "**/BUILD.bazel",
            "**/*.bzl",
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
    visibility = ["//engine/src/flutter/build/bazel:__subpackages__"],
)

# The Android build scripts GN's android toolchain inherited from Chromium
# (android/gyp), which the Android embedding's actions run
# (shell/platform/android/BUILD.gn): the Java compile and jar packaging.
exports_files([
    "android/gyp/create_flutter_jar.py",
    "android/gyp/javac.py",
])

# What the scripts of android/gyp import (their util/ package, jar.py,
# md5_check.py), for the actions that run them.
filegroup(
    name = "android_gyp_scripts",
    srcs = glob(["android/gyp/**/*.py"]),
    visibility = ["//visibility:public"],
)
