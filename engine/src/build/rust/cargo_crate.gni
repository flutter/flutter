import("//build/rust/config.gni")

# Default config lists expected by third-party BUILD.gn files generated by
# Chromium's `gnrt` tool under //third_party/rust/.
library_configs = [
  "//build/config/coverage:default_coverage",
  "//build/config/compiler:chromium_code",
]
executable_configs = [
  "//build/config/coverage:default_coverage",
  "//build/config/compiler:chromium_code",
]
proc_macro_configs = [
  "//build/config/coverage:default_coverage",
  "//build/config/compiler:chromium_code",
]

# Defines a Rust Cargo crate target (rlib, proc-macro, or binary executable).
#
# This template is compatible with third-party crate BUILD.gn definitions under
# //third_party/rust/ as well as in-tree Rust crates. Every crate is compiled
# against the source-built standard library in //build/rust/std.
#
# Parameters:
#
#   crate_type (required)
#     [string] One of "rlib", "proc-macro", or "bin".
#
#   crate_root (required)
#     [path] The root .rs source file of the crate (e.g. "src/lib.rs").
#
#   sources (required)
#     [list of paths] All Rust source files belonging to this crate.
#
#   crate_name (optional)
#     [string] Override the crate name passed to `--crate-name`. Defaults to
#     `target_name`.
#
#   edition (optional)
#     [string] Rust edition (e.g. "2018", "2021", "2024").
#
#   features (optional)
#     [list of strings] Cargo features to enable via `--cfg=feature="..."`.
#
#   deps (optional)
#     [list of labels] Rust or native dependencies for this crate.
#
#   inputs (optional)
#     [list of paths] Additional non-source input files (e.g. included via
#     `include_str!` or `include_bytes!`).
#
#   rustenv (optional)
#     [list of strings] Additional `KEY=VALUE` environment variables passed to
#     `rustc`.
#
#   cargo_pkg_name, cargo_pkg_version (optional)
#     [string] Package metadata exposed via `CARGO_PKG_*` environment variables.
#
# Example usage:
#
#   import("//build/rust/cargo_crate.gni")
#
#   cargo_crate("my_crate") {
#     crate_type = "rlib"
#     crate_root = "src/lib.rs"
#     sources = [ "src/lib.rs" ]
#     edition = "2021"
#     features = [ "std" ]
#     deps = [ "//third_party/rust/serde/v1:lib" ]
#   }
template("cargo_crate") {
  not_needed(invoker, "*")

  # Procedural macros execute on the host during compilation, so redirect any
  # target-toolchain dependency on a proc-macro crate to the host toolchain.
  if (invoker.crate_type == "proc-macro" && current_toolchain != host_toolchain) {
    group(target_name) {
      public_deps = [ ":$target_name($host_toolchain)" ]
    }
  } else {
    _crate_name = target_name
    if (defined(invoker.crate_name)) {
      _crate_name = invoker.crate_name
    }

    # Point rustc at our per-toolchain local sysroot populated by //build/rust/std.
    _rustflags = [
                   "--cap-lints=allow",
                   "--sysroot=$rebased_local_rustc_sysroot",
                 ] + rust_mode_flags

    if (defined(invoker.edition)) {
      _rustflags += [ "--edition=${invoker.edition}" ]
    }
    if (defined(invoker.features)) {
      foreach(f, invoker.features) {
        _rustflags += [ "--cfg=feature=\"$f\"" ]
      }
    }

    # `proc_macro2` normally runs a Cargo build.rs script to detect whether the
    # toolchain's `proc_macro` crate is available; pass those flags directly.
    if (_crate_name == "proc_macro2") {
      _rustflags += [
        "--cfg=wrap_proc_macro",
        "--cfg=span_locations",
        "--extern",
        "proc_macro",
      ]
    }

    _pkg_version = "1.0.205"
    if (defined(invoker.cargo_pkg_version)) {
      _pkg_version = invoker.cargo_pkg_version
    }
    _pkg_name = _crate_name
    if (defined(invoker.cargo_pkg_name)) {
      _pkg_name = invoker.cargo_pkg_name
    }
    _out_dir = rebase_path(target_gen_dir)

    # `serde_core` includes `$OUT_DIR/private.rs` which is normally generated by
    # its Cargo build.rs script using the package patch version.
    if (_crate_name == "serde_core") {
      write_file(
          "$target_gen_dir/private.rs",
          [
            "#[doc(hidden)]",
            "pub mod __private205 {",
            "    #[doc(hidden)]",
            "    pub use crate::private::*;",
            "}",
          ])
    }
    _rustenv = [
      "OUT_DIR=$_out_dir",
      "CARGO_PKG_VERSION=$_pkg_version",
      "CARGO_PKG_VERSION_MAJOR=1",
      "CARGO_PKG_VERSION_MINOR=0",
      "CARGO_PKG_VERSION_PATCH=205",
      "CARGO_PKG_NAME=$_pkg_name",
      "CARGO_PKG_AUTHORS=flutter",
      "CARGO_PKG_DESCRIPTION=flutter",
      "CARGO_PKG_REPOSITORY=flutter",
    ]
    if (defined(invoker.rustenv)) {
      _rustenv += invoker.rustenv
    }

    # Depend on //build/rust/std and list libstd.rlib as an explicit Ninja input
    # so this crate waits for the sysroot copy step to finish before compiling.
    _deps = [ "//build/rust/std" ]
    if (defined(invoker.deps)) {
      _deps += invoker.deps
    }

    _inputs = [ "$local_rustc_sysroot_lib_dir/libstd.rlib" ]
    if (defined(invoker.inputs)) {
      _inputs += invoker.inputs
    }

    if (invoker.crate_type == "proc-macro") {
      rust_proc_macro(target_name) {
        crate_name = _crate_name
        crate_root = invoker.crate_root
        sources = invoker.sources
        inputs = _inputs
        deps = _deps
        rustflags = _rustflags
        rustenv = _rustenv
      }
    } else if (invoker.crate_type == "rlib") {
      rust_library(target_name) {
        crate_name = _crate_name
        crate_root = invoker.crate_root
        sources = invoker.sources
        inputs = _inputs
        deps = _deps
        rustflags = _rustflags
        rustenv = _rustenv
      }
    } else if (invoker.crate_type == "bin") {
      executable(target_name) {
        crate_name = _crate_name
        crate_root = invoker.crate_root
        sources = invoker.sources
        inputs = _inputs
        deps = _deps
        # Prevent BUILDCONFIG.gn's `executable` wrapper from injecting C++
        # `//flutter/third_party/libcxx` (compiled with LTO bitcode) into pure
        # Rust host binaries like `cxxbridge`.
        no_default_deps = true
        rustflags = _rustflags
        rustenv = _rustenv
      }
    }
  }
}
