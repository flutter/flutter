# The engine's source root (GN's `//`).

load("@rules_cc//cc:defs.bzl", "cc_library")

# Puts this directory on the include path. Engine code includes its own
# headers and most dependencies relative to it ("flutter/fml/...",
# "third_party/skia/..."). This is GN's
# //build/config/compiler:default_include_dirs (`-I//`), which
# BUILDCONFIG.gn applies to every target; the generated BUILD files depend
# on it from every target that compiles, and //engine/src/flutter:config
# (GN's //flutter:config, `include_dirs = [ "..", "." ]`) reaches it too.
#
# The trees gclient syncs are external repositories here, not directories
# under this root, so the one that engine code includes by its path under
# the root ("flutter/third_party/skia/...") is carried along under that
# path.
cc_library(
    name = "include_root",
    includes = ["."],
    visibility = ["//engine/src/flutter:__subpackages__"],
    deps = ["@skia//:engine_root_headers"],
)

# GN's root files: the dotfile and the build_overrides it names. Inputs of
# the rules that wrap a GN build of part of this tree.
filegroup(
    name = "gn_root_files",
    srcs = [".gn"] + glob(["build_overrides/**"]),
    visibility = ["//engine/src/flutter/build/bazel:__subpackages__"],
)
