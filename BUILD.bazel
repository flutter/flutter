# The repository root as a Bazel package: the files of the gclient checkout
# that tests of the engine's Dart tools read (testing/run_tests.py
# --type dart-host, build/bazel/dart/package_test.bzl) -- DEPS and the
# .bazelignore generated from it (tools/bazel_tools' tests check the
# generation), and .gclient, which `et fetch` locates to run gclient from
# its directory (tools/engine_tool's tests). .gclient is the checkout's own,
# written by `gclient config`, not a file of the repository.

exports_files([
    ".bazelignore",
    ".gclient",
    "DEPS",
])
