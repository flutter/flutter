# The repository root as a Bazel package: the files of the gclient checkout
# that tests of the engine's Dart tools read (testing/run_tests.py
# --type dart-host, build_defs/dart/package_test.bzl) -- DEPS and the
# .bazelignore generated from it (tools/bazel_tools' tests check the
# generation), and .gclient, which `et fetch` locates to run gclient from
# its directory (tools/engine_tool's tests). .gclient is the checkout's own,
# written by `gclient config`, not a file of the repository.

exports_files([
    ".bazelignore",
    ".gclient",
    "DEPS",
    # The pub workspace's resolution, which `flutter create` reads to pin a new
    # project's dependencies (flutter_tools' tests run it).
    "pubspec.lock",
    "pubspec.yaml",
    # The directories flutter_tools' create_test creates a project in, which
    # the SDK facsimile its tests run from must hold (one file each).
    "dev/README.md",
    "examples/README.md",
    # The repository's license, which the tool's cache copies into the iOS
    # engine directories (the facsimile's ios_engine_*_directory).
    "LICENSE",
])

# The repository's Dart and framework tests that Bazel compiles and runs
# (build_defs/dart/flutter_test.bzl, dart_test.bzl; the
# README in build/bazel), gathered as dev/bots' framework_tests and
# flutter_tools_tests shards run them: every tree that runs on a Linux host
# without a device, a browser, Android's or the desktop's toolchains.
#
#   bazel test //:framework_tests //:tool_tests //:dart_tests
#   bazel test //:framework_tests_impeller
test_suite(
    name = "framework_tests",
    tests = [
        "//dev/benchmarks/test_apps/stocks/test:tests",
        "//dev/integration_tests/flutter_gallery/test:tests",
        "//dev/integration_tests/ui/test:tests",
        "//dev/manual_tests/test:tests",
        "//dev/tools/vitool/test:tests",
        "//dev/tracing_tests/test:tests",
        "//examples/hello_world/test:tests",
        "//examples/layers/test:tests",
        "//examples/multiple_windows/test:tests",
        "//examples/platform_channel/test:tests",
        "//examples/splash/test:tests",
        "//examples/texture/test:tests",
        "//packages/flutter/examples/api/test:tests",
        "//packages/flutter/test:all",
        "//packages/flutter/test/widgets:widgets_without_creation_locations",
        "//packages/flutter/test_profile:tests",
        "//packages/flutter/test_release:tests",
        "//packages/flutter_driver/test:tests",
        "//packages/flutter_goldens/test:tests",
        "//packages/flutter_localizations/test:tests",
        "//packages/flutter_test/test:tests",
        "//packages/integration_test/test:tests",
    ],
)

# packages/flutter's tests once more rendering with Impeller
# (`flutter test --enable-impeller`).
test_suite(
    name = "framework_tests_impeller",
    tests = ["//packages/flutter/test:all_impeller"],
)

# flutter_tools' unit tests, command tests, integration tests, desktop
# tests and web tests (the last three run the tool itself from the tests'
# SDK facsimile, which holds the engine in its three runtime modes and the
# web SDK: the first build is three builds of the engine and one of the web
# engine; the desktop tests build Linux apps with CMake, GTK and clang from
# the build on an X display of their own; the web tests drive the pinned
# Chrome for Testing, @chrome).
test_suite(
    name = "tool_tests",
    tests = [
        "//packages/flutter_tools:commands_shard_hermetic",
        "//packages/flutter_tools:commands_shard_permeable",
        "//packages/flutter_tools:desktop_shard",
        "//packages/flutter_tools:general_shard",
        "//packages/flutter_tools:integration_shard",
        "//packages/flutter_tools:web_shard",
    ],
)

# flutter_tools' Android tests: `flutter build apk|appbundle|aar` through
# the tool, with the engine's Android artifacts from the build -- the engine
# for three CPUs in three modes, hours the first time -- the checkout's SDK
# and the engine's JDK, and Gradle's downloads from the network (by
# decision; packages/flutter_tools/BUILD.bazel says why). A suite of its
# own, for that first build and that network.
test_suite(
    name = "android_tool_tests",
    tests = ["//packages/flutter_tools:android_shard"],
)

# flutter_tools' Apple tests: `flutter build macos|ios`, Swift Package
# Manager and the Xcode project migrations through the tool on a Mac host,
# with the universal FlutterMacOS.xcframework and gen_snapshots and the iOS
# Flutter.xcframework from the build -- the macOS shell for both CPUs and
# the iOS shell for the device and both simulators, each in three modes with
# their Dart wraps: hours the first time -- Xcode, CocoaPods and the
# simulators from the host, outside Bazel's sandbox (xcodebuild runs
# sandbox-exec itself), and the network (the pod specs, pub). A suite of its
# own for that; compatible with macOS alone, skipped elsewhere
# (packages/flutter_tools/BUILD.bazel's apple_shard; NEED_DECISION Q31).
test_suite(
    name = "apple_tool_tests",
    tests = ["//packages/flutter_tools:apple_shard"],
)

# The pure-Dart packages' tests (package:test's runner on the VM).
test_suite(
    name = "dart_tests",
    tests = [
        "//dev/bots:tests",
        "//dev/devicelab:tests",
        "//dev/flutter_analyzer_plugin:tests",
        "//dev/packages_autoroller:tests",
        "//dev/snippets:tests",
        "//dev/tools:tests",
        "//dev/tools/gen_defaults:tests",
        "//dev/tools/gen_keycodes:tests",
        "//packages/fuchsia_remote_debug_protocol:tests",
    ],
)
