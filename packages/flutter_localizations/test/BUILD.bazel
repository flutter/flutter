# flutter_localizations' tests under Bazel: each *_test.dart compiled by the
# frontend server from a prelude kernel and run on the Bazel-built
# flutter_tester, as `flutter test` runs it
# (//packages/flutter_test:package_tests.bzl; research/15).
#
#   bazel test //packages/flutter_localizations/test:tests

load("//packages/flutter_test:package_tests.bzl", "FRAMEWORK_IMPORTS", "flutter_package_tests")

package(default_visibility = ["//visibility:public"])

flutter_package_tests(
    name = "tests",
    srcs = glob(
        ["**/*.dart"],
        exclude = ["**/*_test.dart"],
    ),
    # The translation tests read the package's .arb files.
    data = ["//packages/flutter_localizations:sources"],
    imports = FRAMEWORK_IMPORTS + ["package:flutter_localizations/flutter_localizations.dart"],
    package = "flutter_localizations",
    tests = glob(["**/*_test.dart"]),
)
