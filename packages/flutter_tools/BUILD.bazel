    tags = [
        "cpu:4",
        "resources:memory:10240",
    ],
    tests = _INTEGRATION_ANDROID,
    tools = [":android_build_tools"],
    # pub touches the workspace's lock when it resolves a member.
    writable = ["pubspec.lock"],
)

