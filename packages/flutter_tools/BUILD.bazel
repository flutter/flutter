# The Android shard: the integration shard's files that build an app, a
# plugin or a module for Android through the tool (_INTEGRATION_ANDROID) --
# `flutter create` and `flutter build apk|appbundle|aar` in every mode, the
# Gradle plugin's own tests -- from the facsimile with the engine's Android
# artifacts, the checkout's SDK and the engine's JDK.
#
# These tests reach the network, by decision (10-26): Gradle fetches its
# distribution, the Android Gradle plugin, Kotlin and the libraries an app
# depends on from Google's and Maven Central's repositories at build time
# -- nothing of that is in the checkout, and a pinned mirror of it would be
# a gigabyte, an order of magnitude beyond the Java tests' Maven lock
# (build_defs/java). The engine itself does not come from the network: its
# artifacts are the build's, served to Gradle from a file: URL. Each test
# downloads into a Gradle home of its own under TEST_TMPDIR (the tool's
# HOME is the test's), so the first minutes of each are Gradle's, and their
# timing and reliability depend on the network.
dart_package_tests(
    name = "android_shard",
    size = "enormous",
    srcs = _HARNESS,
    cache = _TOOL_CACHE,
    # (The Android gen_snapshots come from the tree under either
    # configuration for now: bin/cache's, `flutter precache --android`, is a
    # later step.)
    cache_files = select({
        "//build_defs/engine:prebuilt": _TOOL_CACHE_FILES_BASE | _ANDROID_CACHE_FILES,
        "//conditions:default": _TOOL_CACHE_FILES_BASE | _TREE_ENGINE_CACHE_FILES | _PUB_FILES | _ANDROID_CACHE_FILES,
    }),
    data = glob(["test/integration.shard/test_data/**"]) + _SDK_PACKAGES + _TOOL_DATA + _INTEGRATION_PROJECTS + [
        # analyze_size_test builds hello_world for Android.
        "//examples/hello_world:project",
    ],
    # The one file with a timeout of its own (`@Timeout(Duration(minutes:
    # 5))`): its app bundle build takes four and a half minutes on a machine
    # of its own and overran the five with three other Gradle builds beside
    # it (10-30); a retry lands after they finish.
    flaky = ["test/integration.shard/deferred_components_assets_reproduce_test.dart"],
    imports = _IMPORTS,
    # Gradle's downloads: see above.
    network = True,
    package = "flutter_tools",
    packages = _PACKAGES,
    pub_cache = ":workspace_pub_cache",
    sdk_files = _TOOL_SDK_FILES,
    sdk_trees = {"@pub_workspace//:pubspecs": ""},
    # The tool, a Gradle daemon (the template's gradle.properties allows it
    # 8 GB), a Kotlin daemon and the dex compiler at once: four cores and
