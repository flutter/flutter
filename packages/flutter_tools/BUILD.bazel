# The integration shard's tests run pub in workspace members (hello_world,
# dev/automated_tests), and pub resolves a member against the whole
# workspace: every member's pubspec is in the facsimile (@pub_workspace),
# and the cache holds every hosted package the workspace reaches.
pub_cache(
    name = "workspace_pub_cache",
    dev_roots = PUB_WORKSPACE_PACKAGES,
    roots = PUB_WORKSPACE_PACKAGES,
)

# The integration shard: the tool run as a process on projects of its own --
# hot reload and restart on flutter_tester, the daemon, the debug adapter,
# `flutter test`, `flutter analyze`, gen-l10n -- from the facsimile with the
# tool in it (dev/bots runs it on one core from a bootstrapped checkout).
dart_package_tests(
    name = "integration_shard",
    size = "large",
    srcs = _HARNESS,
    # The widget previewer's tests drive a headless Chrome.
    browser = "@chrome//:chrome-linux64/chrome",
    browser_files = ["@chrome//:chrome"],
    cache = _TOOL_CACHE,
    cache_files = _TOOL_CACHE_FILES,
    data = glob(["test/integration.shard/test_data/**"]) + _SDK_PACKAGES + _TOOL_DATA + _INTEGRATION_PROJECTS,
    # Each waits a minute or two of its own -- for `flutter run` to report
    # the VM service, for the widget previewer's first load -- which a loaded
    # machine overruns (a fresh project's resolution and compile come first).
    flaky = [
        "test/integration.shard/disable_service_origin_check_test.dart",
        "test/integration.shard/widget_preview_detection_test.dart",
        "test/integration.shard/widget_preview_machine_test.dart",
        "test/integration.shard/widget_preview_smoke_test.dart",
    ],
    imports = _IMPORTS,
    network = True,
    package = "flutter_tools",
    packages = _PACKAGES,
    pub_cache = ":workspace_pub_cache",
    sdk_files = _TOOL_SDK_FILES,
    sdk_trees = {"@pub_workspace//:pubspecs": ""},
    # The longest: many hot reloads, the debug adapter's whole protocol, web
    # builds and the widget previewer (a web app in a browser).
    sizes = {
        "test/integration.shard/break_on_framework_exceptions_test.dart": "enormous",
        "test/integration.shard/debug_adapter/flutter_adapter_test.dart": "enormous",
        "test/integration.shard/expression_evaluation_test.dart": "enormous",
        "test/integration.shard/web_plugin_registrant_test.dart": "enormous",
        "test/integration.shard/widget_preview_detection_test.dart": "enormous",
        "test/integration.shard/widget_preview_machine_test.dart": "enormous",
        "test/integration.shard/widget_preview_smoke_test.dart": "enormous",
    },
    # Each test runs the tool, a frontend server and flutter_tester or a
    # browser at once: four cores' worth, so that a loaded machine does not
    # overrun the waits the tests keep for themselves.
    tags = ["cpu:4"],
    tests = glob(
        ["test/integration.shard/**/*_test.dart"],
        exclude = _INTEGRATION_EXCLUDED,
    ),
    # pub touches the workspace's lock when it resolves a member.
    writable = ["pubspec.lock"],
)

# The web shard: the tool's web support run as a process -- `flutter run -d
# chrome` and `-d web-server`, hot reload and restart on the web, the DDC
# library bundle's expression evaluation, the web driver service -- against
# the pinned Chrome for Testing and its chromedriver (dev/bots'
# web_tool_tests shard, whose builders carry the same `chrome_and_driver`).
dart_package_tests(
    name = "web_shard",
    size = "enormous",
    srcs = _HARNESS,
    browser = "@chrome//:chrome-linux64/chrome",
    # The web-server device's tests connect a browser through `chromedriver`
    # on PATH.
    browser_driver = "@chrome//:chromedriver-linux64/chromedriver",
    browser_files = ["@chrome//:chrome"],
    cache = _TOOL_CACHE,
    cache_files = _TOOL_CACHE_FILES,
    data = glob(["test/web.shard/test_data/**"]) + _SDK_PACKAGES + _TOOL_DATA + _INTEGRATION_PROJECTS,
    imports = _IMPORTS,
    network = True,
    package = "flutter_tools",
    packages = _PACKAGES,
    pub_cache = ":workspace_pub_cache",
    sdk_files = _TOOL_SDK_FILES,
    sdk_trees = {"@pub_workspace//:pubspecs": ""},
    # The tool, a frontend server, a web server and a browser at once.
    tags = ["cpu:4"],
    tests = glob(["test/web.shard/**/*_test.dart"]),
    # pub touches the workspace's lock when it resolves a member.
    writable = ["pubspec.lock"],
)
