# flutter_tools' sources and its tests under Bazel: each test compiled by
# the frontend server for the VM and run by package:test's precompiled
# runner from this directory, as `dart test` runs them
# (build_defs/dart/dart_test.bzl; research/15).
#
#   bazel test //packages/flutter_tools:general_shard

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load(
    "@host_platform//:host.bzl",
    "HOST_CPU",
    "HOST_DART_SDK",
    "HOST_OS",
)
load("//build_defs/android:build_tools.bzl", "android_build_tools")
load("//build_defs/dart:dart_test.bzl", "dart_package_tests", "dart_vm_kernel")
load("//build_defs/dart:pub.bzl", "PUB_WORKSPACE_PACKAGES", "pub_cache", "pub_package_config")
load("//build_defs/desktop:build_tools.bzl", "linux_build_tools")
load("//build_defs/repositories:flutter_sdk_cache.bzl", "IOS_USB_ARTIFACTS", "ios_usb_repository")
load("//build_defs/web:browser_launcher.bzl", "browser_launcher", "display_launcher")

package(default_visibility = ["//visibility:public"])

# The tool: its libraries and entry points, and what it reads of its own
# tree at run time (the templates it copies, the Gradle scripts, the
# analysis options it ships, package:test's configuration for its tests).
# Not the state a Gradle build of gradle/ (the Flutter Gradle plugin, an
# included build of every app's) leaves there: what gradle/.gitignore names
# and Gradle's and Kotlin's own directories -- read-only in the sandbox,
# they would break the next build's locks.
filegroup(
    name = "sources",
    srcs = glob(
        [
            "bin/**",
            "gradle/**",
            "ide_templates/**",
            "lib/**",
            "static/**",
            "templates/**",
            "tool/**",
        ],
        exclude = [
            "gradle/.gradle/**",
            "gradle/.kotlin/**",
            "gradle/bin/**",
            "gradle/build/**",
            "gradle/gradle/**",
            "gradle/gradlew",
            "gradle/gradlew.bat",
        ],
    ) + [
        "analysis_options.yaml",
        "dart_test.yaml",
        "pubspec.yaml",
    ],
)

# The test harness (test/src), which dev/bots' tests import too
# (fake_process_manager.dart).
filegroup(
    name = "test_harness",
    srcs = glob(["test/src/**/*.dart"]),
)

# The tool's own packages beside it.
_PACKAGES = {
    "//packages/flutter_tools/packages/flutter_tools_core:sources": "flutter_tools_core",
    "//packages/flutter_tools/packages/flutter_tools_extension:sources": "flutter_tools_extension",
    "//packages/flutter_tools/packages/flutter_tools_extension_linux_prototype:sources": "flutter_tools_extension_linux_prototype",
}

# The test harness (test/src) and every helper beside a test, whichever
# shard's: the shards import each other's (the harness imports the
# integration shard's test_utils.dart, the commands shard's build_ipa_test
# the general shard's xcresult_test_data.dart).
_HARNESS = glob(
    ["test/**/*.dart"],
    exclude = ["test/**/*_test.dart"],
)

# What the tests read of the SDK's cache under FLUTTER_ROOT: the Dart SDK
# (cache_test reads DevTools' version from its resources) and the engine
# stamp the tool's bootstrap writes (version_test) -- the fixed-word set
# here, where no engine artifact is laid (bin/internal/BUILD.bazel); the
# facsimiles with the engine's directories take the versioned set below.
_CACHE = {
    HOST_DART_SDK + "//:dart": "dart-sdk",
    HOST_DART_SDK + "//:devtools": "dart-sdk",
}

_CACHE_FILES = {
    "//bin/internal:engine_stamp": "engine.stamp",
    "//bin/internal:engine_stamp_json": "engine_stamp.json",
    "//bin/internal:engine_stamp_stamp": "engine_stamp.stamp",
}

# For the tests that run the real pub on a project of their own (the
# widget_preview tests' projects depend on `flutter`, `flutter_localizations`
# and `flutter_test` from the SDK): pub's view of the SDK -- its version file,
# the packages under FLUTTER_ROOT/packages, the engine's sky_engine package
# under bin/cache/pkg (the analyzer reads dart:ui from it) -- and a pub cache
# of the hosted packages they reach.
# The tree's package is a directory artifact (one entry of `cache_files`);
# bin/cache's, under --config=prebuilt_engine, is its files, laid through
# `cache` (flutter_bin_cache.bzl).
_PUB_FILES = {
    "//engine/src/flutter/sky/packages/sky_engine:package": "pkg/sky_engine",
}

_PREBUILT_PUB_CACHE = {
    "@flutter_bin_cache//pkg/sky_engine:package": "pkg/sky_engine",
}

_PUB_CACHE_FILES_BASE = _CACHE_FILES | {
    "//bin/internal:flutter_version_json": "flutter.version.json",
}

_PUB_CACHE_FILES = select({
    "//build_defs/engine:prebuilt": _PUB_CACHE_FILES_BASE,
    "//conditions:default": _PUB_CACHE_FILES_BASE | _PUB_FILES,
})

# The same with the engine's revision in the stamps and the version file,
# for a facsimile that carries the engine's directories: the revision the
# build stamps into them.
_VERSIONED_CACHE_FILES = {
    "//bin/internal:versioned_engine_stamp": "engine.stamp",
    "//bin/internal:versioned_engine_stamp_json": "engine_stamp.json",
    "//bin/internal:versioned_engine_stamp_stamp": "engine_stamp.stamp",
    "//bin/internal:versioned_flutter_version_json": "flutter.version.json",
}

# The Gradle wrapper `flutter create` copies into an Android project.
_PUB_CACHE_BASE = _CACHE | {"@gradle_wrapper//:wrapper": "artifacts/gradle_wrapper"}

_PUB_CACHE = select({
    "//build_defs/engine:prebuilt": _PUB_CACHE_BASE | _PREBUILT_PUB_CACHE,
    "//conditions:default": _PUB_CACHE_BASE,
})

_SDK_PACKAGES = [
    "//:pubspec.lock",
    "//:pubspec.yaml",
    "//packages/flutter:sources",
    "//packages/flutter_driver:sources",
    "//packages/flutter_goldens:sources",
    "//packages/flutter_localizations:sources",
    "//packages/flutter_test:sources",
    "//packages/flutter_web_plugins:sources",
    "//packages/fuchsia_remote_debug_protocol:sources",
    "//packages/integration_test:sources",
]

# The hosted packages those projects reach: the SDK packages' dependencies
# and what `flutter create`'s templates (a plugin's example depends on
# integration_test and plugin_platform_interface) and the widget preview
# scaffold add (pub asks pub.dev for the versions that exist and downloads
# what the cache lacks -- webview_flutter_web is not in the workspace's lock).
pub_cache(
    name = "framework_pub_cache",
    roots = [
        "cupertino_icons",
        "dtd",
        "flutter",
        "flutter_driver",
        "flutter_goldens",
        "flutter_lints",
        "flutter_localizations",
        "flutter_test",
        "flutter_web_plugins",
        "integration_test",
        "plugin_platform_interface",
        "stack_trace",
        "url_launcher",
        "webview_flutter",
    ],
)

# The tests that run the analyzer over whole projects take minutes on a
# loaded machine.
_LARGE_HERMETIC = [
    "test/commands.shard/hermetic/widget_preview/preview_code_generator_test.dart",
    "test/commands.shard/hermetic/widget_preview/preview_detector/preview_detector_test.dart",
    "test/commands.shard/hermetic/widget_preview/preview_detector/preview_detector_workspace_test.dart",
]

# The tool itself, for the tests that run it (create_test analyzes, resolves
# and tests the projects it creates through bin/cache/flutter_tools.snapshot;
# icon_tree_shaker_test spawns bin/flutter): its entry point compiled for the
# VM, as the SDK's shell script compiles it on the first run, and launchers
# in place of bin/flutter and bin/dart -- the repository's scripts would
# bootstrap the tool from git and the network before running it.
pub_package_config(
    name = "tool_package_config",
    out = "tool_package_config.json",
    packages = {":sources": "flutter_tools"} | _PACKAGES,
    roots = ["flutter_tools"],
)

dart_vm_kernel(
    name = "flutter_tools_snapshot",
    out = "flutter_tools.snapshot",
    main = "bin/flutter_tools.dart",
    package_config = ":tool_package_config",
)

write_file(
    name = "flutter_launcher",
    out = "flutter_launcher.sh",
    content = [
        "#!/bin/bash",
        "# bin/flutter of the tests' SDK facsimile: the tool as Bazel compiled it",
        "# (packages/flutter_tools/BUILD.bazel), run as bin/internal/shared.sh runs",
        "# the snapshot it builds -- after the bootstrap hook shared.sh honours.",
        "set -e",
        "root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"",
        "if [ -f \"$root/bin/internal/bootstrap.sh\" ]; then source \"$root/bin/internal/bootstrap.sh\"; fi",
        "exec \"$root/bin/cache/dart-sdk/bin/dart\" --disable-dart-dev " +
        "--packages=\"$root/packages/flutter_tools/.dart_tool/package_config.json\" " +
        "\"$root/bin/cache/flutter_tools.snapshot\" \"$@\"",
        "",
    ],
    is_executable = True,
)

write_file(
    name = "dart_launcher",
    out = "dart_launcher.sh",
    content = [
        "#!/bin/bash",
        "# bin/dart of the tests' SDK facsimile: the cache's Dart SDK, no bootstrap.",
        "set -e",
        "root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"",
        "exec \"$root/bin/cache/dart-sdk/bin/dart\" \"$@\"",
        "",
    ],
    is_executable = True,
)

# What the tool, run from the facsimile, reads of the cache beyond pub's
# view of it: the host's engine artifacts as `flutter precache --linux --web`
# unpacks them (bundle_directory over the archives a host build uploads, in
# the three runtime modes, and the web SDK's), the stamps Cache.updateAll
# checks before it would download, the Material fonts and the flutter_gpu
# package (the tool checks the directories exist).
# The cache names the host's engine directory as the tool's
# getNameForHostPlatform does on Linux (linux-x64, linux-arm64) and, on a
# Mac of either CPU, darwin-x64 (flutter_cache.dart: `darwin-$arch/
# artifacts.zip` unpacks into darwin-x64 -- "until darwin artifacts are
# universal and moved out of darwin-x64", artifacts.dart); the desktop
# stamp is the host's SDK's (linux-sdk, macos-sdk).
_HOST_ENGINE = "darwin-x64" if HOST_OS == "mac" else HOST_OS + "-" + HOST_CPU

_HOST_SDK_STAMP = {
    "//bin/internal:macos_sdk_stamp": "macos-sdk.stamp",
} if HOST_OS == "mac" else {
    "//bin/internal:linux_sdk_stamp": "linux-sdk.stamp",
}

# The iOS USB dependencies (IosUsbArtifacts: libimobiledevice, libusbmuxd,
# libplist, openssl, libimobiledeviceglue, ios-deploy), universal artifacts
# the tool checks on every host. On Linux it skips their download and writes
# their stamps and empty directories itself (the facsimile's directories are
# the sandbox's, writable); on a Mac it would download them -- and its
# "[1/6] iOS USB Artifact" progress lines break a debug adapter's protocol
# (integration.shard/debug_adapter) -- so there the facsimile lays the
# archives bin/internal/<name>.version pins (flutter_sdk_cache.bzl) with
# their stamps.
_IOS_USB_STAMPS = {
    "//bin/internal:" + artifact.replace("-", "_") + "_stamp": artifact + ".stamp"
    for artifact in IOS_USB_ARTIFACTS
} if HOST_OS == "mac" else {}

_IOS_USB_CACHE = {
    "@" + ios_usb_repository(artifact) + "//:files": "artifacts/" + artifact
    for artifact in IOS_USB_ARTIFACTS
} if HOST_OS == "mac" else {}

# The engine's directories in the facsimile's cache: the tree's archive
# directories (build/archives; tree artifacts, one path each) -- or, under
# --config=prebuilt_engine, bin/cache's own files at their paths
# (flutter_bin_cache.bzl; laid through `cache` with no directory).
_TREE_ENGINE_CACHE_FILES = {
    "//engine/src/flutter/build/archives:host_engine_directory": "artifacts/engine/" + _HOST_ENGINE,
    "//engine/src/flutter/build/archives:host_engine_profile_directory": "artifacts/engine/" + _HOST_ENGINE + "-profile",
    "//engine/src/flutter/build/archives:host_engine_release_directory": "artifacts/engine/" + _HOST_ENGINE + "-release",
    "//engine/src/flutter/build/archives:common_engine_directory": "artifacts/engine/common",
    "//engine/src/flutter/web_sdk:web_sdk_directory": "flutter_web_sdk",
}

_PREBUILT_ENGINE_CACHE = {
    "@flutter_bin_cache//:host_engine": "",
    "@flutter_bin_cache//:host_engine_profile": "",
    "@flutter_bin_cache//:host_engine_release": "",
    "@flutter_bin_cache//:common_engine": "",
    "@flutter_bin_cache//:web_sdk": "",
}

_TOOL_CACHE_FILES_BASE = _VERSIONED_CACHE_FILES | {
    ":flutter_tools_snapshot": "flutter_tools.snapshot",
    # The engine artifacts' storage realm (the checkout's, through
    # @engine_version): a test's tool that downloads an artifact at run
    # time -- the integration shard's `flutter build ios` -- looks under it,
    # as the checkout's tool does; without the file the realm is empty and
    # a presubmit's engine is a 404 in the release bucket.
    "//bin/internal:engine_realm": "engine.realm",
    "//bin/internal:flutter_sdk_stamp": "flutter_sdk.stamp",
    "//bin/internal:flutter_web_sdk_stamp": "flutter_web_sdk.stamp",
    "//bin/internal:font_subset_stamp": "font-subset.stamp",
    "//bin/internal:material_fonts_stamp": "material_fonts.stamp",
    "//bin/internal:gradle_wrapper_stamp": "gradle_wrapper.stamp",
} | _HOST_SDK_STAMP | _IOS_USB_STAMPS

# The facsimile's single files: with the engine's directories from the tree,
# or without them under the prebuilt engine (whose files `cache` lays).
_TOOL_CACHE_FILES = select({
    "//build_defs/engine:prebuilt": _TOOL_CACHE_FILES_BASE,
    "//conditions:default": _TOOL_CACHE_FILES_BASE | _TREE_ENGINE_CACHE_FILES | _PUB_FILES,
})

_TOOL_CACHE_BASE = _PUB_CACHE_BASE | {
    "@material_fonts//:fonts": "artifacts/material_fonts",
    "//build_defs/engine:flutter_gpu": "pkg/flutter_gpu",
} | _IOS_USB_CACHE

_TOOL_CACHE = select({
    "//build_defs/engine:prebuilt": _TOOL_CACHE_BASE | _PREBUILT_PUB_CACHE | _PREBUILT_ENGINE_CACHE,
    "//conditions:default": _TOOL_CACHE_BASE,
})

# The apple shard's facsimile adds the iOS engine artifacts on a Mac host
# (`flutter precache --ios`: artifacts/engine/ios{,-profile,-release} --
# Flutter.xcframework over the device and simulator builds, the extension-
# safe one, gen_snapshot_arm64 -- and the ios-sdk stamp), which only its
# tests ask the tool for (DevelopmentArtifact.iOS): the device and both
# simulator builds of the engine per mode, hours the first time.
# (The iOS engines come from the tree under either configuration for now:
# bin/cache's, `flutter precache --ios`, is a later step.)
_IOS_ENGINE_CACHE_FILES = {
    "//engine/src/flutter/build/archives:ios_engine_directory": "artifacts/engine/ios",
    "//engine/src/flutter/build/archives:ios_engine_profile_directory": "artifacts/engine/ios-profile",
    "//engine/src/flutter/build/archives:ios_engine_release_directory": "artifacts/engine/ios-release",
    "//bin/internal:ios_sdk_stamp": "ios-sdk.stamp",
} if HOST_OS == "mac" else {}

_APPLE_CACHE_FILES = select({
    "//build_defs/engine:prebuilt": _TOOL_CACHE_FILES_BASE | _IOS_ENGINE_CACHE_FILES,
    "//conditions:default": _TOOL_CACHE_FILES_BASE | _TREE_ENGINE_CACHE_FILES | _PUB_FILES | _IOS_ENGINE_CACHE_FILES,
})

_TOOL_SDK_FILES = {
    ":flutter_launcher": "bin/flutter",
    ":dart_launcher": "bin/dart",
    # The repository's license at the SDK's root: the tool's cache copies
    # FLUTTER_ROOT/LICENSE into each engine artifact directory it downloads
    # (EngineCachedArtifact.updateInner over getLicenseDirs) -- the
    # integration shard's `flutter build ios` fetches the iOS engine at run
    # time -- and fails the download without it.
    "//:LICENSE": "LICENSE",
}

# The version pins the tool compares the stamps against (and the iOS USB
# artifacts' it looks up before it skips them on Linux), the directories
# create_test creates a project in -- examples/, dev/, the engine's and
# packages/flutter's examples -- one file each so that they exist, and the
# font a web build takes from the engine's tree.
_TOOL_DATA = [
    "//bin/internal:all_files",
    "//:dev/README.md",
    "//:examples/README.md",
    "//engine/src/flutter:examples/glfw/README.md",
    # A web build bundles the fallback Roboto from the engine's tree
    # (build_system/targets/web.dart).
    "//engine/src/flutter/txt:third_party/fonts/Roboto-Regular.ttf",
    "//packages/flutter/examples/api:pubspec.yaml",
]

# The tool's whole library, compiled once into each shard's prelude: a test's
# compile starts from it instead of compiling the tool again.
_IMPORTS = [
    "package:flutter_tools/executable.dart",
    "package:test/test.dart",
]

# The general shard: the unit tests dev/bots runs with `dart test
# test/general.shard` (`flutter_tools_tests` is its own CI shard).
dart_package_tests(
    name = "general_shard",
    srcs = _HARNESS,
    cache = _CACHE,
    cache_files = _CACHE_FILES,
    # Fixtures the tests read relative to this directory.
    data = glob(["test/data/**"]),
    imports = _IMPORTS,
    # Two tests reach the network: cache_test's China warning looks up
    # storage.googleapis.com, ios_device_start_prebuilt_test's mDNS client
    # sends to the multicast group.
    network = True,
    package = "flutter_tools",
    packages = _PACKAGES,
    tests = glob(["test/general.shard/**/*_test.dart"]),
)

# The commands shard's hermetic half: the commands against fakes (dev/bots
# runs test/commands.shard on one core). The permeable half drives the real
# file system, pub and git; the integration shard the built tool.
dart_package_tests(
    name = "commands_shard_hermetic",
    srcs = _HARNESS,
    cache = _PUB_CACHE,
    cache_files = _PUB_CACHE_FILES,
    # daemon_test asks the daemon for the gallery project's platforms; the
    # widget_preview tests analyze projects that depend on the SDK's packages
    # and two of them resolve such a project with the real pub.
    data = glob(["test/data/**"]) + ["//dev/integration_tests/flutter_gallery:project"] + _SDK_PACKAGES,
    imports = _IMPORTS,
    large = _LARGE_HERMETIC,
    # update_packages_test fetches the coverage data from storage.googleapis.com;
    # pub asks pub.dev which versions exist (the packages themselves are in the
    # cache).
    network = True,
    package = "flutter_tools",
    packages = _PACKAGES,
    pub_cache = ":framework_pub_cache",
    # The widget_preview tests watch a project they create under TMPDIR and
    # compare the watcher's paths with their own, which a Mac's symlinked
    # TMPDIR (/var/folders, /private/var there) tells apart: theirs is
    # resolved (dart_test's resolved_tmpdir).
    resolved_tmpdir = glob(["test/commands.shard/hermetic/widget_preview/**/*_test.dart"]),
    tests = glob(["test/commands.shard/hermetic/**/*_test.dart"]),
)

# The commands shard's permeable half: commands against the real file
# system and the real pub, on the same SDK facsimile with the tool itself in
# it (create_test and icon_tree_shaker_test run it; the latter builds for
# the host's desktop -- on a Mac a release App.framework for both CPUs, from
# the facsimile's universal FlutterMacOS.xcframework and gen_snapshots).
dart_package_tests(
    name = "commands_shard_permeable",
    srcs = _HARNESS,
    cache = _TOOL_CACHE,
    cache_files = _TOOL_CACHE_FILES,
    # script_test reads the SDK's Windows entrypoint scripts; create_test
    # copies its data/ fixture into a project.
    data = glob([
        "test/data/**",
        "test/commands.shard/permeable/data/**",
    ]) + _SDK_PACKAGES + _TOOL_DATA + [
        "//bin:dart.bat",
        "//bin:flutter.bat",
        "//bin/internal:shared.bat",
    ],
    imports = _IMPORTS,
    network = True,
    package = "flutter_tools",
    packages = _PACKAGES,
    pub_cache = ":framework_pub_cache",
    sdk_files = _TOOL_SDK_FILES,
    # create_test compiles the tool's snapshot itself first (the test
    # renames the facsimile's aside and builds its own with the SDK's
    # dart), then creates, analyzes and tests some hundred projects: 20
    # minutes on a loaded machine. widget_preview_test creates a project
    # and resolves it with the real pub for each of its cases: 45 s a
    # case, 20 minutes a file.
    sizes = {
        "test/commands.shard/permeable/create_test.dart": "enormous",
        "test/commands.shard/permeable/widget_preview/widget_preview_test.dart": "enormous",
    },
    tests = glob(["test/commands.shard/permeable/**/*_test.dart"]),
)

# The test files of the three shards the durations file covers, by name,
# for dev/bots' tool_test_durations_test (which checks the file lists
# exactly them).
filegroup(
    name = "durations_shard_test_files",
    srcs = glob([
        "test/commands.shard/**/*_test.dart",
        "test/integration.shard/**/*_test.dart",
        "test/web.shard/**/*_test.dart",
    ]),
)

