# flutter_tools' sources and its tests under Bazel: each test compiled by
# the frontend server for the VM and run by package:test's precompiled
# runner from this directory, as `dart test` runs them
# (engine/src/flutter/build/bazel/dart/dart_test.bzl; research/15).
#
#   bazel test //packages/flutter_tools:general_shard

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//engine/src/flutter/build/bazel/dart:dart_test.bzl", "dart_package_tests", "dart_vm_kernel")
load("//engine/src/flutter/build/bazel/dart:pub.bzl", "pub_cache", "pub_package_config")

package(default_visibility = ["//visibility:public"])

# The tool: its libraries and entry points, and what it reads of its own
# tree at run time (the templates it copies, the Gradle scripts, the
# analysis options it ships, package:test's configuration for its tests).
filegroup(
    name = "sources",
    srcs = glob([
        "bin/**",
        "gradle/**",
        "ide_templates/**",
        "lib/**",
        "static/**",
        "templates/**",
        "tool/**",
    ]) + [
        "analysis_options.yaml",
        "dart_test.yaml",
        "pubspec.yaml",
    ],
)

# The test harness (test/src), which dev/bots' tests import too
# (fake_process_manager.dart).
filegroup(
    name = "test_harness",
    srcs = glob(["test/src/**/*.dart"]),
)

# The tool's own packages beside it.
_PACKAGES = {
    "//packages/flutter_tools/packages/flutter_tools_core:sources": "flutter_tools_core",
    "//packages/flutter_tools/packages/flutter_tools_extension:sources": "flutter_tools_extension",
    "//packages/flutter_tools/packages/flutter_tools_extension_linux_prototype:sources": "flutter_tools_extension_linux_prototype",
}

# The test harness (test/src) and every helper beside a test, whichever
# shard's: the shards import each other's (the harness imports the
# integration shard's test_utils.dart, the commands shard's build_ipa_test
# the general shard's xcresult_test_data.dart).
_HARNESS = glob(
    ["test/**/*.dart"],
    exclude = ["test/**/*_test.dart"],
)

# What the tests read of the SDK's cache under FLUTTER_ROOT: the Dart SDK
# (cache_test reads DevTools' version from its resources) and the engine
# stamp the tool's bootstrap writes (version_test).
_CACHE = {
    "@dart_sdk_linux_x64//:dart": "dart-sdk",
    "@dart_sdk_linux_x64//:devtools": "dart-sdk",
}

_CACHE_FILES = {
    "//bin/internal:engine_stamp": "engine.stamp",
    "//bin/internal:engine_stamp_json": "engine_stamp.json",
    "//bin/internal:engine_stamp_stamp": "engine_stamp.stamp",
}

# For the tests that run the real pub on a project of their own (the
# widget_preview tests' projects depend on `flutter`, `flutter_localizations`
# and `flutter_test` from the SDK): pub's view of the SDK -- its version file,
# the packages under FLUTTER_ROOT/packages, the engine's sky_engine package
# under bin/cache/pkg (the analyzer reads dart:ui from it) -- and a pub cache
# of the hosted packages they reach.
_PUB_CACHE_FILES = _CACHE_FILES | {
    "//bin/internal:flutter_version_json": "flutter.version.json",
    "//engine/src/flutter/sky/packages/sky_engine:package": "pkg/sky_engine",
}

# The Gradle wrapper `flutter create` copies into an Android project.
_PUB_CACHE = _CACHE | {"@gradle_wrapper//:wrapper": "artifacts/gradle_wrapper"}

_SDK_PACKAGES = [
    "//:pubspec.lock",
    "//:pubspec.yaml",
    "//packages/flutter:sources",
    "//packages/flutter_driver:sources",
    "//packages/flutter_localizations:sources",
    "//packages/flutter_test:sources",
    "//packages/flutter_web_plugins:sources",
    "//packages/fuchsia_remote_debug_protocol:sources",
    "//packages/integration_test:sources",
]

# The hosted packages those projects reach: the SDK packages' dependencies
# and what `flutter create`'s templates (a plugin's example depends on
# integration_test and plugin_platform_interface) and the widget preview
# scaffold add (pub asks pub.dev for the versions that exist and downloads
# what the cache lacks -- webview_flutter_web is not in the workspace's lock).
pub_cache(
    name = "framework_pub_cache",
    roots = [
        "cupertino_icons",
        "dtd",
        "flutter",
        "flutter_driver",
        "flutter_lints",
        "flutter_localizations",
        "flutter_test",
        "flutter_web_plugins",
        "integration_test",
        "plugin_platform_interface",
        "stack_trace",
        "url_launcher",
        "webview_flutter",
    ],
)

# The tests that run the analyzer over whole projects take minutes on a
# loaded machine.
_LARGE_HERMETIC = [
    "test/commands.shard/hermetic/widget_preview/preview_code_generator_test.dart",
    "test/commands.shard/hermetic/widget_preview/preview_detector/preview_detector_test.dart",
    "test/commands.shard/hermetic/widget_preview/preview_detector/preview_detector_workspace_test.dart",
]

# The tool itself, for the tests that run it (create_test analyzes, resolves
# and tests the projects it creates through bin/cache/flutter_tools.snapshot;
# icon_tree_shaker_test spawns bin/flutter): its entry point compiled for the
# VM, as the SDK's shell script compiles it on the first run, and launchers
# in place of bin/flutter and bin/dart -- the repository's scripts would
# bootstrap the tool from git and the network before running it.
pub_package_config(
    name = "tool_package_config",
    out = "tool_package_config.json",
    packages = {":sources": "flutter_tools"} | _PACKAGES,
    roots = ["flutter_tools"],
)

dart_vm_kernel(
    name = "flutter_tools_snapshot",
    out = "flutter_tools.snapshot",
    main = "bin/flutter_tools.dart",
    package_config = ":tool_package_config",
)

write_file(
    name = "flutter_launcher",
    out = "flutter_launcher.sh",
    content = [
        "#!/bin/bash",
        "# bin/flutter of the tests' SDK facsimile: the tool as Bazel compiled it",
        "# (packages/flutter_tools/BUILD.bazel), run as bin/internal/shared.sh runs",
        "# the snapshot it builds.",
        "set -e",
        "root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"",
        "exec \"$root/bin/cache/dart-sdk/bin/dart\" --disable-dart-dev " +
        "--packages=\"$root/packages/flutter_tools/.dart_tool/package_config.json\" " +
        "\"$root/bin/cache/flutter_tools.snapshot\" \"$@\"",
        "",
    ],
    is_executable = True,
)

write_file(
    name = "dart_launcher",
    out = "dart_launcher.sh",
    content = [
        "#!/bin/bash",
        "# bin/dart of the tests' SDK facsimile: the cache's Dart SDK, no bootstrap.",
        "set -e",
        "root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"",
        "exec \"$root/bin/cache/dart-sdk/bin/dart\" \"$@\"",
        "",
    ],
    is_executable = True,
)

# What the tool, run from the facsimile, reads of the cache beyond pub's
# view of it: the host's engine artifacts as `flutter precache` unpacks them
# (bundle_directory over the archives a host build uploads), the stamps
# Cache.updateAll checks before it would download, the Material fonts and
# the flutter_gpu package (the tool checks the directories exist).
_TOOL_CACHE_FILES = _PUB_CACHE_FILES | {
    ":flutter_tools_snapshot": "flutter_tools.snapshot",
    "//engine/src/flutter/build/archives:host_engine_directory": "artifacts/engine/linux-x64",
    "//engine/src/flutter/build/archives:common_engine_directory": "artifacts/engine/common",
    "//bin/internal:flutter_sdk_stamp": "flutter_sdk.stamp",
    "//bin/internal:font_subset_stamp": "font-subset.stamp",
    "//bin/internal:material_fonts_stamp": "material_fonts.stamp",
    "//bin/internal:gradle_wrapper_stamp": "gradle_wrapper.stamp",
}

_TOOL_CACHE = _PUB_CACHE | {
    "@material_fonts//:fonts": "artifacts/material_fonts",
    "//engine/src/flutter/lib/gpu:dart_sources": "pkg/flutter_gpu",
}

_TOOL_SDK_FILES = {
    ":flutter_launcher": "bin/flutter",
    ":dart_launcher": "bin/dart",
}

# The version pins the tool compares the stamps against (and the iOS USB
# artifacts' it looks up before it skips them on Linux), and the directories
# create_test creates a project in -- examples/, dev/, the engine's and
# packages/flutter's examples -- one file each so that they exist.
_TOOL_DATA = [
    "//bin/internal:all_files",
    "//:dev/README.md",
    "//:examples/README.md",
    "//engine/src/flutter:examples/glfw/README.md",
    "//packages/flutter/examples/api:pubspec.yaml",
]

# The tool's whole library, compiled once into each shard's prelude: a test's
# compile starts from it instead of compiling the tool again.
_IMPORTS = [
    "package:flutter_tools/executable.dart",
    "package:test/test.dart",
]

# The general shard: the unit tests dev/bots runs with `dart test
# test/general.shard` (`flutter_tools_tests` is its own CI shard).
dart_package_tests(
    name = "general_shard",
    srcs = _HARNESS,
    cache = _CACHE,
    cache_files = _CACHE_FILES,
    # Fixtures the tests read relative to this directory.
    data = glob(["test/data/**"]),
    imports = _IMPORTS,
    # Two tests reach the network: cache_test's China warning looks up
    # storage.googleapis.com, ios_device_start_prebuilt_test's mDNS client
    # sends to the multicast group.
    network = True,
    package = "flutter_tools",
    packages = _PACKAGES,
    tests = glob(["test/general.shard/**/*_test.dart"]),
)

# The commands shard's hermetic half: the commands against fakes (dev/bots
# runs test/commands.shard on one core). The permeable half drives the real
# file system, pub and git; the integration shard the built tool.
dart_package_tests(
    name = "commands_shard_hermetic",
    srcs = _HARNESS,
    cache = _PUB_CACHE,
    cache_files = _PUB_CACHE_FILES,
    # daemon_test asks the daemon for the gallery project's platforms; the
    # widget_preview tests analyze projects that depend on the SDK's packages
    # and two of them resolve such a project with the real pub.
    data = glob(["test/data/**"]) + ["//dev/integration_tests/flutter_gallery:project"] + _SDK_PACKAGES,
    imports = _IMPORTS,
    large = _LARGE_HERMETIC,
    # update_packages_test fetches the coverage data from storage.googleapis.com;
    # pub asks pub.dev which versions exist (the packages themselves are in the
    # cache).
    network = True,
    package = "flutter_tools",
    packages = _PACKAGES,
    pub_cache = ":framework_pub_cache",
    tests = glob(["test/commands.shard/hermetic/**/*_test.dart"]),
)

# The commands shard's permeable half: commands against the real file
# system and the real pub, on the same SDK facsimile with the tool itself in
# it (create_test and icon_tree_shaker_test run it).
dart_package_tests(
    name = "commands_shard_permeable",
    srcs = _HARNESS,
    cache = _TOOL_CACHE,
    cache_files = _TOOL_CACHE_FILES,
    # script_test reads the SDK's Windows entrypoint scripts; create_test
    # copies its data/ fixture into a project.
    data = glob([
        "test/data/**",
        "test/commands.shard/permeable/data/**",
    ]) + _SDK_PACKAGES + _TOOL_DATA + [
        "//bin:dart.bat",
        "//bin:flutter.bat",
        "//bin/internal:shared.bat",
    ],
    imports = _IMPORTS,
    network = True,
    package = "flutter_tools",
    packages = _PACKAGES,
    pub_cache = ":framework_pub_cache",
    sdk_files = _TOOL_SDK_FILES,
    # create_test compiles the tool's snapshot itself first (the test
    # renames the facsimile's aside and builds its own with the SDK's
    # dart), then creates, analyzes and tests some hundred projects: 20
    # minutes on a loaded machine.
    sizes = {"test/commands.shard/permeable/create_test.dart": "enormous"},
    tests = glob(
        ["test/commands.shard/permeable/**/*_test.dart"],
        exclude = [
            # Builds a release Linux bundle through tool_backend.dart: the
            # release engine (gen_snapshot, the product platform kernel) and
            # the desktop embedding in its three modes, which the host
            # build's facsimile lacks.
            "test/commands.shard/permeable/icon_tree_shaker_test.dart",
            # Does not compile at this checkout: #192831 and #193447 crossed
            # (WidgetPreviewCommand's constructor); upstream reverted the
            # latter in #193968. Restore it on the next rebase.
            "test/commands.shard/permeable/widget_preview/widget_preview_test.dart",
        ],
    ),
)
