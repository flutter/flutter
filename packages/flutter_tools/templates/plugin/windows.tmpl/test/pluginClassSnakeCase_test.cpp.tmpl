TEST({{pluginClass}}, GetPlatformVersion) {
  {{pluginClass}} plugin;
  ErrorOr<std::string> result = plugin.GetPlatformVersion();

  EXPECT_FALSE(result.has_error());
  // Since the exact string varies by host, just ensure that it's a string
