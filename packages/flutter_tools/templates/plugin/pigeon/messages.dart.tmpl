@ConfigurePigeon(
  PigeonOptions(
    dartPackageName: '{{projectName}}',
    dartOut: 'lib/src/messages.g.dart',
{{#windows}}
    cppHeaderOut: 'windows/messages.g.h',
    cppSourceOut: 'windows/messages.g.cpp',
    cppOptions: CppOptions(namespace: '{{projectName}}'),
{{/windows}}
{{#linux}}
    gobjectHeaderOut: 'linux/messages.g.h',
    gobjectSourceOut: 'linux/messages.g.cc',
{{/linux}}
{{#android}}
{{#withJava}}
    javaOut: 'android/src/main/java/{{androidIdentifierPosixPath}}/Messages.java',
    javaOptions: JavaOptions(
      className: 'Messages',
      package: '{{androidIdentifier}}',
    ),
{{/withJava}}
{{^withJava}}
    kotlinOut:
        'android/src/main/kotlin/{{androidIdentifierPosixPath}}/Messages.g.kt',
{{/withJava}}
{{/android}}
{{#darwin}}
    swiftOut:
{{#withSwiftPackageManager}}
      'darwin/{{projectName}}/Sources/{{projectName}}/Messages.g.swift',
{{/withSwiftPackageManager}}
{{^withSwiftPackageManager}}
      'darwin/Classes/Messages.g.swift',
{{/withSwiftPackageManager}}
{{/darwin}}
{{^darwin}}
    swiftOut: [
{{#ios}}
{{#withSwiftPackageManager}}
      'ios/{{projectName}}/Sources/{{projectName}}/Messages.g.swift',
{{/withSwiftPackageManager}}
{{^withSwiftPackageManager}}
      'ios/Classes/Messages.g.swift',
{{/withSwiftPackageManager}}
{{/ios}}
{{#macos}}
{{#withSwiftPackageManager}}
      'macos/{{projectName}}/Sources/{{projectName}}/Messages.g.swift',
{{/withSwiftPackageManager}}
{{^withSwiftPackageManager}}
      'macos/Classes/Messages.g.swift',
{{/withSwiftPackageManager}}
{{/macos}}
    ],
{{/darwin}}
  ),
)
@HostApi()
abstract class {{pluginClass}}Api {
  /// Returns the system version of the host platform.
  String getPlatformVersion();
}
