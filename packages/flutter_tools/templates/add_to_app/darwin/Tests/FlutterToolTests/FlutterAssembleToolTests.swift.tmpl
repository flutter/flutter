@Test(
  arguments: [
    (FlutterPlatform.ios, "iphoneos26.2", true),
    (FlutterPlatform.ios, "iphoneos26.2", false),
    (FlutterPlatform.macos, "macosx26.2", true),
    (FlutterPlatform.macos, "macosx26.2", false),
  ]
)
func runVerifyBuildModeAndUpdateIfNeededChecksOtoolForLinkedVMService(
  targetPlatform: FlutterPlatform,
  sdkRoot: String,
  linksVmService: Bool
) async throws {
  let fixture = VMServiceTestFixture(
    targetPlatform: targetPlatform,
    sdkRoot: sdkRoot,
    targetBuildMode: "Release"
  )
  fixture.fileManager.symlinkDestinations[fixture.symlinkPath] = "./Profile"
  fixture.configurePackageFrameworks(includeVmService: false)
  fixture.fileManager.filesExist[fixture.embeddedVmServicePath] = true
  fixture.fileManager.filesExist[fixture.binaryPath] = true
  fixture.setInfoPlists(builtProductsModes: ["Profile"], embeddedModes: ["Release"])
  fixture.expectFrameworkRsyncs(includeVmService: false)
  let otoolOutput =
    linksVmService
    ? "\(fixture.binaryPath):\n\t@rpath/VMService.framework/VMService (compatibility version 1.0.0)\n"
    : "\(fixture.binaryPath):\n\t@rpath/App.framework/App (compatibility version 1.0.0)\n"
  fixture.processManager.expectedProcesses.append(
    MockProcess(
      expectedURL: "/usr/bin/otool",
      expectedArguments: ["-L", fixture.binaryPath],
      output: otoolOutput
    )
  )

  if linksVmService {
    do {
      try FlutterAssembleToolHelper.run(
        targetBuildMode: fixture.targetBuildMode,
        targetPlatform: targetPlatform,
        env: fixture.env(includeExecutablePath: true),
        fileManager: fixture.fileManager,
        processManager: fixture.processManager
      )
      Issue.record("Expected XcodeErrorAndExit")
    } catch let XcodeErrorAndExit.error(messages) {
      let combined = messages.joined(separator: "\n")
      #expect(combined.contains("VMService.framework"))
      #expect(combined.contains("re-run"))
    }
  } else {
    try FlutterAssembleToolHelper.run(
      targetBuildMode: fixture.targetBuildMode,
      targetPlatform: targetPlatform,
      env: fixture.env(includeExecutablePath: true),
      fileManager: fixture.fileManager,
      processManager: fixture.processManager
    )
  }
  #expect(fixture.processManager.expectedProcesses.isEmpty)
  #expect(fixture.fileManager.symlinksCreated[fixture.symlinkPath] == "./Release")
  #expect(fixture.fileManager.filesExist[fixture.embeddedVmServicePath] == false)
}

@Test(
  arguments: [
    (FlutterPlatform.ios, "iphoneos26.2", "ios/Flutter/ephemeral/flutter_native_integration.env", true),
    (FlutterPlatform.ios, "iphoneos26.2", "ios/Flutter/ephemeral/flutter_native_integration.env", false),
    (FlutterPlatform.macos, "macosx26.2", "macos/Flutter/ephemeral/flutter_native_integration.env", true),
    (FlutterPlatform.macos, "macosx26.2", "macos/Flutter/ephemeral/flutter_native_integration.env", false),
  ]
)
func runWithAssembleChecksOtoolForLinkedVMService(
  targetPlatform: FlutterPlatform,
  sdkRoot: String,
  exportEnvRelativePath: String,
  linksVmService: Bool
) async throws {
  let fixture = VMServiceTestFixture(
    targetPlatform: targetPlatform,
    sdkRoot: sdkRoot,
    targetBuildMode: "Release"
  )
  let flutterAppPath = "/path/to/flutter_app"
  let flutterRoot = "/path/to/flutter"
  let appExportedEnvPath = "\(flutterAppPath)/\(exportEnvRelativePath)"
  fixture.fileManager.symlinkDestinations[fixture.symlinkPath] = "./Profile"
  fixture.fileManager.filesExist["\(fixture.packagePath)/./Release"] = true
  fixture.fileManager.filesExist[flutterAppPath] = true
  fixture.fileManager.filesExist[flutterRoot] = true
  fixture.fileManager.filesExist[appExportedEnvPath] = true
  fixture.fileManager.filesExist[fixture.binaryPath] = true
  fixture.fileManager.fileContents[appExportedEnvPath] = [
    Data("FLUTTER_ROOT=\(flutterRoot)\nFLUTTER_APPLICATION_PATH=\(flutterAppPath)\n".utf8)
  ]
  let otoolOutput =
    linksVmService
    ? "\(fixture.binaryPath):\n\t@rpath/VMService.framework/VMService (compatibility version 1.0.0)\n"
    : "\(fixture.binaryPath):\n\t@rpath/App.framework/App (compatibility version 1.0.0)\n"
  fixture.processManager.expectedProcesses.append(
    contentsOf: [
      MockProcess(
        expectedURL: "\(flutterRoot)/bin/dart",
        expectedArguments: [
          "\(flutterRoot)/packages/flutter_tools/bin/xcode_backend.dart",
          "build-add-to-app",
          targetPlatform.rawValue,
        ]
      ),
      MockProcess(
        expectedURL: "/usr/bin/otool",
        expectedArguments: ["-L", fixture.binaryPath],
        output: otoolOutput
      ),
    ]
  )

  let env = fixture.env(
    includeExecutablePath: true,
    extra: [
      "FLUTTER_APPLICATION_PATH": flutterAppPath,
