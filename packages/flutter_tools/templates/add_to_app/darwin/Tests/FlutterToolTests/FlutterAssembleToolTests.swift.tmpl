func findPlatformFramework(
  targetPlatform: FlutterPlatform,
  frameworkName: String,
  sdkRoot: String,
  platforms: [String],
  expectedFramework: String
) async throws {
  let fileManager = MockFileManager()
  let xcframeworkURL = URL(fileURLWithPath: "/\(frameworkName).xcframework")
  fileManager.filesInDirectory[xcframeworkURL.path] = platforms.compactMap {
    URL(string: $0)
  }
  let frameworkURL = try FlutterAssembleToolHelper.findPlatformFramework(
    frameworkName: frameworkName,
    xcframeworkURL: xcframeworkURL,
    targetPlatform: targetPlatform,
    env: ["SDKROOT": sdkRoot],
    fileManager: fileManager
  )
  #expect(frameworkURL.path == expectedFramework)
}

func plistContentFor(buildMode: String) -> String {
  return """
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>BuildMode</key>
      <string>\(buildMode)</string>
    </dict>
    </plist>
    """
}

private struct VMServiceTestFixture {
  let targetPlatform: FlutterPlatform
  let sdkRoot: String
  let targetBuildMode: String
  let fileManager: MockFileManager
  let processManager: MockFlutterProcessManager

  init(
    targetPlatform: FlutterPlatform,
    sdkRoot: String,
    targetBuildMode: String
  ) {
    self.targetPlatform = targetPlatform
    self.sdkRoot = sdkRoot
    self.targetBuildMode = targetBuildMode
    let fm = MockFileManager()
    self.fileManager = fm
    self.processManager = MockFlutterProcessManager(fileManager: fm)
  }

  var flutterBinaryName: String {
    targetPlatform == .macos ? "FlutterMacOS" : "Flutter"
  }

  var infoPlistRelativePath: String {
    targetPlatform == .macos
      ? "FlutterMacOS.framework/Resources/Info.plist"
      : "Flutter.framework/Info.plist"
  }

  var expectedSlice: String {
    if targetPlatform == .macos {
      return "macos-arm64_x86_64"
    }
    return sdkRoot.contains("simulator") ? "ios-arm64_x86_64-simulator" : "ios-arm64"
  }

  var expectedFlutterBuildMode: String {
    (targetPlatform == .ios && sdkRoot.contains("simulator")) ? "debug" : targetBuildMode
  }

  var buildDir: String { "/Build/Products/\(targetBuildMode)" }

  var frameworksDir: String {
    targetPlatform == .macos ? "MyApp.app/Contents/Frameworks" : "MyApp.app/Frameworks"
  }

  var executablePath: String {
    targetPlatform == .macos ? "MyApp.app/Contents/MacOS/MyApp" : "MyApp.app/MyApp"
  }

  var binaryPath: String { "\(buildDir)/\(executablePath)" }

  var packagePath: String { "/path/to/SwiftPackages/FlutterNativeIntegration" }

  var symlinkPath: String { "\(packagePath)/FlutterPluginRegistrant" }

  var embeddedVmServicePath: String { "\(buildDir)/\(frameworksDir)/VMService.framework" }

  func configurePackageFrameworks(includeVmService: Bool) {
    fileManager.filesExist["\(packagePath)/./\(targetBuildMode)"] = true
    var frameworks = [flutterBinaryName, "App"]
    if includeVmService {
      frameworks.append("VMService")
    }
    for name in frameworks {
      let xcframeworkPath = "\(packagePath)/\(targetBuildMode)/Frameworks/\(name).xcframework"
      fileManager.filesExist[xcframeworkPath] = true
      fileManager.filesInDirectory[xcframeworkPath] = [
        URL(fileURLWithPath: "\(xcframeworkPath)/\(expectedSlice)")
      ]
    }
  }

  func setInfoPlists(builtProductsModes: [String], embeddedModes: [String]) {
    fileManager.fileContents["\(buildDir)/\(infoPlistRelativePath)"] = builtProductsModes.map {
      Data(plistContentFor(buildMode: $0).utf8)
    }
    fileManager.fileContents["\(buildDir)/\(frameworksDir)/\(infoPlistRelativePath)"] =
      embeddedModes.map {
        Data(plistContentFor(buildMode: $0).utf8)
      }
  }

  func expectFrameworkRsyncs(includeVmService: Bool) {
    let flutterExtraArgs: [String] =
      targetPlatform == .macos
      ? ["--filter", "- Headers", "--filter", "- Modules"]
      : []
    var frameworks: [(String, [String])] = [
      (flutterBinaryName, flutterExtraArgs),
      ("App", []),
    ]
    if includeVmService {
      frameworks.append(("VMService", []))
    }
    for (name, extraArgs) in frameworks {
      let xcframeworkPath = "\(packagePath)/\(targetBuildMode)/Frameworks/\(name).xcframework"
      processManager.expectedProcesses.append(
        MockProcess(
          expectedURL: "/usr/bin/rsync",
          expectedArguments: [
            "-av", "--delete", "--filter", "- .DS_Store/",
          ] + extraArgs + [
            "--chmod=Du=rwx,Dgo=rx,Fu=rw,Fgo=r",
            "\(xcframeworkPath)/\(expectedSlice)/\(name).framework",
            "\(buildDir)/\(frameworksDir)",
          ]
        )
      )
    }
  }

  func env(
    sandboxing: String = "NO",
    includeExecutablePath: Bool = false,
    extra: [String: String] = [:]
  ) -> [String: String] {
    var base: [String: String] = [
      "SDKROOT": sdkRoot,
      "BUILT_PRODUCTS_DIR": buildDir,
      "TARGET_BUILD_DIR": buildDir,
      "FRAMEWORKS_FOLDER_PATH": frameworksDir,
      "ENABLE_USER_SCRIPT_SANDBOXING": sandboxing,
      "FLUTTER_NATIVE_INTEGRATION_PACKAGE_PATH": packagePath,
    ]
    if includeExecutablePath {
      base["EXECUTABLE_PATH"] = executablePath
    }
    for (key, value) in extra {
      base[key] = value
    }
    return base
  }
}
