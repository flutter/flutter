# flutter_goldens' tests under Bazel: each *_test.dart compiled by the
# frontend server from a prelude kernel and run on the Bazel-built
# flutter_tester, as `flutter test` runs it
# (//build_defs/dart:flutter_package_tests.bzl; research/15).
#
#   bazel test //packages/flutter_goldens/test:tests

load("//build_defs/dart:flutter_package_tests.bzl", "FRAMEWORK_IMPORTS", "flutter_package_tests")

package(default_visibility = ["//visibility:public"])

flutter_package_tests(
    name = "tests",
    srcs = glob(
        ["**/*.dart"],
        exclude = ["**/*_test.dart"],
    ),
    imports = FRAMEWORK_IMPORTS + ["package:flutter_goldens/flutter_goldens.dart"],
    package = "flutter_goldens",
    tests = glob(["**/*_test.dart"]),
)
