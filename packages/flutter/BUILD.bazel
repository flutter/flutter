# package:flutter's sources, for the tests Bazel compiles and runs on
# flutter_tester (engine/src/flutter/build/bazel/dart/flutter_test.bzl); the
# tests themselves are under test/.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["lib/**"]) + ["pubspec.yaml"],
)

# The framework's shaders, which flutter_tools compiles into every asset
# bundle (asset.dart's _getFrameworkShaders); the tests' asset directory
# (test/BUILD.bazel) compiles them too.
exports_files([
    "lib/src/material/shaders/ink_sparkle.frag",
    "lib/src/widgets/shaders/stretch_effect.frag",
    # The tests run from the package's directory (framework_tests.bzl).
    "pubspec.yaml",
])
