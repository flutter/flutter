# packages/flutter/test/widgets under Bazel: each *_test.dart compiled by the
# frontend server from the test tree's prelude kernel and run on the
# Bazel-built flutter_tester, as `flutter test` runs it (../framework_tests.bzl;
# engine/src/flutter/build/bazel/dart/flutter_test.bzl; research/15).
#
#   bazel test //packages/flutter/test/widgets:widgets

load("//packages/flutter/test:framework_tests.bzl", "framework_tests")

package(default_visibility = ["//visibility:public"])

# The helpers beside the tests, for these tests and the other directories'
# (//packages/flutter/test:helpers).
filegroup(
    name = "helpers",
    srcs = glob(
        ["**/*.dart"],
        allow_empty = True,
        exclude = ["**/*_test.dart"],
    ),
)

framework_tests(
    name = "widgets",
    # binding_live_test's one test (LiveTestWidgetsFlutterBinding, awaiting a
    # real frame) hung to its timeout in two of three full runs under 24
    # parallel compiles and passes 8 of 8 alone; rerun on failure, a minute
    # per attempt.
    flaky = ["binding_live_test.dart"],
    # html_element_view_test.dart and selectable_region_context_menu_test.dart
    # are web-only (`@TestOn('chrome')`, `@TestOn('browser')`: dart:ui_web and
    # dart:js_interop have no VM compile; `flutter test` skips such a file by
    # its annotation, which a BUILD file cannot read).
    tests = glob(
        ["*_test.dart"],
        exclude = [
            "html_element_view_test.dart",
            "selectable_region_context_menu_test.dart",
        ],
    ),
)
