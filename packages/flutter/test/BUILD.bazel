# The framework's tests under Bazel (NEED_DECISION D14, research/15): the
# package configurations the tests compile and run with, and the test
# configuration every test of this directory tree is wrapped in. The tests
# themselves are declared per directory (widgets/BUILD.bazel, ...).

load("//build_defs/dart:flutter_assets.bzl", "flutter_test_assets")
load("//build_defs/dart:flutter_test.bzl", "flutter_test_prelude")
load("//build_defs/dart:pub.bzl", "pub_package_config")

package(default_visibility = ["//visibility:public"])

exports_files(["flutter_test_config.dart"])

# The packages a test of the framework reaches: package:flutter's
# dependencies and dev dependencies (pubspec.yaml), followed through the
# hosted packages' own -- 49 of the lock's 174 -- and test_core, whose direct
# runner the generated bootstrap runs the test through (flutter_test.bzl).
_ROOTS = [
    "flutter",
    "test_core",
]

_DEV_ROOTS = ["flutter"]

# The workspace's own packages among them, as the tree's files.
_WORKSPACE_PACKAGES = {
    "//packages/flutter:sources": "flutter",
    "//packages/flutter_driver:sources": "flutter_driver",
    "//packages/flutter_goldens:sources": "flutter_goldens",
    "//packages/flutter_localizations:sources": "flutter_localizations",
    "//packages/flutter_test:sources": "flutter_test",
    "//packages/fuchsia_remote_debug_protocol:sources": "fuchsia_remote_debug_protocol",
}

# sky_engine is dart:ui's package: its libraries are the engine's platform
# kernel, and nothing imports package:sky_engine.
_WITHOUT = ["sky_engine"]

# For the compile: root URIs for an action's execution root.
pub_package_config(
    name = "package_config",
    out = "package_config.json",
    dev_roots = _DEV_ROOTS,
    packages = _WORKSPACE_PACKAGES,
    roots = _ROOTS,
    without = _WITHOUT,
)

# For the run: root URIs for a test's runfiles tree.
pub_package_config(
    name = "runtime_package_config",
    out = "runtime_package_config.json",
    dev_roots = _DEV_ROOTS,
    layout = "runfiles",
    packages = _WORKSPACE_PACKAGES,
    roots = _ROOTS,
    without = _WITHOUT,
)

# The same, where the Dart VM finds it from a script under this directory
# (foundation/isolates_test runs the SDK's dartvm on _compute_caller.dart,
# which imports the framework from source): the nearest
# .dart_tool/package_config.json above the script.
pub_package_config(
    name = "dart_tool_package_config",
    out = ".dart_tool/package_config.json",
    dev_roots = _DEV_ROOTS,
    layout = "runfiles",
    packages = _WORKSPACE_PACKAGES,
    roots = _ROOTS,
    without = _WITHOUT,
)

# The asset directory `flutter test` builds for this package's tests: no
# assets or fonts of its own (pubspec.yaml has no flutter: section); the
# framework's two shaders, which flutter_tools compiles into every bundle
# and a MaterialApp's ink sparkle and stretch overscroll load.
flutter_test_assets(
    name = "test_assets",
    shaders = {
        "//packages/flutter:lib/src/material/shaders/ink_sparkle.frag": "shaders/ink_sparkle.frag",
        "//packages/flutter:lib/src/widgets/shaders/stretch_effect.frag": "shaders/stretch_effect.frag",
    },
)

# The libraries the tests share, compiled once; a test's compile starts
# from this kernel instead of compiling the framework again (13 s alone,
# 50 s under load, against 3 s).
flutter_test_prelude(
    name = "prelude",
    imports = [
        "package:flutter/cupertino.dart",
        "package:flutter/material.dart",
        "package:flutter/rendering.dart",
        "package:flutter/services.dart",
        "package:flutter/widgets.dart",
        "package:flutter_test/flutter_test.dart",
        "package:test_core/src/direct_run.dart",
    ],
    package_config = ":package_config",
    test_config = "flutter_test_config.dart",
    deps = [":helpers"],
)

# The same prelude without creation-location tracking, for the widgets
# suite's second run (widgets/BUILD.bazel): dev/bots runs test/widgets with
# --track-widget-creation and again with --no-track-widget-creation.
flutter_test_prelude(
    name = "prelude_without_creation_locations",
    compile_args = ["--no-track-creation-locations"],
    imports = [
        "package:flutter/cupertino.dart",
        "package:flutter/material.dart",
        "package:flutter/rendering.dart",
        "package:flutter/services.dart",
        "package:flutter/widgets.dart",
        "package:flutter_test/flutter_test.dart",
        "package:test_core/src/direct_run.dart",
    ],
    package_config = ":package_config",
    test_config = "flutter_test_config.dart",
    deps = [":helpers"],
)

# The files a test's compile may read besides its package's: the test
# configuration's imports (_goldens_io.dart, ...) and the helpers of every
# test directory, since tests import their neighbours' (widgets tests
# import ../rendering/rendering_tester.dart, ../services/restoration.dart,
# ../painting/image_test_utils.dart, ...). A directory with a BUILD file of
# its own contributes its helpers through its own filegroup.
filegroup(
    name = "helpers",
    srcs = glob(
        ["**/*.dart"],
        exclude = ["**/*_test.dart"],
    ) + [
        "//packages/flutter/test/animation:helpers",
        "//packages/flutter/test/cupertino:helpers",
        "//packages/flutter/test/examples:helpers",
        "//packages/flutter/test/foundation:helpers",
        "//packages/flutter/test/gestures:helpers",
        "//packages/flutter/test/harness:helpers",
        "//packages/flutter/test/material:helpers",
        "//packages/flutter/test/painting:helpers",
        "//packages/flutter/test/physics:helpers",
        "//packages/flutter/test/rendering:helpers",
        "//packages/flutter/test/scheduler:helpers",
        "//packages/flutter/test/semantics:helpers",
        "//packages/flutter/test/services:helpers",
        "//packages/flutter/test/widgets:helpers",
    ],
)

# Every directory's suite (dart/ has one test, web-only).
test_suite(
    name = "all",
    tests = [
        "//packages/flutter/test/animation",
        "//packages/flutter/test/cupertino",
        "//packages/flutter/test/examples",
        "//packages/flutter/test/foundation",
        "//packages/flutter/test/gestures",
        "//packages/flutter/test/harness",
        "//packages/flutter/test/material",
        "//packages/flutter/test/painting",
        "//packages/flutter/test/physics",
        "//packages/flutter/test/rendering",
        "//packages/flutter/test/scheduler",
        "//packages/flutter/test/semantics",
        "//packages/flutter/test/services",
        "//packages/flutter/test/widgets",
    ],
)

# The same files rendering with Impeller (flutter_test's `impeller`), as
# dev/bots runs `flutter test --enable-impeller` over the package.
test_suite(
    name = "all_impeller",
    tests = [
        "//packages/flutter/test/animation:animation_impeller",
        "//packages/flutter/test/cupertino:cupertino_impeller",
        "//packages/flutter/test/examples:examples_impeller",
        "//packages/flutter/test/foundation:foundation_impeller",
        "//packages/flutter/test/gestures:gestures_impeller",
        "//packages/flutter/test/harness:harness_impeller",
        "//packages/flutter/test/material:material_impeller",
        "//packages/flutter/test/painting:painting_impeller",
        "//packages/flutter/test/physics:physics_impeller",
        "//packages/flutter/test/rendering:rendering_impeller",
        "//packages/flutter/test/scheduler:scheduler_impeller",
        "//packages/flutter/test/semantics:semantics_impeller",
        "//packages/flutter/test/services:services_impeller",
        "//packages/flutter/test/widgets:widgets_impeller",
    ],
)
