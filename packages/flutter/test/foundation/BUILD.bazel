# packages/flutter/test/foundation under Bazel: each *_test.dart compiled by the
# frontend server from the test tree's prelude kernel and run on the
# Bazel-built flutter_tester, as `flutter test` runs it (../framework_tests.bzl;
# engine/src/flutter/build/bazel/dart/flutter_test.bzl; research/15).
#
#   bazel test //packages/flutter/test/foundation:foundation

load("//packages/flutter/test:framework_tests.bzl", "framework_tests")

package(default_visibility = ["//visibility:public"])

# The helpers beside the tests, for these tests and the other directories'
# (//packages/flutter/test:helpers).
filegroup(
    name = "helpers",
    srcs = glob(
        ["**/*.dart"],
        allow_empty = True,
        exclude = ["**/*_test.dart"],
    ),
)

framework_tests(
    name = "foundation",
    # isolates_test runs the SDK's dartvm on the _compute_caller*.dart
    # scripts, which import the framework from source: the scripts, the
    # package configuration the VM finds above them, and the packages' files.
    data = glob(["_compute_caller*.dart"]) + [
        "//packages/flutter/test:dart_tool_package_config",
        "//packages/flutter/test:dart_tool_package_config_sources",
    ],
    # platform_web_test.dart is web-only (`@TestOn('chrome')`).
    tests = glob(
        ["*_test.dart"],
        exclude = ["platform_web_test.dart"],
    ),
)
