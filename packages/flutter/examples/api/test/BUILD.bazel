# The API samples' tests under Bazel: each *_test.dart compiled by the
# frontend server from a prelude kernel and run on the Bazel-built
# flutter_tester, as `flutter test` runs it
# (//build_defs/dart:flutter_package_tests.bzl; research/15).
#
#   bazel test //packages/flutter/examples/api/test:tests

load("//build_defs/dart:flutter_package_tests.bzl", "FRAMEWORK_IMPORTS", "flutter_package_tests")

package(default_visibility = ["//visibility:public"])

flutter_package_tests(
    name = "tests",
    srcs = glob(
        ["**/*.dart"],
        exclude = ["**/*_test.dart"],
    ),
    directory = "packages/flutter/examples/api",
    # The samples are many programs, not one library: the prelude holds the
    # framework and the localizations some of them use.
    imports = FRAMEWORK_IMPORTS + ["package:flutter_localizations/flutter_localizations.dart"],
    package = "flutter_api_samples",
    packages = {
        "//packages/flutter_goldens:sources": "flutter_goldens",
        "//packages/flutter_localizations:sources": "flutter_localizations",
    },
    tests = glob(["**/*_test.dart"]),
    # Dev dependencies of the drivers and the web, which no test reaches.
    without = [
        "flutter_driver",
        "flutter_web_plugins",
        "integration_test",
    ],
)
