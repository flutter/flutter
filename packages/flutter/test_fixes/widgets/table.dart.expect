import 'package:flutter/widgets.dart';

void main() {
  // Change made in https://github.com/flutter/flutter/pull/177102
  Table(border: TableBorderPainter.all());
  Table(border: const TableBorderPainter.symmetric(inside: BorderSide()));
  const TableBorderPainter tableBorder = TableBorderPainter();
  TableBorderPainter.lerp(tableBorder, tableBorder, 0.5);
}

// Change made in https://github.com/flutter/flutter/pull/177102
class CustomTableBorder extends TableBorderPainter {
  const CustomTableBorder() : super(top: const BorderSide());
}
