# flutter_test's own tests under Bazel: each *_test.dart compiled by the
# frontend server from a prelude kernel and run on the Bazel-built
# flutter_tester, as `flutter test` runs it
# (//packages/flutter_test:package_tests.bzl; research/15). Each test takes
# the flutter_test_config.dart of its directory or the nearest above
# (custom_exception_reporter, semantics_checker, test_config and its
# nested_config have their own; test_config/project_root's pubspec.yaml
# stops the search), as `flutter test` finds it.
#
#   bazel test //packages/flutter_test/test:tests

load("//packages/flutter_test:package_tests.bzl", "flutter_package_tests")

package(default_visibility = ["//visibility:public"])

flutter_package_tests(
    name = "tests",
    srcs = glob(
        ["**/*.dart"],
        exclude = ["**/*_test.dart"],
    ),
    package = "flutter_test",
    tests = glob(["**/*_test.dart"]),
    # flutter_driver, a dev dependency, is not imported by any test.
    without = ["flutter_driver"],
)
