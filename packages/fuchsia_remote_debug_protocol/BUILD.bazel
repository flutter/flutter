# package:fuchsia_remote_debug_protocol's sources, for the tests Bazel compiles and runs on
# flutter_tester (engine/src/flutter/build/bazel/dart/flutter_test.bzl).

load("//engine/src/flutter/build/bazel/dart:dart_test.bzl", "dart_package_tests")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["lib/**"]) + ["pubspec.yaml"],
)

# The package's tests: each compiled by the frontend server for the VM and
# run by package:test's precompiled runner
# (engine/src/flutter/build/bazel/dart/dart_test.bzl; research/15).
#
#   bazel test //packages/fuchsia_remote_debug_protocol:tests
dart_package_tests(
    name = "tests",
    size = "small",
    package = "fuchsia_remote_debug_protocol",
    tests = glob(["test/**/*_test.dart"]),
)
