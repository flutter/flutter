{
  "rules": "firebase_rules.json",
  "hosting": {
    "public": "doc",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "snippets/**.dart",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "redirects": [
      {
        "regex": "^/flutter/foundation/(?P<page>(?:ChangeNotifier|Listenable|ValueListenable|ValueNotifier)(?:-class\\.html|/.+))$",
        "destination": "/flutter/package-listen_listen/:page",
        "type": 301
      }
    ]
  }
}
