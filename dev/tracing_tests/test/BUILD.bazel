# tracing_tests's tests under Bazel: each *_test.dart compiled by the frontend server
# from a prelude kernel and run on the Bazel-built flutter_tester, as
# `flutter test` runs it (//build_defs/dart:flutter_package_tests.bzl;
# research/15).
#
#   bazel test //dev/tracing_tests/test:tests

load("//build_defs/dart:flutter_package_tests.bzl", "flutter_package_tests")

package(default_visibility = ["//visibility:public"])

flutter_package_tests(
    name = "tests",
    srcs = glob(
        ["**/*.dart"],
        allow_empty = True,
        exclude = ["**/*_test.dart"],
    ),
    directory = "dev/tracing_tests",
    package = "tracing_tests",
    tests = glob(["**/*_test.dart"]),
    # The tests read the timeline through the VM service
    # (`flutter test --enable-vmservice` in dev/bots).
    vm_service = True,
)
