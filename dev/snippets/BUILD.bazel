# The snippets package under Bazel: its tests compiled by the frontend
# server and run by package:test's precompiled runner
# (engine/src/flutter/build/bazel/dart/dart_test.bzl; NEED_DECISION D14).
#
#   bazel test //dev/snippets:tests

load("//engine/src/flutter/build/bazel/dart:dart_test.bzl", "dart_tests")
load("//engine/src/flutter/build/bazel/dart:pub.bzl", "pub_package_config")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob([
        "bin/**",
        "lib/**",
    ]) + ["pubspec.yaml"],
)

_ROOTS = [
    "snippets",
    "test",
]

_PACKAGES = {":sources": "snippets"}

pub_package_config(
    name = "package_config",
    out = "package_config.json",
    dev_roots = ["snippets"],
    packages = _PACKAGES,
    roots = _ROOTS,
)

pub_package_config(
    name = "runtime_package_config",
    out = "runtime_package_config.json",
    dev_roots = ["snippets"],
    layout = "runfiles",
    packages = _PACKAGES,
    roots = _ROOTS,
)

dart_tests(
    name = "tests",
    size = "small",
    # The helpers beside the tests (fake_process_manager.dart, ...).
    srcs = glob(
        ["test/*.dart"],
        exclude = ["test/*_test.dart"],
    ),
    package_config = ":package_config",
    runtime_package_config = ":runtime_package_config",
    tests = glob(["test/*_test.dart"]),
)
