# vitool's sources, for the tests Bazel compiles and runs on
# flutter_tester (build_defs/dart/flutter_test.bzl).

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["lib/**"]) + ["pubspec.yaml"],
)

# The SVGs the tests read, relative to the package's directory.
filegroup(
    name = "test_assets",
    srcs = glob(["test_assets/**"]),
)

# The tests run from the package's directory (test/BUILD.bazel).
exports_files(["pubspec.yaml"])
