# vitool's tests under Bazel: each *_test.dart compiled by the frontend server
# from a prelude kernel and run on the Bazel-built flutter_tester, as
# `flutter test` runs it (//packages/flutter_test:package_tests.bzl;
# research/15).
#
#   bazel test //dev/tools/vitool/test:tests

load("//packages/flutter_test:package_tests.bzl", "flutter_package_tests")

package(default_visibility = ["//visibility:public"])

flutter_package_tests(
    name = "tests",
    srcs = glob(
        ["**/*.dart"],
        allow_empty = True,
        exclude = ["**/*_test.dart"],
    ),
    # The tests read the package's test_assets/*.svg.
    data = ["//dev/tools/vitool:test_assets"],
    directory = "dev/tools/vitool",
    package = "vitool",
    tests = glob(["**/*_test.dart"]),
)
