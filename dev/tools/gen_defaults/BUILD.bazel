# gen_defaults under Bazel: its tests compiled by the frontend server and
# run by `dart test --precompiled` (build_defs/dart/
# dart_test.bzl); the first pure-Dart package of NEED_DECISION D14.
#
#   bazel test //dev/tools/gen_defaults:tests

load("//build_defs/dart:dart_test.bzl", "dart_package_tests")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob([
        "bin/**",
        "lib/**",
    ]) + ["pubspec.yaml"],
)

dart_package_tests(
    name = "tests",
    size = "small",
    data = glob(
        ["data/**"],
        allow_empty = True,
    ),
    package = "gen_defaults",
    tests = glob(["test/*_test.dart"]),
)
