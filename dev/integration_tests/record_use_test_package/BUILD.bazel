# The package flutter_tools' isolated/record_use_* tests (integration.shard)
# copy beside record_use_test_app: a link hook recording uses.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "project",
    srcs = glob(
        [
            "data/**",
            "hook/**",
            "lib/**",
        ],
        exclude = ["**/.dart_tool/**"],
    ) + [
        "pubspec.yaml",
    ],
)
