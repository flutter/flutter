# The gallery's project files, which flutter_tools' daemon_test reads as a
# project with a known set of platforms (daemon.getSupportedPlatforms).

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "project",
    srcs = glob([
        "android/**",
        "ios/**",
        "linux/**",
        "macos/**",
        "web/**",
        "windows/**",
    ]) + ["pubspec.yaml"],
)
