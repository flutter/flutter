# The gallery's project files, which flutter_tools' daemon_test reads as a
# project with a known set of platforms (daemon.getSupportedPlatforms) and
# its integration shard analyzes (analyze_suggestions_integration_test) and
# configures a Linux build of (build_linux_config_only_test).

load("//build_defs/dart:flutter_project.bzl", "FLUTTER_PROJECT_GENERATED")

package(default_visibility = ["//visibility:public"])

# The package's files, for its tests (test/BUILD.bazel) and the
# configurations that cover it.
filegroup(
    name = "sources",
    srcs = glob(["lib/**"]) + ["pubspec.yaml"],
)

exports_files([
    # The one asset of the gallery's own (pubspec.yaml's assets).
    "lib/gallery/example_code.dart",
    "pubspec.yaml",
])

filegroup(
    name = "project",
    srcs = glob(
        [
            "android/**",
            "ios/**",
            "lib/**",
            "linux/**",
            "macos/**",
            "web/**",
            "windows/**",
        ],
        exclude = FLUTTER_PROJECT_GENERATED,
    ) + ["pubspec.yaml"],
)
