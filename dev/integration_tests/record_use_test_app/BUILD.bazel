# The app flutter_tools' isolated/record_use_* tests (integration.shard) copy
# and build for the Linux desktop.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "project",
    srcs = glob(
        [
            "lib/**",
            "linux/**",
            "web/**",
        ],
        exclude = ["**/.dart_tool/**"],
    ) + [
        "pubspec.yaml",
    ],
)
