# The project flutter_tools' isolated/dart_data_asset_* tests (integration.shard)
# copy and run `flutter run` and `flutter test` in.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "project",
    srcs = glob(
        [
            "data/**",
            "hook/**",
            "lib/**",
            "linux/**",
            "test/**",
            "web/**",
        ],
        exclude = ["**/.dart_tool/**"],
    ) + ["pubspec.yaml"],
)
