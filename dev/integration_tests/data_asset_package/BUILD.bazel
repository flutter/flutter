# The package the app beside it depends on, which flutter_tools' isolated
# tests (integration.shard) copy with the app.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "project",
    srcs = glob(
        ["**"],
        exclude = [
            "**/.dart_tool/**",
            "BUILD.bazel",
        ],
    ),
)
