# The package flutter_tools' isolated/native_assets_* tests (integration.shard)
# add to the projects they create: a build hook reading user defines.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "project",
    srcs = glob(
        [
            "hook/**",
            "lib/**",
            "src/**",
            "test/**",
        ],
        exclude = ["**/.dart_tool/**"],
    ) + [
        "pubspec.yaml",
    ],
)
