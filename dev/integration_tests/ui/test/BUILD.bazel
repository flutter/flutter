# integration_ui's tests under Bazel: each *_test.dart compiled by the
# frontend server from a prelude kernel and run on the Bazel-built
# flutter_tester, as `flutter test` runs it
# (//build_defs/dart:flutter_package_tests.bzl; research/15).
#
#   bazel test //dev/integration_tests/ui/test:tests

load("//build_defs/dart:flutter_package_tests.bzl", "flutter_package_tests")

package(default_visibility = ["//visibility:public"])

flutter_package_tests(
    name = "tests",
    srcs = glob(
        ["**/*.dart"],
        allow_empty = True,
        exclude = ["**/*_test.dart"],
    ),
    # asset_test loads the app's own asset.
    assets = ["//dev/integration_tests/ui:assets"],
    directory = "dev/integration_tests/ui",
    package = "integration_ui",
    tests = glob(["**/*_test.dart"]),
    # The drivers' packages, which the test does not import.
    without = [
        "flutter_driver",
        "integration_test",
    ],
)
