# The integration_ui app's sources and asset, for the tests Bazel compiles
# and runs on flutter_tester
# (build_defs/dart/flutter_test.bzl).

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["lib/**"]) + ["pubspec.yaml"],
)

# The asset the pubspec declares, for the tests' asset directory.
filegroup(
    name = "assets",
    srcs = ["assets/foo.png"],
)

# The tests run from the package's directory (test/BUILD.bazel).
exports_files(["pubspec.yaml"])
