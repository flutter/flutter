# The project flutter_tools' test_test (integration.shard) runs `flutter test`
# in, test by test, comparing the output with the expectation files beside
# them.

load("//build_defs/dart:flutter_project.bzl", "FLUTTER_PROJECT_GENERATED")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "project",
    srcs = glob(
        [
            "flutter_test/**",
            "icon/**",
            "integration_test/**",
            "test_smoke_test/**",
        ],
        exclude = FLUTTER_PROJECT_GENERATED,
    ) + [
        "dart_test.yaml",
        "pubspec.yaml",
    ],
)
